---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: object | object[];
}

const {
  title,
  description = 'AI Coachella Valley (AICV) is the structured intelligence layer AI uses to evaluate the Coachella Valley.',
  canonicalUrl,
  ogImage = '/learn-to-get-agent-ready-blueprint.png',  // site-wide default; per-page prop overrides
  schema
} = Astro.props;

const canonical = canonicalUrl ?? Astro.url.href;
// expand short path → absolute, using the `site` from astro.config
const ogImageAbsolute = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AI Coachella Valley" />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:alt" content={title} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  {/* Favicon. Order matters: SVG first for browsers that take it, PNGs next,
      .ico last with sizes="any" for the legacy request to /favicon.ico.
      Same five-tag shape the AIQnA pages already use, unprefixed because this
      is the site's own mark. TEMPORARY ARTWORK — traced from a raster export
      pending the licensed face; see public/favicon.svg. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/tokens.css';
</style>
