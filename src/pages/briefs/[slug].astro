---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('briefs');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, '') },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug        = entry.id.replace(/\.mdx$/, '');
const { title, description, date, tags } = entry.data;

const canonicalUrl = `https://aicoachellavalley.com/briefs/${slug}/`;

const formattedDate = new Date(date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — AICV Intelligence Brief</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <style>
    :root {
      --volt:       #D8FF00;
      --pine:       #1B4332;
      --pine-light: #2D6A4F;
      --pine-dark:  #122B22;
      --gunmetal:   #1E1E1E;
      --snow:       #F5F5F5;
      --sand:       #E8E2D0;
      --sand-light: #F2EDE0;
      --sand-dark:  #D4CCBA;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; }
    body {
      background-color: var(--sand-light);
      color: var(--pine);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3 { font-family: 'Syne', sans-serif; }

    .site-header {
      background-color: var(--pine-dark);
      border-bottom: 2px solid var(--pine-light);
      padding: 40px 24px 32px;
    }
    .site-header .inner { max-width: 760px; margin: 0 auto; }

    .brief-date {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 10px;
    }
    .brief-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--sand-light);
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tag-chip {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 2px;
      background: rgba(216,255,0,0.1);
      color: var(--volt);
      border: 1px solid rgba(216,255,0,0.2);
    }

    .page-wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    /* Markdown body styles */
    .brief-body h1 { display: none; } /* title already in header */
    .brief-body h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin: 36px 0 12px;
    }
    .brief-body h3 {
      font-family: 'Syne', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--pine);
      margin: 24px 0 8px;
    }
    .brief-body p {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.75;
      margin-bottom: 16px;
    }
    .brief-body strong { font-weight: 600; color: var(--pine-dark); }
    .brief-body em { font-style: italic; }
    .brief-body ul, .brief-body ol {
      margin: 0 0 16px 20px;
    }
    .brief-body li {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .brief-body a {
      color: var(--pine);
      text-decoration: underline;
      text-decoration-color: var(--pine-light);
    }
    .brief-body a:hover { color: var(--pine-dark); }
    .brief-body hr {
      border: none;
      border-top: 1px solid var(--sand-dark);
      margin: 32px 0;
    }
    .brief-body blockquote {
      border-left: 3px solid var(--volt);
      padding: 8px 0 8px 18px;
      margin: 24px 0;
      background: var(--sand);
      border-radius: 0 4px 4px 0;
    }
    .brief-body blockquote p { margin-bottom: 0; }

    .site-footer {
      margin-top: 60px;
      padding-top: 24px;
      border-top: 1px solid var(--sand-dark);
      font-size: 0.8rem;
      color: var(--pine-light);
      line-height: 1.7;
    }
    .site-footer a { color: var(--pine); text-decoration: none; }
    .site-footer a:hover { text-decoration: underline; }

    @media (max-width: 640px) {
      .brief-title { font-size: 1.4rem; }
      .site-header { padding: 28px 20px 24px; }
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="inner">
      <p class="brief-date">{formattedDate}</p>
      <h1 class="brief-title">{title}</h1>
      {tags && tags.length > 0 && (
        <div class="tag-row">
          {tags.map((tag: string) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </header>

  <div class="page-wrap">
    <div class="brief-body">
      <Content />
    </div>

    <footer class="site-footer">
      <p>AI Coachella Valley &nbsp;·&nbsp; <a href="https://aicoachellavalley.com">aicoachellavalley.com</a></p>
    </footer>
  </div>

</body>
</html>
