---
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('briefs');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, '') },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug        = entry.id.replace(/\.mdx$/, '');
const { title, description, date, tags, correction } = entry.data;

const canonicalUrl = `https://aicoachellavalley.com/briefs/${slug}/`;

const formattedDate = new Date(date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const briefSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  'headline': title,
  'description': description,
  'datePublished': date,
  'dateModified': date,
  'url': `https://aicoachellavalley.com/briefs/${slug}/`,
  'author': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
    'areaServed': {
      '@type': 'AdministrativeArea',
      'name': 'Coachella Valley'
    }
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
    'areaServed': {
      '@type': 'AdministrativeArea',
      'name': 'Coachella Valley'
    }
  },
  'isPartOf': {
    '@type': 'WebSite',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com'
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — AICV Intelligence Brief</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <style>
    :root {
      --volt:       #D8FF00;
      --pine:       #1B4332;
      --pine-light: #2D6A4F;
      --pine-dark:  #122B22;
      --gunmetal:   #1E1E1E;
      --snow:       #F5F5F5;
      --sand:       #FAFAF7;
      --sand-light: #FFFFFF;
      --sand-dark:  #E8E5DD;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; }
    body {
      background-color: var(--sand-light);
      color: var(--pine);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3 { font-family: 'Syne', sans-serif; }

    .site-header {
      background-color: var(--pine-dark);
      border-bottom: 2px solid var(--pine-light);
      padding: 40px 24px 32px;
    }
    .site-header .inner { max-width: 760px; margin: 0 auto; }

    /* RENDERS FROM FRONTMATTER, NOT FROM THE BODY. The note used to be body
       prose above ## Signal, where no feed extractor could see it -- the page
       said the brief had been corrected and briefs.json did not. Frontmatter is
       now the single source; see content.config.ts. */
    .correction-note {
      border-left: 3px solid #c8b273;
      background: #faf7ef;
      padding: 0.9rem 1.1rem;
      margin: 0 0 1.75rem;
      font-size: 0.94rem;
      line-height: 1.6;
    }
    .brief-date {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 10px;
    }
    .brief-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--sand-light);
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tag-chip {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 2px;
      background: rgba(216,255,0,0.1);
      color: var(--volt);
      border: 1px solid rgba(216,255,0,0.2);
    }

    .page-wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    /* Markdown body styles
     *
     * ⚠️ These rules target MDX-RENDERED elements, which Astro's style scoper
     * never touches. A plain `.brief-body h1` compiles to
     * `.brief-body[data-astro-cid-x] h1[data-astro-cid-x]`, and markdown output
     * emits bare `<h1 id="...">` with no such attribute — so the rule never
     * matches and silently does nothing. Only `.brief-body` itself carries the
     * attribute, because that div is template-authored.
     *
     * `:global()` on the descendant is the fix: the parent stays scoped, the
     * child matches whatever markdown emitted. Applied 2026-08-03 to the two
     * rules with visible symptoms (h1, a). THE REST OF THIS BLOCK IS STILL
     * DEAD — h2, h3, p, li, strong, em, ul, ol, hr, blockquote all fail the
     * same way, verified 0/12 matching in built output. They are left alone
     * deliberately: turning them on changes body typography across all 173
     * briefs and is its own decision, queued separately. Do not "tidy" them in
     * passing. */
    .brief-body :global(h1) { display: none; } /* title already in header */
    .brief-body h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin: 36px 0 12px;
    }
    .brief-body h3 {
      font-family: 'Syne', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--pine);
      margin: 24px 0 8px;
    }
    .brief-body p {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.75;
      margin-bottom: 16px;
    }
    .brief-body strong { font-weight: 600; color: var(--pine-dark); }
    .brief-body em { font-style: italic; }
    .brief-body ul, .brief-body ol {
      margin: 0 0 16px 20px;
    }
    .brief-body li {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .brief-body :global(a) {
      color: var(--pine);
      text-decoration: underline;
      text-decoration-color: var(--pine-light);
    }
    .brief-body :global(a:hover) { color: var(--pine-dark); }
    .brief-body hr {
      border: none;
      border-top: 1px solid var(--sand-dark);
      margin: 32px 0;
    }
    .brief-body blockquote {
      border-left: 3px solid var(--volt);
      padding: 8px 0 8px 18px;
      margin: 24px 0;
      background: var(--sand);
      border-radius: 0 4px 4px 0;
    }
    .brief-body blockquote p { margin-bottom: 0; }


    @media (max-width: 640px) {
      .brief-title { font-size: 1.4rem; }
      .site-header { padding: 28px 20px 24px; }
    }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(briefSchema, null, 2)} />
  {/* Favicon — same five tags as Base.astro. Repeated here because this route
      owns its own <head> and does not use the layout. See Base.astro. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>

<nav style="background:var(--color-gunmetal,#1a1a2e);padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;">
  <a href="/" style="color:var(--color-snow,#f5f5f5);font-weight:700;font-size:1rem;text-decoration:none;letter-spacing:0.02em;">AICV</a>
  <div style="display:flex;gap:1.5rem;align-items:center;">
    <a href="/nodes/" style="color:var(--color-snow,#f5f5f5);font-size:0.875rem;text-decoration:none;opacity:0.8;">Nodes</a>
    <a href="/briefs/" style="color:var(--color-snow,#f5f5f5);font-size:0.875rem;text-decoration:none;opacity:0.8;">Briefs</a>
    <a href="/get-agent-ready/#diagnostic" style="color:var(--color-volt,#d4ff00);font-size:0.875rem;text-decoration:none;font-weight:600;">Agent Preview</a>
  </div>
</nav>

<a href="/briefs/" style="display:inline-block;margin:1.5rem 2rem 0;color:var(--color-volt,#d4ff00);font-size:0.875rem;text-decoration:none;opacity:0.8;">← All Briefs</a>

  <header class="site-header">
    <div class="inner">
      <p class="brief-date">{formattedDate}</p>
      <h1 class="brief-title">{title}</h1>
      {tags && tags.length > 0 && (
        <div class="tag-row">
          {tags.map((tag: string) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </header>

  <div class="page-wrap">
    <div class="brief-body">
      {correction && correction.length > 0 && correction.map((c: { date: string; summary: string }) => (
        <p class="correction-note">{c.summary}</p>
      ))}
      <Content />
    </div>


<Footer variant="compact" />
  </div>

</body>
</html>
