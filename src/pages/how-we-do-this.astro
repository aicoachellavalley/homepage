  /* ─── HOW WE DO THIS PAGE ─── */
  .hwd-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 48px;
    position: relative;
  }
  .hwd-eyebrow {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    color: var(--pine);
    margin-bottom: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
  }
