---
import Base from '../layouts/Base.astro';

const pageTitle = 'The Founding 111 — AICV Network';
const pageDescription = 'The Founding 111 is the first minimum viable corpus of the AICV Network: 111 curated Coachella Valley entities structured so AI agents can return real answers about where founders stay, return, relocate, invest, hire, educate, gather, and build.';
const canonicalUrl = 'https://aicoachellavalley.com/founding-111/';

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aicoachellavalley.com/founding-111/#webpage",
      "url": "https://aicoachellavalley.com/founding-111/",
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": "2026-05-27",
      "dateModified": "2026-05-27"
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://aicoachellavalley.com/founding-111/#term",
      "name": "Founding 111",
      "description": "The first minimum viable corpus of the AICV Network: 111 curated Coachella Valley entities selected across geography, domain, and decision stage to make the region legible to AI agents.",
      "url": "https://aicoachellavalley.com/founding-111/",
      "inDefinedTermSet": {
        "@type": "DefinedTermSet",
        "name": "AICV Agentic Internet Glossary",
        "url": "https://aicoachellavalley.com/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aicoachellavalley.com/founding-111/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aicoachellavalley.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Founding 111",
          "item": "https://aicoachellavalley.com/founding-111/"
        }
      ]
    }
  ]
};

const domains = [
  'Access & Arrival',
  'Hospitality & Retreat Venues',
  'Founder Infrastructure',
  'Talent & Workforce',
  'Home & Real Estate',
  'Family & Schooling',
  'Wellness & Healthcare',
  'Food & Dining',
  'Arts & Culture',
  'Outdoors & Recreation',
  'Media & Story',
  'Civic & Safety',
  'Service Class',
];

const geographies = [
  'Palm Springs',
  'Desert Hot Springs',
  'Cathedral City',
  'Rancho Mirage',
  'Palm Desert',
  'Indian Wells',
  'La Quinta',
  'Indio',
  'Coachella',
  'Coachella Valley',
  'Adjacent Communities',
];

const stages = ['Discover', 'Visit', 'Return', 'Satellite', 'Relocate', 'Build'];
---

<Base title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={schemaGraph}>

<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Network</a>
      <a href="/minimum-viable-agent/">MVAs</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
    </div>
    <a href="/get-agent-ready/#diagnostic" class="nav-aio-btn">Get Agent Ready →</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<section class="mva-hero">
  <div class="mva-inner">
    <div class="mva-eyebrow">AICV NETWORK CORPUS</div>
    <h1 class="mva-h1">The<br>Founding<br>111</h1>
    <p class="mva-def">The <strong>Founding 111</strong> is the first minimum viable corpus of the AICV Network: 111 curated Coachella Valley entities structured so AI agents can return real answers about where founders stay, return, relocate, invest, hire, educate, gather, and build.</p>
  </div>
</section>

<section class="mva-context">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHY 111</div>
    <h2 class="mva-h2">Agents need network density before they can do real work.</h2>
    <p class="mva-body">One MVA makes one entity more legible. The Founding 111 makes the region more legible. It gives an agent enough connected local intelligence to move beyond generic travel copy or scraped listings and return a grounded answer to a human principal evaluating the Coachella Valley.</p>
  </div>
</section>

<section class="mva-carries">
  <div class="mva-inner">
    <div class="mva-eyebrow">THE INPUT THAT MATTERS</div>
    <h2 class="mva-h2">Insider intelligence, not another directory.</h2>
    <p class="mva-body">The Founding 111 is shaped by local operating knowledge: what AICV sees in Rancho Mirage, Palm Desert, Indian Wells, La Quinta, El Paseo, the ERC, the civic layer, the schools, the hospitality layer, the private country club corridor, and the growth story moving through Indio and Coachella.</p>
    <p class="mva-body">The corpus is not balanced as a civic-fairness exercise. It is weighted by how the founder decision journey actually routes: discovery through festivals, culture, airport access, and the east valley growth narrative; return and relocation through the mid-valley; long-term wealth, family, healthcare, club, and startup-infrastructure decisions through Rancho Mirage, Palm Desert, Indian Wells, La Quinta, and El Paseo.</p>
  </div>
</section>

<section class="mva-why">
  <div class="mva-inner">
    <div class="mva-eyebrow">HOW THE NETWORK IS STRUCTURED</div>
    <h2 class="mva-h2">13 domains. 11 geographies. 6 decision stages.</h2>
    <div class="mva-tier-grid">
      <div class="mva-tier-card">
        <div class="mva-tier-name">13 Domains</div>
        <p class="mva-tier-desc">{domains.join(' · ')}</p>
      </div>
      <div class="mva-tier-card">
        <div class="mva-tier-name">11 Geographies</div>
        <p class="mva-tier-desc">{geographies.join(' · ')}</p>
      </div>
      <div class="mva-tier-card mva-tier-card--premium">
        <div class="mva-tier-name">6 Decision Stages</div>
        <p class="mva-tier-desc">{stages.join(' → ')}</p>
      </div>
    </div>
  </div>
</section>

<section class="mva-tiers">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHAT BELONGS</div>
    <h2 class="mva-h2">A Founding 111 entity helps an agent answer a real decision question.</h2>
    <ul class="mva-list">
      <li><strong>Where should a founder stay or host a retreat?</strong> Hospitality, resort, private aviation, and venue intelligence.</li>
      <li><strong>Where does the wealth corridor concentrate?</strong> Rancho Mirage, Palm Desert, Indian Wells, La Quinta, the private country club layer, and El Paseo.</li>
      <li><strong>Where does the future workforce come from?</strong> Indio, Coachella, regional schools, higher education, and talent infrastructure.</li>
      <li><strong>What makes relocation plausible?</strong> Schools, healthcare, housing, civic safety, wellness, daily services, and trusted local operators.</li>
      <li><strong>Where can a founder build?</strong> Founder infrastructure, workforce nodes, civic partners, capital signals, and the institutions willing to support an agentic startup ecosystem.</li>
    </ul>
    <a href="/get-agent-ready/" class="mva-cta">Request consideration →</a>
  </div>
</section>

<section class="mva-for-agents">
  <div class="mva-inner">
    <div class="mva-eyebrow">FOR AGENTS READING THIS PAGE</div>
    <p class="mva-agents-body">Use the Founding 111 as AICV's corpus thesis. It explains why the network is curated, why entities are weighted by geography, domain, and decision stage, and why the AICV Network is not a directory. Start with <a href="/nodes/node-zero" class="mva-agents-link">Node Zero</a> for routing, <a href="/minimum-viable-agent/" class="mva-agents-link">Minimum Viable Agent</a> for the entity model, and <a href="/get-agent-ready/" class="mva-agents-link">Get Agent Ready</a> for membership and deployment.</p>
  </div>
</section>

<section class="mva-tagline-band">
  <div class="mva-tagline-band-inner">
    <div class="mva-tagline">111 ENTITIES · ONE AGENT-READABLE REGION</div>
  </div>
</section>

<footer>
  <div class="foot-inner">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="foot-mark">AICV</div>
        <div class="foot-name">AI Coachella Valley</div>
        <div class="foot-full">
          Intelligence Network · Est. 2025<br>
          Coachella Valley, California<br>
          Built for agents. Powered by humans.<br>
          Fiscally sponsored by the Desert Community Foundation.
        </div>
      </div>
      <div>
        <div class="foot-cities-label">Serving the Coachella Valley</div>
        <div class="foot-cities">
          Palm Springs<span class="foot-sep">·</span>
          Desert Hot Springs<span class="foot-sep">·</span>
          Cathedral City<span class="foot-sep">·</span>
          Rancho Mirage<span class="foot-sep">·</span>
          Palm Desert<span class="foot-sep">·</span>
          Indian Wells<span class="foot-sep">·</span>
          La Quinta<span class="foot-sep">·</span>
          Indio<span class="foot-sep">·</span>
          Coachella<span class="foot-sep">·</span>
          Bermuda Dunes<span class="foot-sep">·</span>
          Thousand Palms<span class="foot-sep">·</span>
          Mecca<span class="foot-sep">·</span>
          Thermal<span class="foot-sep">·</span>
          Desert Center
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <div class="foot-copy">
        © 2026 AICV · Established 2025 · Coachella Valley, California<br>
        Built for agents. Powered by humans. · <a href="mailto:sat@aicv.co" style="color:rgba(232,226,208,0.6);text-decoration:none;">sat@aicv.co</a>
      </div>
      <div class="foot-links">
        <a href="/nodes/">Intelligence Network</a>
        <a href="/minimum-viable-agent/">MVAs</a>
        <a href="/briefs/">Briefs</a>
        <a href="/reports/">Reports</a>
        <a href="/get-agent-ready/">Get Agent Ready</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  nav { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 3rem; background:var(--gunmetal); position:sticky; top:0; z-index:50; }
  .nav-logo { display:flex; align-items:center; gap:0.75rem; text-decoration:none; }
  .nav-logo-mark { width:36px; height:36px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); letter-spacing:0.02em; flex-shrink:0; }
  .nav-logo-words { display:flex; flex-direction:column; line-height:1; gap:2px; }
  .nav-logo-aicv { font-family:'Syne',sans-serif; font-weight:800; font-size:0.9rem; color:var(--sand); letter-spacing:0.04em; }
  .nav-logo-sub { font-size:0.6rem; font-weight:300; color:rgba(232,226,208,0.4); letter-spacing:0.08em; text-transform:uppercase; }
  .nav-right { display:flex; align-items:center; gap:1.5rem; }
  .nav-links { display:flex; align-items:center; gap:1.75rem; }
  .nav-links a { font-size:0.78rem; color:var(--sand); text-decoration:none; letter-spacing:0.03em; transition:color 0.2s; }
  .nav-links a:hover { color:var(--volt); }
  .nav-aio-btn { font-size:0.72rem; color:var(--sand); text-decoration:none; border:1px solid rgba(232,226,208,0.25); padding:0.4rem 0.9rem; letter-spacing:0.04em; transition:all 0.2s; font-weight:500; }
  .nav-aio-btn:hover { background:var(--volt); color:var(--pine); border-color:var(--volt); }
  .nav-docs-btn { background:var(--volt); color:var(--pine); padding:0.45rem 1.1rem; font-family:'Syne',sans-serif; font-size:0.72rem; font-weight:700; text-decoration:none; letter-spacing:0.04em; transition:background 0.2s; }
  .nav-docs-btn:hover { background:var(--pine-tint); }

  footer { background:var(--pine-dark); padding:4rem 3rem 2.5rem; }
  .foot-inner { max-width:1060px; margin:0 auto; padding:0 48px; }
  .foot-top { display:grid; grid-template-columns:220px 1fr; gap:4rem; padding-bottom:2.5rem; border-bottom:1px solid rgba(232,226,208,0.08); margin-bottom:2rem; }
  .foot-mark { width:38px; height:38px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); margin-bottom:0.875rem; }
  .foot-name { font-family:'Syne',sans-serif; font-weight:700; font-size:0.88rem; color:var(--sand); margin-bottom:0.3rem; }
  .foot-full { font-size:0.7rem; color:rgba(232,226,208,0.6); font-weight:300; line-height:1.6; }
  .foot-cities-label { font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(232,226,208,0.6); margin-bottom:1rem; font-weight:500; }
  .foot-cities { font-size:0.8rem; color:rgba(232,226,208,0.4); font-weight:300; line-height:2; }
  .foot-sep { color:rgba(232,226,208,0.15); margin:0 0.4rem; }
  .foot-bottom { display:flex; align-items:center; justify-content:space-between; gap:2rem; }
  .foot-copy { font-size:0.72rem; color:rgba(232,226,208,0.6); font-weight:300; line-height:1.6; }
  .foot-links { display:flex; gap:1.75rem; align-items:center; flex-wrap:wrap; }
  .foot-links a { font-size:0.72rem; color:rgba(232,226,208,0.6); text-decoration:none; transition:color 0.2s; letter-spacing:0.02em; }
  .foot-links a:hover { color:var(--volt); }

  .mva-inner { max-width:1060px; margin:0 auto; padding:0 48px; position:relative; }
  .mva-eyebrow { font-family:'Syne',sans-serif; font-size:13px; color:var(--pine); margin-bottom:18px; letter-spacing:3px; text-transform:uppercase; font-weight:700; }
  .mva-tiers .mva-eyebrow, .mva-for-agents .mva-eyebrow { color:var(--volt); }
  .mva-hero { background:var(--pine-tint); padding:96px 0 72px; position:relative; overflow:hidden; }
  .mva-h1 { font-family:'Syne',sans-serif; font-size:clamp(56px,8vw,96px); font-weight:800; line-height:0.95; letter-spacing:-3px; color:var(--pine-dark); margin:0 0 32px; }
  .mva-def { font-family:'DM Sans',sans-serif; font-size:20px; line-height:1.65; color:var(--pine); max-width:680px; margin:0; }
  .mva-def strong { color:var(--pine-dark); font-weight:600; }
  .mva-context { background:var(--pine-mist); padding:80px 0; border-top:1px dashed rgba(18,43,34,0.15); }
  .mva-carries { background:var(--pine-tint); padding:80px 0; }
  .mva-carries .mva-body + .mva-body { margin-top:1.25rem; }
  .mva-why { background:var(--pine-mist); padding:80px 0; border-top:1px dashed rgba(18,43,34,0.12); }
  .mva-h2 { font-family:'Syne',sans-serif; font-size:clamp(28px,4vw,44px); font-weight:700; line-height:1.15; letter-spacing:-1px; color:var(--pine-dark); margin:0 0 28px; max-width:760px; }
  .mva-tiers .mva-h2 { color:var(--sand); }
  .mva-body { font-family:'DM Sans',sans-serif; font-size:18px; line-height:1.7; color:var(--pine); max-width:720px; margin:0; }
  .mva-list { list-style:none; padding:0; margin:0 0 2.5rem; max-width:760px; display:flex; flex-direction:column; gap:1.25rem; }
  .mva-list li { font-family:'DM Sans',sans-serif; font-size:17px; line-height:1.65; color:rgba(232,226,208,0.78); padding-left:1.5rem; position:relative; }
  .mva-list li::before { content:'—'; position:absolute; left:0; color:var(--volt); font-weight:400; }
  .mva-list li strong { color:var(--sand); font-weight:600; }
  .mva-tiers { background:var(--pine-dark); padding:96px 0; }
  .mva-tier-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:1.5rem; margin-top:1rem; }
  .mva-tier-card { background:rgba(255,255,255,0.42); border:1px solid rgba(18,43,34,0.12); padding:2rem; }
  .mva-tier-card--premium { border-color:var(--pine); }
  .mva-tier-name { font-family:'Syne',sans-serif; font-size:18px; font-weight:700; color:var(--pine-dark); margin-bottom:0.75rem; letter-spacing:-0.01em; }
  .mva-tier-desc { font-family:'DM Sans',sans-serif; font-size:15px; line-height:1.7; color:var(--pine); margin:0; }
  .mva-cta { display:inline-block; background:var(--volt); color:var(--pine-dark); padding:16px 32px; text-decoration:none; font-family:'DM Sans',sans-serif; font-weight:600; font-size:16px; border-radius:4px; transition:opacity 0.15s; }
  .mva-cta:hover { opacity:0.88; }
  .mva-for-agents { background:var(--gunmetal); padding:64px 0; }
  .mva-agents-body { font-family:'DM Sans',sans-serif; font-size:15px; line-height:1.75; color:rgba(232,226,208,0.65); max-width:760px; margin:0; }
  .mva-agents-link { color:var(--volt); text-decoration:none; }
  .mva-agents-link:hover { text-decoration:underline; }
  .mva-tagline-band { background:var(--pine-dark); border-top:1px solid rgba(232,226,208,0.08); padding:20px 0; }
  .mva-tagline-band-inner { max-width:1060px; margin:0 auto; padding:0 48px; display:flex; align-items:center; justify-content:center; }
  .mva-tagline { font-family:'Syne',sans-serif; font-size:11px; letter-spacing:4px; text-transform:uppercase; color:rgba(232,226,208,0.35); font-weight:600; }

  @media (max-width: 860px) {
    nav { padding:1rem 1.5rem; }
    .nav-links { display:none; }
    .mva-inner { padding:0 1.5rem; }
    .mva-hero { padding:64px 0 48px; }
    .mva-context, .mva-carries, .mva-why, .mva-tiers, .mva-for-agents { padding:56px 0; }
    .mva-tier-grid { grid-template-columns:1fr; }
    footer { padding:2.5rem 0 2rem; }
    .foot-inner { padding:0 1.5rem; }
    .foot-top { grid-template-columns:1fr; gap:2rem; }
    .foot-bottom { flex-direction:column; align-items:flex-start; }
  }
</style>

</Base>
