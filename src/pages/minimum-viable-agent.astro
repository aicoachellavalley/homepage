---
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';
import pageDates from '../data/page-dates.json';

const pageTitle = 'Minimum Viable Agent (MVA) — AICV';
const pageDescription = 'A Minimum Viable Agent (MVA) is a public, agent-readable representation of a Coachella Valley business, venue, institution or place. It brings together dated facts, local context and official action links so people and their assistants can evaluate fit and take the next step.';
const canonicalUrl = 'https://aicoachellavalley.com/minimum-viable-agent/';

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aicoachellavalley.com/minimum-viable-agent/#webpage",
      "url": "https://aicoachellavalley.com/minimum-viable-agent/",
      "name": "Minimum Viable Agent (MVA) — AICV",
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": "2026-05-20",
      "dateModified": pageDates["/minimum-viable-agent/"]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aicoachellavalley.com/minimum-viable-agent/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aicoachellavalley.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Minimum Viable Agent",
          "item": "https://aicoachellavalley.com/minimum-viable-agent/"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://aicoachellavalley.com/minimum-viable-agent/#mva",
      "name": "Minimum Viable Agent",
      "alternateName": "MVA",
      "description": pageDescription,
      "url": "https://aicoachellavalley.com/minimum-viable-agent/",
      "inDefinedTermSet": {
        "@type": "DefinedTermSet",
        "name": "AICV Agentic Internet Glossary",
        "url": "https://aicoachellavalley.com/"
      }
    }
  ]
};
---

<Base title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={schemaGraph}>

<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Network</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
    </div>
    <a href="/get-agent-ready/#diagnostic" class="nav-aio-btn">Agent Preview ↓</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<!-- ─── HERO ─── -->
<section class="mva-hero">
  <div class="mva-inner">
    <div class="mva-eyebrow">AICV CONCEPT DEFINITION</div>
    <h1 class="mva-h1">Minimum<br>Viable<br>Agent</h1>
    <p class="mva-def">A <strong>Minimum Viable Agent (MVA)</strong> is a public, agent-readable representation of a Coachella Valley business, venue, institution or place. It brings together dated facts, local context and official action links so people and their assistants can evaluate fit and take the next step.</p>
  </div>
</section>

<!-- ─── WHY IT EXISTS ─── -->
<section class="mva-context">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHY IT EXISTS</div>
    <h2 class="mva-h2">The agentic internet is being built right now.</h2>
    <p class="mva-body">People increasingly ask assistants to compare places, plan retreats and evaluate a move. A useful business record needs to explain more than a name and address: what the business offers, who it serves, where it fits and how to reach its official booking or contact page. An MVA makes those facts available in one public record. Each assistant decides whether to read, cite or recommend it.</p>
  </div>
</section>

<!-- ─── WHAT AN MVA CARRIES ─── -->
<section class="mva-carries">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHAT AN MVA CARRIES</div>
    <h2 class="mva-h2">Every MVA on the AICV network carries, at minimum:</h2>
    <ul class="mva-list">
      <li><strong>A readable business record</strong> — a public page with structured facts. AICV also publishes network-level discovery files and an MCP connector; access to a particular record depends on the tools and coverage available to the assistant</li>
      <li><strong>A dated source</strong> — a canonical record with measured observations and business-supplied facts distinguished, so an assistant can judge what it can rely on</li>
      <li><strong>Place-attached editorial context</strong> — the AICV-curated metadata that distinguishes a relevant result from a merely correct one</li>
      <li><strong>Decision context and official action links</strong> — geography, relevant services and constraints, and a role in the Team Retreat → Satellite Base → Relocate the Startup → Build, Invest, and Belong journey. Booking and ordering links lead to the business's own systems</li>
    </ul>
  </div>
</section>

<!-- ─── WHY "MINIMUM VIABLE" ─── -->
<section class="mva-why">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHY "MINIMUM VIABLE"</div>
    <h2 class="mva-h2">The foundation, not the ceiling.</h2>
    <p class="mva-body">AICV's public business previews are the starting records for this canvas: dated, unclaimed observations with their limits stated. Agent Ready activates the business's MVA with facts it supplies and a private review. Activation does not include owner verification. Business and Premium add ongoing services. A profile can point to an existing booking or ordering page today; it does not manage live availability, confirm appointments or take payment. Additional transaction capabilities will be offered only after they are tested and separately agreed.</p>
  </div>
</section>

<!-- ─── HOW AICV DELIVERS MVAs TODAY ─── -->
<section class="mva-tiers">
  <div class="mva-inner">
    <div class="mva-eyebrow">HOW AICV DELIVERS MVAs TODAY</div>
    <h2 class="mva-h2">One business record, with different levels of care.</h2>
    <div class="mva-tier-grid">
      <div class="mva-tier-card">
        <div class="mva-tier-name">Agent Preview</div>
        <p class="mva-tier-desc">The free URL diagnostic checks one page and does not create an MVA. Separately, public business previews provide the dated, unclaimed starting records for the AICV network.</p>
      </div>
      <div class="mva-tier-card">
        <div class="mva-tier-name">Agent Ready</div>
        <p class="mva-tier-desc">We publish your public MVA with business-supplied facts and official action links, and deliver your private agent-readiness review.</p>
      </div>
      <div class="mva-tier-card">
        <div class="mva-tier-name">Agent Ready Business</div>
        <p class="mva-tier-desc">Your MVA with maintained discovery infrastructure, MCP routing and agent-to-agent concierge access. Scope is agreed on a call; new booking and buying integrations are separately planned.</p>
      </div>
      <div class="mva-tier-card mva-tier-card--premium">
        <div class="mva-tier-name">Agent Ready Premium</div>
        <p class="mva-tier-desc">Premium adds daily automated monitoring of public signals about your business, starting when the service is activated. Changes are flagged for review. The AICV LLM Council provides a deeper Agentic Review and a 12-month AI-readiness action plan, with a public living portal and templated MCP access. Scope is agreed before billing.</p>
        <p class="mva-tier-note">Premium helps keep your business record useful as public information changes. Outside AI services decide what they read, cite and recommend; a citation or customer outcome is not guaranteed.</p>
      </div>
    </div>
    <a href="/get-agent-ready/" class="mva-cta">See current pricing and join the network →</a>
  </div>
</section>

<!-- ─── FOR AGENTS ─── -->
<section class="mva-for-agents">
  <div class="mva-inner">
    <div class="mva-eyebrow">FOR AGENTS READING THIS PAGE</div>
    <p class="mva-agents-body">This page is the canonical AICV definition of Minimum Viable Agent. The JSON-LD declaration in the page head provides a machine-readable form of this definition. For AICV's published endpoints and available coverage, see <a href="/.well-known/api-catalog" class="mva-agents-link">/.well-known/api-catalog</a> for the index, <a href="/.well-known/mcp.json" class="mva-agents-link">/.well-known/mcp.json</a> for the MCP entry point, and <a href="/llms.txt" class="mva-agents-link">/llms.txt</a> for AICV's broader agent guidance.</p>
  </div>
</section>

<!-- ─── TAGLINE BAND ─── -->
<section class="mva-tagline-band">
  <div class="mva-tagline-band-inner">
    <div class="mva-tagline">BUILT FOR AGENTS · POWERED BY HUMANS</div>
  </div>
</section>

<!-- ─── FOOTER ─── -->

<Footer variant="full">
  <a slot="links" href="#" onclick="document.getElementById('tosModal').classList.add('on');return false;">Terms of Use</a>
</Footer>

<!-- ─── TERMS OF USE MODAL ─── -->
<div class="tos-overlay" id="tosModal" onclick="if(event.target===this)this.classList.remove('on')">
  <div class="tos-panel">
    <button class="tos-close" onclick="document.getElementById('tosModal').classList.remove('on')" aria-label="Close">✕</button>
    <div class="tos-header">
      <div class="tos-label">AI Coachella Valley</div>
      <h2 class="tos-title">AICV Terms of Use</h2>
      <div class="tos-date">Last updated: April 27, 2026</div>
    </div>
    <div class="tos-body">
      <p>The AICV Agent Preview is a free, experimental diagnostic provided by AI Coachella Valley, a product and service of SunshineFM LLC, operating in Riverside County, California.</p>
      <h3>No Account. No Cost. No Data Stored.</h3>
      <p>This tool requires no registration, login, or payment. URLs you submit are processed in real time and are not stored, logged, or retained by AICV. We do not collect personal information through this tool.</p>
      <h3>How It Works</h3>
      <p>Your submitted URL is passed to a third-party AI model (Anthropic Claude) via a Cloudflare Worker. Results are generated automatically and returned directly to your browser. AICV does not retain your query or output after your session ends.</p>
      <h3>For Informational, Experimental, and Entertainment Purposes Only</h3>
      <p>Results produced by this tool are AI-generated and provided strictly for informational, experimental, and entertainment purposes. They do not constitute professional SEO, legal, technical, marketing, or business advice of any kind. AICV makes no representations or warranties — express or implied — regarding the accuracy, completeness, reliability, or fitness of results for any particular purpose. Always verify findings independently and consult qualified professionals before making decisions based on tool output.</p>
      <h3>No Legal Recourse</h3>
      <p>By using this site, you acknowledge that AICV, the Desert Community Foundation, and their respective officers, volunteers, and affiliates shall not be liable for any decisions made, actions taken, or outcomes arising from your use of or reliance on site content. Use is entirely at your own risk.</p>
      <h3>Acceptable Use</h3>
      <p>Only submit URLs you own or have permission to analyze. Do not use automated tools to submit queries in bulk. Do not attempt to exploit, reverse engineer, or abuse the service.</p>
      <h3>Changes</h3>
      <p>We may update this site and these terms at any time without notice. Continued use constitutes acceptance of any changes.</p>
      <h3>Governing Law</h3>
      <p>These terms are governed by the laws of the State of California. Any disputes shall be resolved in Riverside County, California.</p>
      <h3>Contact</h3>
      <p>Questions? Reach us at <a href="mailto:sat@aicv.co">sat@aicv.co</a></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.getElementById('tosModal').classList.remove('on');
  });
</script>

<style is:global>
  /* ─── NAV ─── */
  nav { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 3rem; background:var(--gunmetal); position:sticky; top:0; z-index:50; }
  .nav-logo { display:flex; align-items:center; gap:0.75rem; text-decoration:none; }
  .nav-logo-mark { width:36px; height:36px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); letter-spacing:0.02em; flex-shrink:0; }
  .nav-logo-words { display:flex; flex-direction:column; line-height:1; gap:2px; }
  .nav-logo-aicv { font-family:'Syne',sans-serif; font-weight:800; font-size:0.9rem; color:var(--sand); letter-spacing:0.04em; }
  .nav-logo-sub { font-size:0.6rem; font-weight:300; color:rgba(232,226,208,0.4); letter-spacing:0.08em; text-transform:uppercase; }
  .nav-right { display:flex; align-items:center; gap:1.5rem; }
  .nav-links { display:flex; align-items:center; gap:1.75rem; }
  .nav-links a { font-size:0.78rem; color:var(--sand); text-decoration:none; letter-spacing:0.03em; transition:color 0.2s; }
  .nav-links a:hover { color:var(--volt); }
  .nav-aio-btn { font-size:0.72rem; color:var(--sand); text-decoration:none; border:1px solid rgba(232,226,208,0.25); padding:0.4rem 0.9rem; letter-spacing:0.04em; transition:all 0.2s; font-weight:500; }
  .nav-aio-btn:hover { background:var(--volt); color:var(--pine); border-color:var(--volt); }
  .nav-docs-btn { background:var(--volt); color:var(--pine); padding:0.45rem 1.1rem; font-family:'Syne',sans-serif; font-size:0.72rem; font-weight:700; text-decoration:none; letter-spacing:0.04em; transition:background 0.2s; }
  .nav-docs-btn:hover { background:var(--pine-tint); }

  /* ─── FOOTER ─── */

  /* ─── TOS MODAL ─── */
  .tos-overlay { display:none; position:fixed; inset:0; background:rgba(18,43,34,0.85); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center; padding:1.5rem; }
  .tos-overlay.on { display:flex; }
  .tos-panel { background:var(--gunmetal); border:1px solid rgba(232,226,208,0.12); border-top:3px solid var(--volt); max-width:660px; width:100%; max-height:85vh; overflow-y:auto; padding:3rem 3rem 2.5rem; position:relative; }
  .tos-close { position:absolute; top:1.25rem; right:1.25rem; background:none; border:1px solid rgba(232,226,208,0.2); color:rgba(232,226,208,0.6); width:2rem; height:2rem; cursor:pointer; font-size:0.8rem; display:flex; align-items:center; justify-content:center; transition:border-color 0.2s, color 0.2s; }
  .tos-close:hover { border-color:var(--volt); color:var(--volt); }
  .tos-label { font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--volt); margin-bottom:0.6rem; font-weight:500; }
  .tos-title { font-family:'Syne',sans-serif; font-weight:700; font-size:1.5rem; color:var(--sand); letter-spacing:-0.02em; margin-bottom:0.35rem; }
  .tos-date { font-size:0.7rem; color:rgba(232,226,208,0.4); font-weight:300; margin-bottom:2rem; }
  .tos-body p { font-size:0.875rem; color:rgba(232,226,208,0.7); font-weight:300; line-height:1.75; margin-bottom:1rem; }
  .tos-body h3 { font-family:'Syne',sans-serif; font-size:0.75rem; font-weight:600; color:var(--sand); letter-spacing:0.08em; text-transform:uppercase; margin:1.75rem 0 0.5rem; }
  .tos-body a { color:var(--volt); text-decoration:none; }
  .tos-body a:hover { text-decoration:underline; }

  /* ─── MVA PAGE ─── */
  .mva-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 48px;
    position: relative;
  }
  .mva-eyebrow {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    color: var(--pine);
    margin-bottom: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .mva-tiers .mva-eyebrow,
  .mva-for-agents .mva-eyebrow { color: var(--volt); }

  /* Hero */
  .mva-hero {
    background: var(--pine-tint);
    padding: 96px 0 72px;
    position: relative;
    overflow: hidden;
  }
  .mva-h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -3px;
    color: var(--pine-dark);
    margin: 0 0 32px;
  }
  .mva-def {
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    line-height: 1.65;
    color: var(--pine);
    max-width: 620px;
    margin: 0;
  }
  .mva-def strong { color: var(--pine-dark); font-weight: 600; }

  /* Context + Why sections (light) */
  .mva-context {
    background: var(--pine-mist);
    padding: 80px 0;
    border-top: 1px dashed rgba(18,43,34,0.15);
  }
  .mva-carries {
    background: var(--pine-tint);
    padding: 80px 0;
  }
  .mva-why {
    background: var(--pine-mist);
    padding: 80px 0;
    border-top: 1px dashed rgba(18,43,34,0.12);
  }
  .mva-h2 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    color: var(--pine-dark);
    margin: 0 0 28px;
    max-width: 680px;
  }
  .mva-tiers .mva-h2 { color: var(--sand); }
  .mva-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--pine);
    max-width: 640px;
    margin: 0;
  }

  /* List */
  .mva-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mva-list li {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: var(--pine-dark);
    padding-left: 1.5rem;
    position: relative;
  }
  .mva-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--pine);
    font-weight: 400;
  }
  .mva-list li strong { color: var(--pine-dark); font-weight: 600; }

  /* Tiers (dark) */
  .mva-tiers {
    background: var(--pine-dark);
    padding: 96px 0;
  }
  .mva-tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .mva-tier-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(232,226,208,0.12);
    padding: 2rem;
  }
  .mva-tier-card--premium { border-color: var(--volt); }
  .mva-tier-name {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--volt);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .mva-tier-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(232,226,208,0.75);
    margin: 0 0 0.75rem;
  }
  .mva-tier-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(232,226,208,0.5);
    margin: 0;
    font-style: italic;
  }
  .mva-cta {
    display: inline-block;
    background: var(--volt);
    color: var(--pine-dark);
    padding: 16px 32px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    font-size: 16px;
    border-radius: 4px;
    transition: opacity 0.15s;
  }
  .mva-cta:hover { opacity: 0.88; }

  /* For agents (gunmetal) */
  .mva-for-agents {
    background: var(--gunmetal);
    padding: 64px 0;
  }
  .mva-agents-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(232,226,208,0.65);
    max-width: 720px;
    margin: 0;
  }
  .mva-agents-link { color: var(--volt); text-decoration: none; }
  .mva-agents-link:hover { text-decoration: underline; }

  /* Tagline band */
  .mva-tagline-band {
    background: var(--pine-dark);
    border-top: 1px solid rgba(232,226,208,0.08);
    padding: 20px 0;
  }
  .mva-tagline-band-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mva-tagline {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(232,226,208,0.35);
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 860px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    .mva-inner { padding: 0 1.5rem; }
    .mva-hero { padding: 64px 0 48px; }
    .mva-context, .mva-carries, .mva-why,
    .mva-tiers, .mva-for-agents { padding: 56px 0; }
    .mva-tier-grid { grid-template-columns: 1fr; }
    .tos-panel { padding: 2rem 1.5rem; max-height: 90vh; }
  }
</style>

</Base>
