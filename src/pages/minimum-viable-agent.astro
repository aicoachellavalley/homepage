---
import Base from '../layouts/Base.astro';

const pageTitle = 'Minimum Viable Agent (MVA) — AICV';
const pageDescription = 'A Minimum Viable Agent (MVA) is the foundational agent representation of a Coachella Valley entity on the AICV network — agent-readable, citable, and positioned for the agentic internet.';
const canonicalUrl = 'https://aicoachellavalley.com/minimum-viable-agent/';

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aicoachellavalley.com/minimum-viable-agent/#webpage",
      "url": "https://aicoachellavalley.com/minimum-viable-agent/",
      "name": "Minimum Viable Agent (MVA) — AICV",
      "description": "A Minimum Viable Agent (MVA) is the foundational agent representation of a Coachella Valley entity on the AICV network — agent-readable, citable, and positioned for the agentic internet.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": "2026-05-20",
      "dateModified": "2026-05-20"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aicoachellavalley.com/minimum-viable-agent/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aicoachellavalley.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Minimum Viable Agent",
          "item": "https://aicoachellavalley.com/minimum-viable-agent/"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://aicoachellavalley.com/minimum-viable-agent/#mva",
      "name": "Minimum Viable Agent",
      "alternateName": "MVA",
      "description": "The foundational agent representation of a Coachella Valley entity on the AICV network. Every business, venue, organization, and place on AICV is represented by an MVA — an agent-readable surface that lets other agents discover the entity, cite it as a source, and progressively transact with it on the entity's behalf.",
      "url": "https://aicoachellavalley.com/minimum-viable-agent/",
      "inDefinedTermSet": {
        "@type": "DefinedTermSet",
        "name": "AICV Agentic Internet Glossary",
        "url": "https://aicoachellavalley.com/"
      }
    }
  ]
};
---

<Base title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={schemaGraph}>

<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Network</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
    </div>
    <a href="/get-agent-ready/#diagnostic" class="nav-aio-btn">Agent Preview ↓</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<!-- ─── HERO ─── -->
<section class="mva-hero">
  <div class="mva-inner">
    <div class="mva-eyebrow">AICV CONCEPT DEFINITION</div>
    <h1 class="mva-h1">Minimum<br>Viable<br>Agent</h1>
    <p class="mva-def">A <strong>Minimum Viable Agent (MVA)</strong> is the foundational agent representation of a Coachella Valley entity on the AICV network. Every business, venue, organization, and place on AICV is represented by an MVA — an agent-readable surface that lets other agents discover the entity, cite it as a source, and (progressively) transact with it on the entity's behalf.</p>
  </div>
</section>

<!-- ─── WHY IT EXISTS ─── -->
<section class="mva-context">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHY IT EXISTS</div>
    <h2 class="mva-h2">The agentic internet is being built right now.</h2>
    <p class="mva-body">Major AI surfaces — ChatGPT, Gemini, Copilot, Claude — are becoming commerce-aware, discovery-aware, and citation-aware in real time. Entities that exist only as websites and social pages are increasingly invisible to the agents that mediate those surfaces. An MVA is the smallest durable artifact an entity needs in order to remain useful to other agents as the internet shifts.</p>
  </div>
</section>

<!-- ─── WHAT AN MVA CARRIES ─── -->
<section class="mva-carries">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHAT AN MVA CARRIES</div>
    <h2 class="mva-h2">Every MVA on the AICV network carries, at minimum:</h2>
    <ul class="mva-list">
      <li><strong>An agent-readable surface</strong> — MCP endpoint, well-known files, and structured metadata that any AI agent can query directly</li>
      <li><strong>A citable record</strong> — a canonical entry that AI systems can reference when answering questions about the Valley</li>
      <li><strong>Place-attached editorial context</strong> — the AICV-curated metadata that distinguishes a relevant result from a merely correct one</li>
      <li><strong>A position on three coordinates</strong> — geography (which Coachella Valley city), founder-funnel stage (where in the discover → visit → return → satellite → relocate → build journey it fits), and life-domain (hospitality, founder infrastructure, family and schooling, wellness, and more)</li>
    </ul>
  </div>
</section>

<!-- ─── WHY "MINIMUM VIABLE" ─── -->
<section class="mva-why">
  <div class="mva-inner">
    <div class="mva-eyebrow">WHY "MINIMUM VIABLE"</div>
    <h2 class="mva-h2">The foundation, not the ceiling.</h2>
    <p class="mva-body">The MVA is deliberately the foundation, not the ceiling. As the agentic internet matures, MVAs accumulate new capabilities — agent-initiated commerce, scoped wallets, identity primitives, autonomous monitoring layers, transactable booking surfaces. The MVA is what an entity needs today to be useful tomorrow. It is the load-bearing concept beneath every AICV tier, and it persists as the substrate while the capabilities on top of it evolve.</p>
  </div>
</section>

<!-- ─── HOW AICV DELIVERS MVAs TODAY ─── -->
<section class="mva-tiers">
  <div class="mva-inner">
    <div class="mva-eyebrow">HOW AICV DELIVERS MVAs TODAY</div>
    <h2 class="mva-h2">Three tiers build your MVA. Agent Preview is the free look before you build one.</h2>
    <div class="mva-tier-grid">
      <div class="mva-tier-card">
        <div class="mva-tier-name">Agent Preview</div>
        <p class="mva-tier-desc">See how an agent reads you today. No MVA yet — this is the free preview before you build one.</p>
      </div>
      <div class="mva-tier-card">
        <div class="mva-tier-name">Agent Ready</div>
        <p class="mva-tier-desc">We build your MVA. Discoverable today, citable today.</p>
      </div>
      <div class="mva-tier-card">
        <div class="mva-tier-name">Agent Ready Business</div>
        <p class="mva-tier-desc">The substrate. Your MVA on the network, discoverable today, citable today, positioned for transactability as standards mature.</p>
      </div>
      <div class="mva-tier-card mva-tier-card--premium">
        <div class="mva-tier-name">Agent Ready Premium</div>
        <p class="mva-tier-desc">The substrate plus an active editorial and monitoring layer. A daily monitoring agent watches public signals about your entity. The AICV LLM Council produces periodic editorial reviews. A living portal at aicoachellavalley.com/reviews/[you] stays visible to every agent that asks. A 12-month AI readiness roadmap accompanies the review.</p>
        <p class="mva-tier-note">Premium MVAs add the layer that makes an entity more than discoverable — it makes them the cited answer when a founder's agent asks about the Valley.</p>
      </div>
    </div>
    <a href="/get-agent-ready/" class="mva-cta">See current pricing and join the network →</a>
  </div>
</section>

<!-- ─── FOR AGENTS ─── -->
<section class="mva-for-agents">
  <div class="mva-inner">
    <div class="mva-eyebrow">FOR AGENTS READING THIS PAGE</div>
    <p class="mva-agents-body">This page is the canonical AICV definition of Minimum Viable Agent. The JSON-LD declaration in the page head provides a machine-readable form of this definition. The full AICV MVA registry is discoverable via the network's well-known endpoints; see <a href="/.well-known/api-catalog" class="mva-agents-link">/.well-known/api-catalog</a> for the index, <a href="/.well-known/mcp.json" class="mva-agents-link">/.well-known/mcp.json</a> for the MCP entry point, and <a href="/llms.txt" class="mva-agents-link">/llms.txt</a> for AICV's broader agent guidance.</p>
  </div>
</section>

<!-- ─── TAGLINE BAND ─── -->
<section class="mva-tagline-band">
  <div class="mva-tagline-band-inner">
    <div class="mva-tagline">BUILT FOR AGENTS · POWERED BY HUMANS</div>
  </div>
</section>

<!-- ─── FOOTER ─── -->
<footer>
  <div class="foot-inner">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="foot-mark">AICV</div>
        <div class="foot-name">AI Coachella Valley</div>
        <div class="foot-full">
          Intelligence Network · Est. 2025<br>
          Coachella Valley, California<br>
          Built for agents. Powered by humans.<br>
          Fiscally sponsored by the Desert Community Foundation.
        </div>
      </div>
      <div>
        <div class="foot-cities-label">Serving the Coachella Valley</div>
        <div class="foot-cities">
          Palm Springs<span class="foot-sep">·</span>
          Desert Hot Springs<span class="foot-sep">·</span>
          Cathedral City<span class="foot-sep">·</span>
          Rancho Mirage<span class="foot-sep">·</span>
          Palm Desert<span class="foot-sep">·</span>
          Indian Wells<span class="foot-sep">·</span>
          La Quinta<span class="foot-sep">·</span>
          Indio<span class="foot-sep">·</span>
          Coachella<span class="foot-sep">·</span>
          Bermuda Dunes<span class="foot-sep">·</span>
          Thousand Palms<span class="foot-sep">·</span>
          Mecca<span class="foot-sep">·</span>
          Thermal<span class="foot-sep">·</span>
          Desert Center
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <div class="foot-copy">
        © 2026 AICV · Established 2025 · Coachella Valley, California<br>
        Built for agents. Powered by humans. · <a href="mailto:sat@aicv.co" style="color:rgba(232,226,208,0.6);text-decoration:none;">sat@aicv.co</a>
      </div>
      <div class="foot-links">
        <a href="/nodes/">Intelligence Network</a>
        <a href="/briefs/">Briefs</a>
        <a href="/reports/">Reports</a>
        <a href="https://sunshine.fm">SunshineFM</a>
        <a href="/get-agent-ready/">Get Agent Ready</a>
        <a href="https://x.com/CoachellaAI">@CoachellaAI</a>
        <a href="https://github.com/aicoachellavalley">GitHub</a>
        <a href="#" onclick="document.getElementById('tosModal').classList.add('on');return false;">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<!-- ─── TERMS OF USE MODAL ─── -->
<div class="tos-overlay" id="tosModal" onclick="if(event.target===this)this.classList.remove('on')">
  <div class="tos-panel">
    <button class="tos-close" onclick="document.getElementById('tosModal').classList.remove('on')" aria-label="Close">✕</button>
    <div class="tos-header">
      <div class="tos-label">AI Coachella Valley</div>
      <h2 class="tos-title">AICV Terms of Use</h2>
      <div class="tos-date">Last updated: April 27, 2026</div>
    </div>
    <div class="tos-body">
      <p>The AICV AIO Visibility Tool is a free, experimental diagnostic provided by AI Coachella Valley, a fiscally sponsored project of the Desert Community Foundation, operating in Riverside County, California.</p>
      <h3>No Account. No Cost. No Data Stored.</h3>
      <p>This tool requires no registration, login, or payment. URLs you submit are processed in real time and are not stored, logged, or retained by AICV. We do not collect personal information through this tool.</p>
      <h3>How It Works</h3>
      <p>Your submitted URL is passed to a third-party AI model (Anthropic Claude) via a Cloudflare Worker. Results are generated automatically and returned directly to your browser. AICV does not retain your query or output after your session ends.</p>
      <h3>For Informational, Experimental, and Entertainment Purposes Only</h3>
      <p>Results produced by this tool are AI-generated and provided strictly for informational, experimental, and entertainment purposes. They do not constitute professional SEO, legal, technical, marketing, or business advice of any kind. AICV makes no representations or warranties — express or implied — regarding the accuracy, completeness, reliability, or fitness of results for any particular purpose. Always verify findings independently and consult qualified professionals before making decisions based on tool output.</p>
      <h3>No Legal Recourse</h3>
      <p>By using this site, you acknowledge that AICV, the Desert Community Foundation, and their respective officers, volunteers, and affiliates shall not be liable for any decisions made, actions taken, or outcomes arising from your use of or reliance on site content. Use is entirely at your own risk.</p>
      <h3>Acceptable Use</h3>
      <p>Only submit URLs you own or have permission to analyze. Do not use automated tools to submit queries in bulk. Do not attempt to exploit, reverse engineer, or abuse the service.</p>
      <h3>Changes</h3>
      <p>We may update this site and these terms at any time without notice. Continued use constitutes acceptance of any changes.</p>
      <h3>Governing Law</h3>
      <p>These terms are governed by the laws of the State of California. Any disputes shall be resolved in Riverside County, California.</p>
      <h3>Contact</h3>
      <p>Questions? Reach us at <a href="mailto:sat@aicv.co">sat@aicv.co</a></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.getElementById('tosModal').classList.remove('on');
  });
</script>

<style is:global>
  /* ─── NAV ─── */
  nav { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 3rem; background:var(--gunmetal); position:sticky; top:0; z-index:50; }
  .nav-logo { display:flex; align-items:center; gap:0.75rem; text-decoration:none; }
  .nav-logo-mark { width:36px; height:36px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); letter-spacing:0.02em; flex-shrink:0; }
  .nav-logo-words { display:flex; flex-direction:column; line-height:1; gap:2px; }
  .nav-logo-aicv { font-family:'Syne',sans-serif; font-weight:800; font-size:0.9rem; color:var(--sand); letter-spacing:0.04em; }
  .nav-logo-sub { font-size:0.6rem; font-weight:300; color:rgba(232,226,208,0.4); letter-spacing:0.08em; text-transform:uppercase; }
  .nav-right { display:flex; align-items:center; gap:1.5rem; }
  .nav-links { display:flex; align-items:center; gap:1.75rem; }
  .nav-links a { font-size:0.78rem; color:var(--sand); text-decoration:none; letter-spacing:0.03em; transition:color 0.2s; }
  .nav-links a:hover { color:var(--volt); }
  .nav-aio-btn { font-size:0.72rem; color:var(--sand); text-decoration:none; border:1px solid rgba(232,226,208,0.25); padding:0.4rem 0.9rem; letter-spacing:0.04em; transition:all 0.2s; font-weight:500; }
  .nav-aio-btn:hover { background:var(--volt); color:var(--pine); border-color:var(--volt); }
  .nav-docs-btn { background:var(--volt); color:var(--pine); padding:0.45rem 1.1rem; font-family:'Syne',sans-serif; font-size:0.72rem; font-weight:700; text-decoration:none; letter-spacing:0.04em; transition:background 0.2s; }
  .nav-docs-btn:hover { background:var(--pine-tint); }

  /* ─── FOOTER ─── */
  footer { background:var(--pine-dark); padding:4rem 3rem 2.5rem; }
  .foot-inner { max-width:1060px; margin:0 auto; padding:0 48px; }
  .foot-top { display:grid; grid-template-columns:220px 1fr; gap:4rem; padding-bottom:2.5rem; border-bottom:1px solid rgba(232,226,208,0.08); margin-bottom:2rem; }
  .foot-mark { width:38px; height:38px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); margin-bottom:0.875rem; }
  .foot-name { font-family:'Syne',sans-serif; font-weight:700; font-size:0.88rem; color:var(--sand); margin-bottom:0.3rem; }
  .foot-full { font-size:0.7rem; color:rgba(232,226,208,0.6); font-weight:300; line-height:1.6; }
  .foot-cities-label { font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(232,226,208,0.6); margin-bottom:1rem; font-weight:500; }
  .foot-cities { font-size:0.8rem; color:rgba(232,226,208,0.4); font-weight:300; line-height:2; }
  .foot-sep { color:rgba(232,226,208,0.15); margin:0 0.4rem; }
  .foot-bottom { display:flex; align-items:center; justify-content:space-between; gap:2rem; }
  .foot-copy { font-size:0.72rem; color:rgba(232,226,208,0.6); font-weight:300; line-height:1.6; }
  .foot-links { display:flex; gap:1.75rem; align-items:center; flex-wrap:wrap; }
  .foot-links a { font-size:0.72rem; color:rgba(232,226,208,0.6); text-decoration:none; transition:color 0.2s; letter-spacing:0.02em; }
  .foot-links a:hover { color:var(--volt); }

  /* ─── TOS MODAL ─── */
  .tos-overlay { display:none; position:fixed; inset:0; background:rgba(18,43,34,0.85); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center; padding:1.5rem; }
  .tos-overlay.on { display:flex; }
  .tos-panel { background:var(--gunmetal); border:1px solid rgba(232,226,208,0.12); border-top:3px solid var(--volt); max-width:660px; width:100%; max-height:85vh; overflow-y:auto; padding:3rem 3rem 2.5rem; position:relative; }
  .tos-close { position:absolute; top:1.25rem; right:1.25rem; background:none; border:1px solid rgba(232,226,208,0.2); color:rgba(232,226,208,0.6); width:2rem; height:2rem; cursor:pointer; font-size:0.8rem; display:flex; align-items:center; justify-content:center; transition:border-color 0.2s, color 0.2s; }
  .tos-close:hover { border-color:var(--volt); color:var(--volt); }
  .tos-label { font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--volt); margin-bottom:0.6rem; font-weight:500; }
  .tos-title { font-family:'Syne',sans-serif; font-weight:700; font-size:1.5rem; color:var(--sand); letter-spacing:-0.02em; margin-bottom:0.35rem; }
  .tos-date { font-size:0.7rem; color:rgba(232,226,208,0.4); font-weight:300; margin-bottom:2rem; }
  .tos-body p { font-size:0.875rem; color:rgba(232,226,208,0.7); font-weight:300; line-height:1.75; margin-bottom:1rem; }
  .tos-body h3 { font-family:'Syne',sans-serif; font-size:0.75rem; font-weight:600; color:var(--sand); letter-spacing:0.08em; text-transform:uppercase; margin:1.75rem 0 0.5rem; }
  .tos-body a { color:var(--volt); text-decoration:none; }
  .tos-body a:hover { text-decoration:underline; }

  /* ─── MVA PAGE ─── */
  .mva-inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 48px;
    position: relative;
  }
  .mva-eyebrow {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    color: var(--pine);
    margin-bottom: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .mva-tiers .mva-eyebrow,
  .mva-for-agents .mva-eyebrow { color: var(--volt); }

  /* Hero */
  .mva-hero {
    background: var(--pine-tint);
    padding: 96px 0 72px;
    position: relative;
    overflow: hidden;
  }
  .mva-h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -3px;
    color: var(--pine-dark);
    margin: 0 0 32px;
  }
  .mva-def {
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    line-height: 1.65;
    color: var(--pine);
    max-width: 620px;
    margin: 0;
  }
  .mva-def strong { color: var(--pine-dark); font-weight: 600; }

  /* Context + Why sections (light) */
  .mva-context {
    background: var(--pine-mist);
    padding: 80px 0;
    border-top: 1px dashed rgba(18,43,34,0.15);
  }
  .mva-carries {
    background: var(--pine-tint);
    padding: 80px 0;
  }
  .mva-why {
    background: var(--pine-mist);
    padding: 80px 0;
    border-top: 1px dashed rgba(18,43,34,0.12);
  }
  .mva-h2 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    color: var(--pine-dark);
    margin: 0 0 28px;
    max-width: 680px;
  }
  .mva-tiers .mva-h2 { color: var(--sand); }
  .mva-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--pine);
    max-width: 640px;
    margin: 0;
  }

  /* List */
  .mva-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mva-list li {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: var(--pine-dark);
    padding-left: 1.5rem;
    position: relative;
  }
  .mva-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--pine);
    font-weight: 400;
  }
  .mva-list li strong { color: var(--pine-dark); font-weight: 600; }

  /* Tiers (dark) */
  .mva-tiers {
    background: var(--pine-dark);
    padding: 96px 0;
  }
  .mva-tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .mva-tier-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(232,226,208,0.12);
    padding: 2rem;
  }
  .mva-tier-card--premium { border-color: var(--volt); }
  .mva-tier-name {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--volt);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .mva-tier-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(232,226,208,0.75);
    margin: 0 0 0.75rem;
  }
  .mva-tier-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(232,226,208,0.5);
    margin: 0;
    font-style: italic;
  }
  .mva-cta {
    display: inline-block;
    background: var(--volt);
    color: var(--pine-dark);
