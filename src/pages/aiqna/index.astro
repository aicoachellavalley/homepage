---
import { getEntry } from 'astro:content';

// The methodology entry drives the meta bar, the canonical URL, and the
// TechArticle schema — so the page is frontmatter-driven, not hardcoded.
const entry = await getEntry('aiqna', 'methodology');
const { title, description, date, status, license, canonical } = entry!.data;

const canonicalUrl = canonical ?? 'https://aicoachellavalley.com/aiqna';
const licenseUrl = 'https://creativecommons.org/licenses/by/4.0/';

/* CANONICAL LEGAL ENTITY — same @id as the node in get-agent-ready.astro, so
 * consumers resolve both to ONE entity. It is restated here rather than merely
 * referenced because JSON-LD is processed per document: a bare @id on this page
 * with no matching node would assert "AICV has a parent" while naming nobody —
 * worse than silence on a page whose whole point is entity correction.
 * AICV is a brand, not a legal entity. legalName belongs to the LLC, never to
 * AICV, and the fiscal sponsorship belongs to the .org project only. */
const llcSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://aicoachellavalley.com/#llc',
  'name': 'SunshineFM LLC',
  'legalName': 'SunshineFM LLC',
};

const techArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': 'AIQnA — Methodology and Source Documentation',
  'description': 'Source documentation for the Coachella Valley\'s first longitudinal AI sentiment corpus, operated by AI Coachella Valley.',
  'author': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
    'parentOrganization': { '@id': 'https://aicoachellavalley.com/#llc' },
  },
  'url': canonicalUrl,
  'datePublished': date,
  'inLanguage': 'en-US',
  'license': licenseUrl,
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'AIQnA',
  'alternateName': 'AI Question and Answer',
  'url': 'https://aiqna.org',
  'description': 'AIQnA is a regional AI listening infrastructure operated by AI Coachella Valley. Each week, residents respond to one question about AI and daily life through a short conversation with an AI agent. Aggregate findings publish every Friday under CC-BY-4.0.',
  'provider': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
  },
  'areaServed': {
    '@type': 'Place',
    'name': 'Coachella Valley, California',
  },
  'serviceType': 'Civic AI listening infrastructure',
  'termsOfService': 'https://aicoachellavalley.com/aiqna',
  'audience': [
    { '@type': 'Audience', 'audienceType': 'Coachella Valley residents' },
    { '@type': 'Audience', 'audienceType': 'Local media outlets' },
    { '@type': 'Audience', 'audienceType': 'Local businesses and operators' },
    { '@type': 'Audience', 'audienceType': 'Journalists and researchers' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Who runs AIQnA?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'AIQnA is built, engineered, and operated by AI Coachella Valley — a regional intelligence network based at the CSUSB Entrepreneurship Resource Center in Palm Desert, California. AICV is a product and service of SunshineFM LLC.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How are AIQnA questions selected?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Questions are drafted by AICV against a calendar mapped to the 13-week series. Domains rotate by season and include work, education, healthcare, creativity, privacy, journalism, companionship, environment, and civic services. Questions are designed to be accessible to any resident, locally specific where appropriate, and structurally neutral.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Is my response to AIQnA anonymous?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes. AIQnA does not request or retain identifying information. The only metadata captured is city of residence and audience type. Individual records are never shared with media partners, sponsors, or any third party. You may opt out of verbatim quote publication while still contributing to aggregate findings.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can sponsors influence AIQnA findings?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No. Sponsors do not select questions, review findings before publication, or shape methodology. Sponsorship buys association with the program, not influence over its outputs.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Who can participate in AIQnA?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Anyone who lives, works, or operates a business in the Coachella Valley can participate. The conversation runs at aiqna.org and takes under five minutes. No account or login is required. One response per question per device.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How are AIQnA findings published?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Each Friday, aggregate findings publish on aiqna.org as a human-readable summary and on aicoachellavalley.com/aiqna/[week-slug] as a structured canonical record. Partner media outlets receive a complete seven-piece content kit — topline findings, word cloud and visual, city breakdown, selected quotes, story-lead memo, social posts, and radio reads with a newsletter blurb.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can other regions operate AIQnA?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The AIQnA methodology and infrastructure are being incubated in the Coachella Valley with an eye toward broader Inland Empire deployment. Regional licensing arrangements are not yet open. Interested parties should contact AICV directly.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Is AIQnA affiliated with any political organization?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No. AIQnA does not endorse candidates, parties, or political positions. Questions and findings are presented documentarily. AICV operates as a civic technology initiative.',
      },
    },
  ],
};
