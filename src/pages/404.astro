---
import Base from '../layouts/Base.astro';
---

<Base
  title="Not found — AI Coachella Valley"
  description="This page doesn't exist on AI Coachella Valley. Return to the homepage to browse nodes, intelligence briefs, and reports."
>
  <main style="min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; font-family: system-ui, -apple-system, sans-serif;">
    <h1 style="font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 1rem; font-weight: 600;">Page not found</h1>
    <p style="font-size: 1.1rem; max-width: 32rem; margin: 0 0 2rem; line-height: 1.6; opacity: 0.8;">
      The page you're looking for doesn't exist on AI Coachella Valley. It may have been moved, or the link may be incorrect.
    </p>
    <a href="/" style="display: inline-block; padding: 0.75rem 1.5rem; border: 1px solid currentColor; text-decoration: none; font-weight: 500; border-radius: 4px;">
      Return to homepage
    </a>
  </main>
</Base>
