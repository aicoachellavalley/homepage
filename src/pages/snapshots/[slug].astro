---
export async function getStaticPaths() {
  const files = import.meta.glob('../../data/snapshots/*.json');
  return Object.keys(files).map((path) => {
    const slug = path.replace('../../data/snapshots/', '').replace('.json', '');
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
let snapshot;
try {
  snapshot = (await import(`../../data/snapshots/${slug}.json`)).default;
} catch {
  return Astro.redirect('/404');
}

if (!snapshot) {
  return Astro.redirect('/404');
}

let node = null;
try {
  node = (await import(`../../data/nodes/${slug}.json`)).default;
} catch {
  node = null;
}

const {
  entityName,
  metaTitle,
  metaDescription,
  datePublished,
  dateModified,
  snapshotLocation,
  snapshotPeriod,
  schema,
  grades,
  opener,
  methodology,
  findings,
  actions,
  cta,
  passphrase,
} = snapshot;

const topGaps: Array<{ gap: string; impact: string; quick_win?: boolean }> =
  Array.isArray(snapshot.top_gaps) && snapshot.top_gaps.length > 0
    ? snapshot.top_gaps
    : [];

function gradeBg(g: string) {
  const map: Record<string, string> = {
    A: '#1B4332',
    B: '#2D6A4F',
    C: '#D8FF00',
    D: '#E8E2D0',
    F: '#1E1E1E',
  };
  return map[g] ?? '#E8E2D0';
}
function gradeColor(g: string) {
  const map: Record<string, string> = {
    A: '#D8FF00',
    B: '#F5F5F5',
    C: '#122B22',
    D: '#1B4332',
    F: '#F5F5F5',
  };
  return map[g] ?? '#1B4332';
}
function gradeBorder(g: string) {
  const map: Record<string, string> = {
    A: '#1B4332',
    B: '#2D6A4F',
    C: '#D8FF00',
    D: '#D4CCBA',
    F: '#D4CCBA',
  };
  return map[g] ?? '#D4CCBA';
}
function gradeLightBg(g: string) {
  const map: Record<string, string> = {
    A: 'rgba(27,67,50,0.12)',
    B: 'rgba(45,106,79,0.12)',
    C: 'rgba(216,255,0,0.15)',
    D: '#F2EDE0',
    F: 'rgba(30,30,30,0.08)',
  };
  return map[g] ?? '#F2EDE0';
}
function gradeLabel(g: string) {
  const map: Record<string, string> = {
    A: 'A-Tier',
    B: 'Boss Mode',
    C: 'Credible',
    D: 'Draft Mode',
    F: 'Foundational',
  };
  return map[g] ?? g;
}
function findingHeaderBorderColor(g: string) {
  const map: Record<string, string> = {
    A: 'rgba(27,67,50,0.2)',
    B: 'rgba(45,106,79,0.2)',
    C: 'rgba(180,210,0,0.3)',
    D: '#D4CCBA',
    F: '#D4CCBA',
  };
  return map[g] ?? '#D4CCBA';
}

const schemaJson = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished,
  dateModified,
  publisher: {
    '@type': 'Organization',
    name: 'AI Coachella Valley',
    url: 'https://aicoachellavalley.com',
  },
  author: {
    '@type': 'Organization',
    name: 'AI Coachella Valley',
  },
  about: {
    '@type': schema.aboutType,
    name: schema.aboutName,
    ...(schema.aboutUrl ? { url: schema.aboutUrl } : {}),
    address: {
      '@type': 'PostalAddress',
      addressLocality: schema.addressLocality,
      addressRegion: schema.addressRegion,
    },
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'buyerReadinessGrade', value: grades.buyerReadiness },
    { '@type': 'PropertyValue', name: 'competitivePositioningGrade', value: grades.competitivePositioning },
    { '@type': 'PropertyValue', name: 'aiReadinessGrade', value: grades.aiReadiness },
  ],
};

const ctaHref = `mailto:sat@aicv.co?subject=${encodeURIComponent(cta.emailSubject)}&body=${encodeURIComponent(cta.emailBody)}`;
const canonicalUrl = `https://aicoachellavalley.com/snapshots/${slug}/`;

const brBg    = gradeBg(grades.buyerReadiness);
const brColor = gradeColor(grades.buyerReadiness);
const brBdr   = gradeBorder(grades.buyerReadiness);

const cpBg    = gradeBg(grades.competitivePositioning);
const cpColor = gradeColor(grades.competitivePositioning);
const cpBdr   = gradeBorder(grades.competitivePositioning);

const arBg    = gradeBg(grades.aiReadiness);
const arColor = gradeColor(grades.aiReadiness);
const arBdr   = gradeBorder(grades.aiReadiness);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />

  <script type="application/ld+json" set:html={JSON.stringify(schemaJson, null, 2)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --volt:         #D8FF00;
      --pine:         #1B4332;
      --pine-light:   #2D6A4F;
      --pine-dark:    #122B22;
      --gunmetal:     #1E1E1E;
      --gunmetal-2:   #252525;
      --snow:         #F5F5F5;
      --sand:         #E8E2D0;
      --sand-light:   #F2EDE0;
      --sand-dark:    #D4CCBA;
      --sky:          #7ED4E6;
      --success:      #4ade80;
      --warning:      #fbbf24;
      --danger:       #f87171;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; }

    body {
      background-color: var(--sand-light);
      color: var(--pine);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    .page-wrap {
      max-width: 780px;
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    /* HEADER */
    .site-header {
      background-color: var(--pine-dark);
      border-bottom: 2px solid var(--pine-light);
      padding: 48px 24px 40px;
    }
    .site-header .inner { max-width: 780px; margin: 0 auto; }

    h1, h2, h3 { font-family: 'Syne', sans-serif; }

    .entity-name {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 2.2rem;
      font-weight: 500;
      color: var(--sand-light);
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin-bottom: 10px;
    }

    .snapshot-meta {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--pine-light);
    }

    /* GRADE BOXES IN HEADER */
    .header-grades {
      display: flex;
      gap: 8px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .header-grade-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .header-grade-tile {
      width: 46px;
      height: 46px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid transparent;
    }
    .header-grade-tile span {
      font-family: 'Syne', sans-serif;
      font-size: 20px;
      font-weight: 700;
    }
    .header-grade-label {
      font-size: 9px;
      color: var(--pine-light);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    /* DIVIDER */
    .divider { border: none; border-top: 1px solid var(--sand-dark); margin: 32px 0; }

    /* TAB BAR */
    .tab-bar {
      display: flex;
      border-bottom: 2px solid var(--sand-dark);
      margin-bottom: 32px;
      margin-top: 32px;
    }
    .tab-btn {
      background: none;
      border: none;
      padding: 10px 18px;
      font-size: 13px;
      color: var(--pine-light);
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      font-family: 'DM Sans', inherit;
      font-weight: 500;
      transition: color 0.15s;
    }
    .tab-btn.active {
      color: var(--pine-dark);
      border-bottom-color: var(--pine-light);
      font-weight: 700;
    }
    .tab-btn:hover { color: var(--pine-dark); }

    /* TAB PANELS */
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* SECTION HEADING */
    .section-heading {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 16px;
    }

    /* OPENER */
    .opener-lead {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 1.25rem;
      font-style: italic;
      line-height: 1.5;
      color: var(--pine-dark);
      padding-left: 16px;
      border-left: 3px solid var(--pine-light);
      margin-bottom: 20px;
    }
    .opener-bridge {
      font-size: 0.9rem;
      color: var(--pine-light);
      line-height: 1.7;
      margin-bottom: 0;
    }

    /* GRADE BADGE ROW */
    .grade-badge-row {
      display: flex;
      gap: 12px;
      margin-bottom: 0;
      flex-wrap: wrap;
    }
    .grade-badge-card {
      flex: 1;
      min-width: 160px;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid var(--sand-dark);
    }
    .grade-badge-card-header {
      padding: 12px 14px 10px;
    }
    .grade-badge-card-label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 8px;
    }
    .grade-badge-tile {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      border-radius: 4px;
      border: 1px solid transparent;
    }
    .grade-badge-tile .grade-letter {
      font-family: 'Syne', sans-serif;
      font-size: 18px;
      font-weight: 700;
    }
    .grade-badge-tile .grade-name {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    /* FINDINGS */
    .findings-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .finding {
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid var(--sand-dark);
    }
    .finding-header {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 14px 16px 12px;
      border-bottom: 1px solid transparent;
    }
    .finding-title {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--pine-light);
    }
    .finding-grade-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 4px;
      border: 1px solid transparent;
    }
    .finding-grade-badge span {
      font-family: 'Syne', sans-serif;
      font-size: 13px;
      font-weight: 700;
    }
    .finding-body {
      padding: 12px 16px 16px;
      background-color: var(--snow);
    }
    .finding-body p {
      font-size: 0.875rem;
      color: var(--pine);
      line-height: 1.75;
    }

    /* METHODOLOGY */
    .methodology-block {
      background-color: var(--snow);
      border-left: 3px solid var(--pine-light);
      padding: 20px 24px;
      border-radius: 2px;
    }
    .methodology-block p { font-size: 0.875rem; color: var(--pine); line-height: 1.7; }

    /* GRADING FRAMEWORK */
    .grade-key-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      background: var(--snow);
      border: 1px solid var(--sand-dark);
      border-radius: 4px;
      padding: 14px 16px;
    }
    .grade-key-item {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .grade-key-tile {
      width: 26px;
      height: 26px;
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid transparent;
    }
    .grade-key-tile span {
      font-family: 'Syne', sans-serif;
      font-size: 12px;
      font-weight: 700;
    }
    .grade-key-text { font-size: 11px; color: var(--pine); line-height: 1.4; }
    .grade-key-text strong { font-weight: 700; }

    /* ACTIONS */
    .action-block {
      border-left: 3px solid var(--pine-light);
      padding: 18px 22px;
      background-color: var(--snow);
      border-radius: 2px;
      margin-bottom: 8px;
    }
    .action-block.ongoing { border-left-color: var(--pine); }
    .action-timing {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 6px;
    }
    .action-block.ongoing .action-timing { color: var(--pine); }
    .action-title { font-size: 1rem; font-weight: 600; color: var(--pine-dark); margin-bottom: 8px; }
    .action-body { font-size: 0.875rem; color: var(--pine); line-height: 1.7; }

    /* INTELLIGENCE REVIEW — GATED */
    .ir-gated-wrap {
      border-radius: 6px;
    }
    .ir-blur-preview {
      display: none;
    }
    .ir-gate-overlay {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 32px 56px;
      text-align: center;
      background: rgba(242,237,224,0.97);
      border: 1px solid var(--sand-dark);
      border-radius: 6px;
    }
    .ir-gate-eyebrow {
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--pine-light);
      font-weight: 700;
      margin-bottom: 16px;
    }
    .ir-gate-headline {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 20px;
      font-style: italic;
      color: var(--pine-dark);
      line-height: 1.5;
      margin-bottom: 10px;
      max-width: 440px;
    }
    .ir-gate-body {
      font-size: 13px;
      color: var(--pine-light);
      line-height: 1.65;
      max-width: 400px;
      margin-bottom: 28px;
    }
    .ir-cta-button {
      display: inline-block;
      background: var(--pine-dark);
      color: var(--sand-light);
      padding: 12px 28px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      font-family: 'DM Sans', sans-serif;
      transition: background 0.15s;
    }
    .ir-cta-button:hover { background: var(--pine); }
    .ir-passphrase-row {
      display: flex;
      gap: 8px;
      margin-top: 20px;
      align-items: center;
    }
    .ir-pass-input {
      padding: 8px 12px;
      border: 1.5px solid var(--sand-dark);
      border-radius: 3px;
      font-size: 12px;
      font-family: 'DM Sans', sans-serif;
      background: white;
      color: var(--pine-dark);
      width: 180px;
    }
    .ir-pass-input:focus { outline: 2px solid var(--pine-light); }
    .ir-pass-btn {
      background: var(--pine);
      color: var(--sand-light);
      border: none;
      padding: 9px 16px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
    }
    .ir-pass-err {
      display: none;
      font-size: 11px;
      color: #C8552A;
      margin-top: 8px;
    }

    /* IR STATIC CARD */
    .ir-static-card {
      background: rgba(242,237,224,0.97);
      border: 1px solid var(--sand-dark);
      border-radius: 6px;
      padding: 48px 32px 52px;
      text-align: center;
      max-width: 520px;
      margin: 0 auto;
    }
    .ir-card-rule {
      border: none;
      border-top: 1px solid var(--pine);
      opacity: 0.2;
      margin-top: 24px;
      margin-bottom: 0;
    }
    .ir-plain-email {
      font-size: 13px;
      color: var(--pine-light);
      margin-top: 16px;
    }
    .ir-email-address {
      color: var(--pine);
      font-weight: 600;
    }

    /* IR UNLOCKED */
    .ir-unlocked { display: none; }
    .ir-unlocked.visible { display: block; }

    .ir-gap-item {
      background: var(--snow);
      border: 1px solid var(--sand-dark);
      border-radius: 4px;
      padding: 14px 16px;
      margin-bottom: 10px;
    }
    .ir-gap-text {
      font-size: 14px;
      color: var(--pine-dark);
      line-height: 1.65;
      margin-bottom: 8px;
    }
    .ir-gap-tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .ir-impact-badge {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 2px;
    }
    .impact-high { background: rgba(200,85,42,0.12); color: #C8552A; }
    .impact-med  { background: rgba(216,255,0,0.15); color: var(--pine); }
    .impact-low  { background: var(--sand); color: var(--pine-light); }
    .ir-quickwin-badge {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 2px;
      background: rgba(27,67,50,0.12);
      color: var(--pine);
    }
    .ir-preparing-msg {
      background: var(--sand);
      border: 1px solid var(--sand-dark);
      border-radius: 6px;
      padding: 28px 24px;
      text-align: center;
      font-size: 14px;
      color: var(--pine-light);
      line-height: 1.7;
    }
    .ir-preparing-msg a { color: var(--pine); }
    .ir-closing-cta {
      background: var(--pine-dark);
      border-radius: 6px;
      padding: 28px 24px;
      text-align: center;
      margin-top: 24px;
    }
    .ir-closing-text {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 19px;
      font-style: italic;
      color: var(--sand-light);
      line-height: 1.5;
      margin-bottom: 18px;
    }

    .ir-teaser-block {
      background: var(--sand);
      border: 1px solid var(--sand-dark);
      border-radius: 6px;
      padding: 28px 24px;
    }
    .ir-teaser-block p { font-size: 0.9rem; color: var(--pine); line-height: 1.75; }
    .ir-cta-standalone {
      display: inline-block;
      margin-top: 20px;
      background: var(--pine-dark);
      color: var(--sand-light);
      padding: 12px 24px;
      border-radius: 3px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background 0.15s;
    }
    .ir-cta-standalone:hover { background: var(--pine); }

    /* NODE TAB */
    .node-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 12px;
    }
    .node-field {
      background: var(--sand);
      border: 1px solid var(--sand-dark);
      border-radius: 4px;
      padding: 11px 13px;
    }
    .node-field-label {
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 3px;
    }
    .node-field-value {
      font-size: 13px;
      font-weight: 700;
      color: var(--pine-dark);
    }
    .node-desc-block {
      background: var(--snow);
      border: 1px solid var(--sand-dark);
      border-radius: 6px;
      padding: 14px 16px;
      margin-bottom: 14px;
    }
    .node-desc-block p { font-size: 14px; line-height: 1.7; color: var(--pine-dark); }
    .node-verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #EDF7EE;
      color: #1B5E20;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 3px 10px;
      border-radius: 2px;
    }
    .node-intent-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .node-intent-tag {
      background: rgba(255,255,255,0.1);
      color: var(--pine-light);
      font-size: 10px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 2px;
      border: 1px solid var(--sand-dark);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .node-agent-summary {
      background: var(--pine-dark);
      border: 1px solid var(--pine-light);
      border-radius: 4px;
      padding: 14px 16px;
      margin-bottom: 14px;
    }
    .node-agent-summary p { font-size: 13px; color: var(--sand-light); line-height: 1.65; }
    .node-view-link {
      display: inline-block;
      margin-top: 4px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--pine);
      text-decoration: none;
      border-bottom: 1px solid var(--pine-light);
      padding-bottom: 1px;
    }
    .node-view-link:hover { color: var(--pine-dark); }
    .node-null-msg {
      background: var(--snow);
      border: 1px solid var(--sand-dark);
      border-radius: 4px;
      padding: 24px;
      text-align: center;
      font-size: 0.9rem;
      color: var(--pine-light);
    }

    /* FOOTER */
    .site-footer {
      margin-top: 60px;
      padding-top: 28px;
      border-top: 1px solid var(--sand-dark);
      text-align: center;
    }
    .site-footer p { font-size: 0.8rem; color: var(--pine-light); line-height: 1.8; }
    .site-footer a { color: var(--pine); text-decoration: none; }
    .site-footer a:hover { text-decoration: underline; }

    @media (max-width: 700px) {
      .entity-name { font-size: 1.6rem; }
      .site-header { padding: 36px 20px 28px; }
      .findings-grid { grid-template-columns: 1fr; }
      .grade-badge-row { flex-direction: column; }
      .node-field-row { grid-template-columns: 1fr; }
      .grade-key-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="inner">
      <h1 class="entity-name">{entityName}</h1>
      <p class="snapshot-meta">AICV Intelligence Snapshot &nbsp;·&nbsp; {snapshotLocation} &nbsp;·&nbsp; {snapshotPeriod}</p>


    </div>
  </header>

  <div class="page-wrap">

    <!-- TAB BAR -->
    <nav class="tab-bar">
      <button class="tab-btn active" id="tab-btn-snapshot" onclick="showTab('snapshot')">Snapshot</button>
      <button class="tab-btn" id="tab-btn-ir" onclick="showTab('ir')">Intelligence Review</button>
      <button class="tab-btn" id="tab-btn-node" onclick="showTab('node')">Node</button>
    </nav>

    <!-- ============================================================ -->
    <!-- TAB 1: SNAPSHOT                                              -->
    <!-- ============================================================ -->
    <div class="tab-panel active" id="tab-snapshot">

      <!-- OPENER -->
      <section style="margin-bottom: 32px;">
        <p class="opener-lead">{opener.lead}</p>
        <p class="opener-bridge">{opener.bridge}</p>
      </section>

      <hr class="divider" />

      <!-- THREE GRADE BADGES -->
      <section style="margin-bottom: 32px;">
        <p class="section-heading">IC Grades</p>
        <div class="grade-badge-row">
          <!-- Buyer Readiness -->
          <div class="grade-badge-card">
            <div class="grade-badge-card-header" style={`background:${gradeLightBg(grades.buyerReadiness)};border-bottom:1px solid ${findingHeaderBorderColor(grades.buyerReadiness)};`}>
              <div class="grade-badge-card-label">Buyer Readiness</div>
              <div class="grade-badge-tile" style={`background:${gradeBg(grades.buyerReadiness)};border-color:${gradeBorder(grades.buyerReadiness)};`}>
                <span class="grade-letter" style={`color:${gradeColor(grades.buyerReadiness)};`}>{grades.buyerReadiness}</span>
                <span class="grade-name" style={`color:${gradeColor(grades.buyerReadiness)};`}>{gradeLabel(grades.buyerReadiness)}</span>
              </div>
            </div>
          </div>
          <!-- Competitive Positioning -->
          <div class="grade-badge-card">
            <div class="grade-badge-card-header" style={`background:${gradeLightBg(grades.competitivePositioning)};border-bottom:1px solid ${findingHeaderBorderColor(grades.competitivePositioning)};`}>
              <div class="grade-badge-card-label">Competitive Positioning</div>
              <div class="grade-badge-tile" style={`background:${gradeBg(grades.competitivePositioning)};border-color:${gradeBorder(grades.competitivePositioning)};`}>
                <span class="grade-letter" style={`color:${gradeColor(grades.competitivePositioning)};`}>{grades.competitivePositioning}</span>
                <span class="grade-name" style={`color:${gradeColor(grades.competitivePositioning)};`}>{gradeLabel(grades.competitivePositioning)}</span>
              </div>
            </div>
          </div>
          <!-- AI Readiness -->
          <div class="grade-badge-card">
            <div class="grade-badge-card-header" style={`background:${gradeLightBg(grades.aiReadiness)};border-bottom:1px solid ${findingHeaderBorderColor(grades.aiReadiness)};`}>
              <div class="grade-badge-card-label">AI Readiness</div>
              <div class="grade-badge-tile" style={`background:${gradeBg(grades.aiReadiness)};border-color:${gradeBorder(grades.aiReadiness)};`}>
                <span class="grade-letter" style={`color:${gradeColor(grades.aiReadiness)};`}>{grades.aiReadiness}</span>
                <span class="grade-name" style={`color:${gradeColor(grades.aiReadiness)};`}>{gradeLabel(grades.aiReadiness)}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr class="divider" />

      <!-- GRADE KEY -->
      <section style="margin-bottom: 32px;">
        <p class="section-heading">Grade Key</p>
        <div class="grade-key-grid">
          <div>
            {(['A', 'B', 'C'] as const).map((k) => (
              <div class="grade-key-item">
                <div class="grade-key-tile" style={`background:${gradeBg(k)};border-color:${gradeBorder(k)};`}>
                  <span style={`color:${gradeColor(k)};`}>{k}</span>
                </div>
                <span class="grade-key-text"><strong>{gradeLabel(k)}:</strong> {k === 'A' ? 'Leading your category. Buyers find you and choose you.' : k === 'B' ? 'Strong. Minor gaps. You\'re in the conversation.' : 'Present. Not yet distinct enough to pull buyers from alternatives.'}</span>
              </div>
            ))}
          </div>
          <div>
            {(['D', 'F'] as const).map((k) => (
              <div class="grade-key-item">
                <div class="grade-key-tile" style={`background:${gradeBg(k)};border-color:${gradeBorder(k)};`}>
                  <span style={`color:${gradeColor(k)};`}>{k}</span>
                </div>
                <span class="grade-key-text"><strong>{gradeLabel(k)}:</strong> {k === 'D' ? 'The work exists. It hasn\'t been published in the language agents read.' : 'A starting line, not a judgment.'}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <hr class="divider" />

      <!-- FINDINGS -->
      <section style="margin-bottom: 32px;">
        <p class="section-heading">The Findings</p>
        <div class="findings-grid">
          {findings.map((f) => (
            <div class="finding">
              <div class="finding-header" style={`background:${gradeLightBg(f.grade)};border-bottom-color:${findingHeaderBorderColor(f.grade)};`}>
                <span class="finding-title">{f.dimension}</span>
                <div class="finding-grade-badge" style={`background:${gradeBg(f.grade)};border-color:${gradeBorder(f.grade)};`}>
                  <span style={`color:${gradeColor(f.grade)};`}>{f.grade}</span>
                </div>
              </div>
              <div class="finding-body">
                <p>{f.body}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      {actions && actions.length > 0 && (
        <>
          <hr class="divider" />
          <section style="margin-bottom: 32px;">
            <p class="section-heading">Three Things Worth Doing</p>
            {actions.map((a) => (
              <div class={`action-block${a.ongoing ? ' ongoing' : ''}`}>
                <p class="action-timing">{a.timing}</p>
                <p class="action-title">{a.title}</p>
                <p class="action-body">{a.body}</p>
              </div>
            ))}
          </section>
        </>
      )}

      <hr class="divider" />

      <!-- METHODOLOGY -->
      <section style="margin-bottom: 0;">
        <p class="section-heading">Methodology</p>
        <div class="methodology-block">
          <p>{methodology}</p>
        </div>
      </section>

    </div><!-- /tab-snapshot -->

    <!-- ============================================================ -->
    <!-- TAB 2: INTELLIGENCE REVIEW                                   -->
    <!-- ============================================================ -->
    <div class="tab-panel" id="tab-ir">

      <div class="ir-static-card">
        <p class="ir-gate-headline">The Full Intelligence Review is available to AICV clients.</p>
        <p class="ir-gate-body">Contact AICV to unlock access to the full competitive analysis, prioritized actions, and 12-month AI readiness roadmap for this entity.</p>
        <hr class="ir-card-rule" />
        <p class="ir-plain-email">Email <span class="ir-email-address">sat@aicv.co</span> to get started.</p>
      </div>

    </div><!-- /tab-ir -->

    <!-- ============================================================ -->
    <!-- TAB 3: NODE                                                  -->
    <!-- ============================================================ -->
    <div class="tab-panel" id="tab-node">

      {node ? (
        <>
          <!-- Description -->
          <section style="margin-bottom: 16px;">
            <p class="section-heading">Description</p>
            <div class="node-desc-block">
              <p>{node.description}</p>
            </div>
          </section>

          <!-- Verified + Status -->
          <div style="display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
            {node.verified && (
              <span class="node-verified-badge">&#10003; Verified</span>
            )}
            <span class="node-intent-tag" style="background:var(--pine-dark);color:var(--volt);border-color:var(--pine-light);">{node.status}</span>
          </div>

          <!-- Key fields grid -->
          <section style="margin-bottom: 16px;">
            <p class="section-heading">Node Fields</p>
            <div class="node-field-row">
              <div class="node-field">
                <div class="node-field-label">City</div>
                <div class="node-field-value">{node.city}</div>
              </div>
              <div class="node-field">
                <div class="node-field-label">Zone</div>
                <div class="node-field-value">{node.zone}</div>
              </div>
            </div>
            <div class="node-field-row">
              <div class="node-field">
                <div class="node-field-label">Category</div>
                <div class="node-field-value">{node.category}</div>
              </div>
              <div class="node-field">
                <div class="node-field-label">Subcategory</div>
                <div class="node-field-value">{node.subcategory}</div>
              </div>
            </div>
            <div class="node-field-row">
              <div class="node-field">
                <div class="node-field-label">Slug</div>
                <div class="node-field-value" style="font-family:monospace;font-size:11px;">{node.slug}</div>
              </div>
              <div class="node-field">
                <div class="node-field-label">Last Updated</div>
                <div class="node-field-value">{node.last_updated}</div>
              </div>
            </div>
          </section>

          <!-- Agent Intent tags -->
          <section style="margin-bottom: 16px;">
            <p class="section-heading">Agent Intent</p>
            <div class="node-intent-tags">
              {(Array.isArray(node.agent_intent) ? node.agent_intent : [node.agent_intent]).map((intent: string) => (
                <span class="node-intent-tag">{intent}</span>
              ))}
            </div>
          </section>

          <!-- Agent Summary -->
          <section style="margin-bottom: 16px;">
            <p class="section-heading">Agent Summary</p>
            <div class="node-agent-summary">
              <p>{node.agent_summary}</p>
            </div>
          </section>

          <!-- Link to node -->
          <a class="node-view-link" href={`/nodes/${node.slug}/`}>View full node →</a>
        </>
      ) : (
        <div class="node-null-msg">
          <p>Node data not yet available for this entity.</p>
        </div>
      )}

    </div><!-- /tab-node -->

    <footer class="site-footer">
      <p>AI Coachella Valley &nbsp;·&nbsp; <a href="https://aicoachellavalley.com">aicoachellavalley.com</a></p>
      <p>Building the intelligence layer for the Coachella Valley.</p>
    </footer>

  </div><!-- /page-wrap -->

  <script is:inline>
    function showTab(name) {
      // Hide all panels
      document.querySelectorAll('.tab-panel').forEach(function(p) {
        p.classList.remove('active');
      });
      // Deactivate all buttons
      document.querySelectorAll('.tab-btn').forEach(function(b) {
        b.classList.remove('active');
      });
      // Show selected panel
      var panel = document.getElementById('tab-' + name);
      if (panel) panel.classList.add('active');
      // Activate selected button
      var btn = document.getElementById('tab-btn-' + name);
      if (btn) btn.classList.add('active');
    }

    // Initialize first tab on load
    document.addEventListener('DOMContentLoaded', function() {
      showTab('snapshot');
    });
  </script>

</body>
</html>
