      <div class="gar-v2-tier-body">
        <div class="gar-v2-tier-eyebrow">GET BUILT <span class="gr-starthere">Start here</span></div>
        <div class="gar-v2-tier-name">Agent Ready</div>
        <p class="gar-v2-tier-desc">{pricing.tiers[1].blurb}</p>
      </div>
      <div class="gar-v2-tier-divider"></div>
      <div class="gar-v2-tier-price-block">
        <div class="gar-v2-tier-price-main">{pricing.tiers[1].price_amount} <span class="gar-v2-tier-price-cadence">{pricing.tiers[1].price_cadence}</span></div>
        <div class="gar-v2-tier-price-setup"><em>{pricing.tiers[1].price_sub}</em></div>
      </div>
      <a id="agentReadyPurchase" href="https://buy.stripe.com/6oUfZhcZN0hBcEa1we8k801" class="gar-v2-tier-cta gr-cta-volt" aria-describedby="purchase-match-note">Get Agent Ready — $500&nbsp;→</a>
      <button type="button" class="gar-v2-tier-inc" onclick="document.getElementById('inc-ready').classList.add('on');return false;">What's included</button>
    </div>

    <!-- TIER 2: Agent Ready Business -->
    <div class="gar-v2-tier-card gar-v2-tier-ready">
      <div class="gar-v2-tier-body">
        <div class="gar-v2-tier-eyebrow">GET SERVICED</div>
        <div class="gar-v2-tier-name">Agent Ready Business</div>
        <p class="gar-v2-tier-desc">{pricing.tiers[2].blurb}</p>
      </div>
      <div class="gar-v2-tier-divider"></div>
      <div class="gar-v2-tier-price-block">
        <div class="gar-v2-tier-price-main">{pricing.tiers[2].price_amount} <span class="gar-v2-tier-price-cadence">{pricing.tiers[2].price_cadence}</span></div>
        <div class="gar-v2-tier-price-setup"><em>{pricing.tiers[2].price_sub}</em></div>
      </div>
      <a href="https://calendar.app.google/AHgC8z8rGoYZ1Eju5" target="_blank" rel="noopener noreferrer" class="gar-v2-tier-cta">Book a Call&nbsp;→</a>
      <button type="button" class="gar-v2-tier-inc" onclick="document.getElementById('inc-business').classList.add('on');return false;">What's included</button>
    </div>

    <!-- TIER 3: Agent Ready Premium -->
    <div class="gar-v2-tier-card gar-v2-tier-reviewed">
      <div class="gar-v2-tier-body">
        <div class="gar-v2-tier-eyebrow">GET CURATED</div>
        <div class="gar-v2-tier-name">Agent Ready Premium</div>
        <p class="gar-v2-tier-desc">{pricing.tiers[3].blurb}</p>
      </div>
      <div class="gar-v2-tier-divider"></div>
      <div class="gar-v2-tier-price-block">
        <div class="gar-v2-tier-price-main">{pricing.tiers[3].price_amount} <span class="gar-v2-tier-price-cadence">{pricing.tiers[3].price_cadence}</span></div>
