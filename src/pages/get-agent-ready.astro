  .score-num.mid { color: var(--warning); }
  .score-num.lo { color: var(--danger); }

  .score-grade {
    font-family: 'Syne', sans-serif;
    font-size: 5.5rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .score-bar-wrap { width: 100%; }
  .score-bar-track {
    position: relative;
