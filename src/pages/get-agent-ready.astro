    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 0.875rem;
  }

  .aio-sub {
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--pine-light);
    line-height: 1.75;
    max-width: 54ch;
  }

  .aio-callout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .aio-callout-item {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--volt);
    letter-spacing: 0.04em;
    font-family: 'Syne', sans-serif;
  }

  .aio-callout-divider { color: rgba(216,255,0,0.4); font-size: 0.9rem; }

  .aio-card {
    background: var(--gunmetal);
    border: 2px solid var(--volt);
    padding: 2.5rem;
    position: relative;
  }

  .aio-input-label {
    font-size: 0.82rem;
    color: rgba(232,226,208,0.75);
    margin-bottom: 1rem;
    display: block;
    font-weight: 300;
    line-height: 1.6;
  }

  .aio-row { display: flex; margin-bottom: 0.75rem; }

  .aio-input {
    flex: 1;
    background: var(--gunmetal);
    border: 1px solid var(--sand);
    border-right: none;
    padding: 1rem 1.25rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: var(--sand);
    outline: none;
    transition: border-color 0.2s;
  }
  .aio-input::placeholder { color: rgba(232,226,208,0.35); }
  .aio-input:focus { border-color: var(--volt); }

  .aio-submit {
    background: var(--volt);
    color: var(--pine);
    border: none;
    border-radius: 0;
    padding: 1rem 2rem;
    font-family: 'Syne', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    white-space: nowrap;
  }
  .aio-submit:hover { background: #e8ff33; }
  .aio-submit:active { transform: scale(0.98); }
  .aio-submit:disabled { background: rgba(216,255,0,0.3); color: rgba(27,67,50,0.4); cursor: not-allowed; }

  .aio-note { font-size: 0.7rem; color: rgba(232,226,208,0.4); font-weight: 300; }

  .aio-loading { display: none; text-align: center; padding: 2.5rem 0 1rem; }
  .aio-loading.on { display: block; }

  .spin {
    width: 30px; height: 30px;
    border: 2px solid rgba(27,67,50,0.1);
    border-top-color: var(--pine);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 0.875rem;
  }

  .loading-txt { font-size: 0.82rem; color: rgba(232,226,208,0.55); font-weight: 300; }
  .loading-step { font-size: 0.72rem; color: var(--volt); margin-top: 0.35rem; opacity: 0.7; }

  .aio-results { display: none; margin-top: 2.25rem; padding-top: 2.25rem; border-top: 1px solid rgba(232,226,208,0.08); }
  .aio-results.on { display: block; background: var(--sand-light); border-radius: 2px; padding: 2rem; margin-top: 1.5rem; }

  /* Score/grade/gauge styles removed — the tool no longer renders a verdict. */

  /* ─── AGENT PREVIEW CARD — structured read (header / ladder /
     dimensions / fixes). Filled by renderReview() from the worker's
     structured response. State tints are literals by design: they are the
     card's own semantic scale, not brand tokens. ─── */
  .aicv-review {
    background: var(--sand);
    border: 1px solid var(--pine-tint);
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.25rem;
    max-width: 720px;
    color: var(--pine);
  }
  .gr-access-guide { padding: 2.5rem 0; background: var(--sand); color: var(--pine-dark); scroll-margin-top: 96px; }
  .gr-access-guide h2 { font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 1.5rem; margin: .6rem 0 1rem; }
  .gr-access-guide p, .gr-access-guide li { font-size: .9rem; line-height: 1.7; margin: .7rem 0; }
  .gr-access-guide ol { padding-left: 1.4rem; }
  .gr-access-guide a, .aicv-access a { color: var(--pine); text-decoration: underline; }
  .gr-access-guide summary { cursor: pointer; font-weight: 600; padding: .75rem 0; }
  .gr-access-guide summary:focus-visible, .gr-access-guide a:focus-visible { outline: 2px solid var(--pine-dark); outline-offset: 3px; }
  .gar-example { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--pine); scroll-margin-top: 110px; }
  .gar-example a:focus-visible { outline: 2px solid var(--pine-dark); outline-offset: 4px; }
  .gar-visibility-promise, .gr-asof { font-size: 1rem; line-height: 1.7; margin: 1.5rem 0; }
  .gr-research-date { display: block; margin-top: .5rem; font-size: .875rem; }
  .gar-visibility-promise a { color: var(--pine); text-decoration: underline; }
  .gar-example h2 { font-family: 'DM Sans', sans-serif; font-size: 1.5rem; font-weight: 600; line-height: 1.3; margin: 0 0 .75rem; color: var(--pine-dark); }
  .gar-example h3 { font-family: 'DM Sans', sans-serif; font-size: 1.05rem; line-height: 1.4; margin: 0 0 .5rem; color: var(--pine-dark); }
  .gar-example p, .gar-example a { font-size: 1rem; line-height: 1.6; }
  .gar-example p { margin: .75rem 0; }
  .gar-example-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 1.25rem 0; }
  .gar-example-card { position: relative; display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--pine-tint); border-radius: 12px; background: var(--sand-light); }
  /* Non-interactive miniature views of the actual before/after examples. */
  .gar-example-miniature { position: relative; overflow: hidden; aspect-ratio: 4 / 5; max-height: 420px; border-radius: 11px 11px 0 0; background: var(--pine-mist); pointer-events: none; }
  .gar-example-miniature iframe { display: block; position: absolute; inset: 0; width: 300%; height: 300%; border: 0; transform: scale(calc(1 / 3)); transform-origin: top left; pointer-events: none; }
  .gar-example-caption { display: flex; flex-direction: column; flex: 1; padding: 16px 18px; border-top: 1px solid var(--pine-tint); }
  .gar-example .gar-example-scope, .gar-example .gar-example-browse, .gar-example-scope a, .gar-example-browse a { font-size: .875rem; }
  .gar-example .gar-example-browse { margin: 1rem 0 0; }
  .gar-example a { color: var(--pine); text-decoration: underline; }
  @media (max-width: 760px) { .gar-example-grid { grid-template-columns: 1fr; } }
  .aicv-access { border-top: 1px solid var(--pine-tint); margin-top: 1.1rem; padding-top: 1rem; overflow-wrap: anywhere; }
  .aicv-access h3 { font-size: 1rem; margin: 0 0 .5rem; }
  .aicv-access p, .aicv-access li, .aicv-scope { font-size: .8rem; line-height: 1.55; margin: .6rem 0; }
  .aicv-access ul { padding-left: 1.2rem; }
  .aicv-access summary { cursor: pointer; font-size: .8rem; padding: .5rem 0; }
  .aicv-eyebrow { font-size: 0.66rem; letter-spacing: 0.09em; color: #5C6B52; font-weight: 500; }
  .aicv-head {
    display: flex; justify-content: space-between; align-items: baseline;
    flex-wrap: wrap; gap: 0.5rem;
    border-bottom: 1px solid #DDE7CC; padding-bottom: 0.9rem;
  }
  .aicv-biz { font-size: 1.2rem; font-weight: 500; color: var(--pine-dark); margin-top: 3px; }
  .aicv-url { font-size: 0.75rem; color: #6B7A61; margin-top: 2px; }
  .aicv-reviewed { font-size: 0.68rem; color: #8A9880; margin-top: 4px; }
  .aicv-head-right { text-align: right; }
  .aicv-verdict {
    display: inline-block; background: var(--pine); color: var(--pine-mist);
    font-size: 0.8rem; font-weight: 500; padding: 5px 12px; border-radius: 6px; margin-top: 4px;
  }

  /* Ladder: rungs 1-3 are the diagnostic scale; rungs 4-5 are the dashed
     horizon (the Network) and are never active from a free read. */
  .aicv-ladder { padding: 1.2rem 0 0.4rem; }
  .aicv-ladder-track { display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .aicv-ladder-track::before { content: ''; position: absolute; top: 6px; left: 10%; right: 50%; border-top: 2px solid var(--pine-tint); }
  .aicv-ladder-track::after  { content: ''; position: absolute; top: 6px; left: 50%; right: 10%; border-top: 2px dashed var(--pine-tint); }
  .aicv-rung { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .aicv-rung-dot { width: 13px; height: 13px; border-radius: 50%; background: var(--pine-light); }
  .aicv-rung.is-horizon .aicv-rung-dot { background: var(--sand); border: 1.5px dashed var(--pine-light); }
  .aicv-rung.is-active .aicv-rung-dot { background: var(--pine); box-shadow: 0 0 0 3px var(--volt); }
  .aicv-rung-label { font-size: 0.66rem; color: var(--pine); line-height: 1.25; padding: 0 4px; }
  .aicv-rung.is-horizon .aicv-rung-label { color: #8A9880; }
  .aicv-rung.is-active .aicv-rung-label { font-weight: 700; color: var(--pine-dark); }
  .aicv-rung-here { font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--pine); background: var(--volt); padding: 1px 6px; border-radius: 4px; }
  .aicv-ladder-net { font-size: 0.66rem; color: #8A9880; text-align: right; margin-top: 6px; }

  .aicv-dims { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 1.1rem; }
  .aicv-dim { background: var(--cardbg); border: 1px solid var(--cardbd); border-radius: 10px; padding: 0.75rem 0.85rem; }
  .st-clear   { --cardbg:#F3F7EB; --cardbd:#DDE7CC; --pillbg:#D6E8CF; --pilltx:#2E5B3D; --notec:#5C6B52; }
  .st-partial { --cardbg:#FBF8EC; --cardbd:#EAE3C9; --pillbg:#EFE6C8; --pilltx:#84611A; --notec:#6B6350; }
  .st-missing { --cardbg:#FBF3EC; --cardbd:#EAD9C9; --pillbg:#F0D9C8; --pilltx:#8A3B1C; --notec:#6B5A4E; }
  .aicv-dim-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
  .aicv-dim-name { font-size: 0.75rem; font-weight: 500; color: var(--pine-dark); }
  .aicv-dim-state { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; color: var(--pilltx); background: var(--pillbg); padding: 2px 7px; border-radius: 5px; white-space: nowrap; }
  .aicv-dim-note { font-size: 0.75rem; color: var(--notec); line-height: 1.45; margin-top: 6px; }

  .aicv-fixes { margin-top: 1.2rem; }
  .aicv-fixes-cap { margin-bottom: 9px; }
  .aicv-fix-row { display: flex; gap: 10px; padding: 9px 0; border-top: 1px solid #E4EBD7; }
  .aicv-fix-row:last-child { border-bottom: 1px solid #E4EBD7; }
  .aicv-sev { flex: 0 0 auto; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; padding: 2px 8px; border-radius: 5px; height: fit-content; margin-top: 2px; }
  .aicv-sev-high { color: #8A3B1C; background: #F0D9C8; }
  .aicv-sev-med  { color: #84611A; background: #EFE6C8; }
  .aicv-sev-low  { color: #5C6B52; background: #EDF1E4; }
  .aicv-fix-txt { font-size: 0.79rem; color: #3D4A38; line-height: 1.5; }

  .aicv-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 1.1rem; }
  .aicv-foot-meta { font-size: 0.66rem; color: #8A9880; }
  .aicv-cta { background: var(--volt); color: var(--pine); font-size: 0.75rem; font-weight: 500; padding: 7px 14px; border-radius: 7px; text-decoration: none; }
  .aicv-cta:hover { background: #e8ff33; }

  /* Footer furniture — same handlers, restyled to the review card's language. */
  .aicv-actions { margin-top: 1.5rem; max-width: 720px; }
  .aicv-actions .btn {
    background: var(--sand);
    border: 1px solid var(--pine-tint);
    color: var(--pine);
    padding: 8px 14px;
    border-radius: 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.77rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .aicv-actions .btn:hover { border-color: var(--pine); }
  .aicv-actions .btn-primary { background: var(--pine); border-color: var(--pine); color: var(--pine-mist); }
  .aicv-actions .btn-primary:hover { background: var(--pine-dark); }
  .aicv-actions .copy-row { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }

  .aio-err {
    display: none; margin-top: 1rem;
    padding: 0.875rem 1.1rem;
    background: rgba(248,113,113,0.06);
    border-left: 2px solid var(--danger);
    font-size: 0.8rem; color: rgba(232,226,208,0.6);
  }
  .aio-err.on { display: block; }

  .aio-post-results {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    background: rgba(27,67,50,0.05);
    border-left: 3px solid var(--pine);
    font-size: 0.95rem;
    color: var(--pine-dark);
    font-weight: 400;
    line-height: 1.6;
    font-style: italic;
  }

  /* ─── SECTION 3 — WHY THIS MATTERS NOW ─── */
  .gar-bridge-wrap { background: var(--sand-light); }
  .gar-bridge {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    color: var(--pine);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.75rem;
  }

  .gar-body {
    font-size: 1rem;
    color: var(--pine-dark);
    font-weight: 300;
    line-height: 1.85;
    max-width: 72ch;
    margin-bottom: 1.1rem;
  }
  .gar-body strong { color: var(--pine); font-weight: 600; }
  .gar-body em { font-style: italic; color: var(--pine); }
  .gar-body a { color: var(--pine); text-decoration: underline; text-decoration-color: rgba(27,67,50,0.3); }
  .gar-body a:hover { text-decoration-color: var(--pine); }

  .gar-pullquote {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    color: var(--pine);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.015em;
    border-left: 3px solid var(--volt);
    padding: 0.5rem 0 0.5rem 1.75rem;
    margin: 2.5rem 0 0;
    max-width: 64ch;
  }

  /* Light bullet list */
  .gar-light-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .gar-light-list li {
    font-size: 0.92rem;
    color: var(--pine-dark);
    font-weight: 300;
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }
  .gar-light-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--pine);
    font-size: 1.1rem;
    line-height: 1.4;
    font-weight: 700;
  }

  /* ─── SECTION 4 — WHY NETWORKS WIN ─── */
  .gar-substrate-wrap { background: var(--pine); }
  .gar-substrate {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-dark-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--volt);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .gar-h2-dark {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    color: var(--sand);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.75rem;
  }

  .gar-body-dark {
    font-size: 1rem;
    color: rgba(232,226,208,0.85);
    font-weight: 300;
    line-height: 1.85;
    max-width: 72ch;
    margin-bottom: 1.1rem;
  }
  .gar-body-dark strong { color: var(--sand); font-weight: 600; }
  .gar-body-dark em { font-style: italic; color: var(--volt); }

  /* Dark bullet list */
  .gar-dark-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .gar-dark-list li {
    font-size: 0.92rem;
    color: rgba(232,226,208,0.8);
    font-weight: 300;
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }
  .gar-dark-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--volt);
    font-size: 1.1rem;
    line-height: 1.4;
    font-weight: 700;
  }

  /* Network statements — two-column split quotes */
  .gar-network-statements {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }
  .gar-network-stmt {
    padding: 1.5rem 1.75rem;
    background: rgba(216,255,0,0.04);
    border: 1px solid rgba(216,255,0,0.12);
  }
  .gar-network-stmt-text {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 600;
    color: var(--sand);
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  /* ─── SECTION 5 — CHOOSE YOUR FUTURE (TIERS) ─── */
  .gar-tiers-wrap {
    background: var(--sand);
    scroll-margin-top: 100px;
  }
  .gar-tiers {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-section-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pine-light);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .gar-tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: stretch;
  }

  .gar-tier-card {
    background: var(--sand-light);
    border: 1px solid rgba(27,67,50,0.15);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .gar-tier-card.tier-reviewed {
    background: var(--pine);
    border: 2px solid var(--volt);
  }

  .gar-tier-label {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--pine);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }
  .gar-tier-label.tier-flagship { color: var(--volt); }

  .gar-tier-hook {
    font-size: 0.92rem;
    color: var(--pine-light);
    font-weight: 300;
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }
  .tier-reviewed .gar-tier-hook { color: rgba(232,226,208,0.75); }

  .gar-tier-includes {
    font-family: 'Syne', sans-serif;
    font-size: 0.8rem;
    color: var(--volt);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
  }

  .gar-tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .gar-tier-list li {
    font-size: 0.86rem;
    color: var(--pine-dark);
    font-weight: 400;
    line-height: 1.55;
    padding-left: 1.1rem;
    position: relative;
  }
  .gar-tier-list li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.58rem;
    width: 5px; height: 5px;
    background: var(--pine);
    border-radius: 50%;
    opacity: 0.6;
  }
  .gar-tier-list li em { font-style: italic; }
  .gar-tier-list li code {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    background: rgba(27,67,50,0.08);
    padding: 0.05rem 0.35rem;
    border-radius: 2px;
  }

  .tier-reviewed .gar-tier-list li { color: rgba(232,226,208,0.8); }
  .tier-reviewed .gar-tier-list li::before { background: var(--volt); opacity: 0.8; }
  .tier-reviewed .gar-tier-list li code {
    background: rgba(216,255,0,0.1);
    color: var(--volt);
  }

  .gar-tier-price {
    margin-top: auto;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(27,67,50,0.15);
  }

  .gar-price-block {
    padding: 1rem 0;
    border-top: 1px solid rgba(216,255,0,0.15);
  }
  .gar-price-block.founding { border-top: 1px solid rgba(216,255,0,0.3); }

  .gar-price-header {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(232,226,208,0.55);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .gar-price-line {
    font-size: 1rem;
    color: var(--pine);
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }
  .gar-price-line strong { font-weight: 700; }
  .tier-reviewed .gar-price-line { color: var(--sand); }
  .tier-reviewed .gar-price-line strong { color: var(--volt); }

  .gar-price-note {
    font-size: 0.8rem;
    color: rgba(27,67,50,0.55);
