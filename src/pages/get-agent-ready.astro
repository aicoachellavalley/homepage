---
import Base from '../layouts/Base.astro';
import nodesData from '../../public/nodes.json';
import briefsData from '../../public/briefs.json';

const nodeCount = nodesData.length;
const briefCount = briefsData.length;

const pageTitle = 'Get Agent Ready — AICV Network Membership';
const pageDescription = "AICV is building the canonical intelligence layer for the Coachella Valley — structured for LLMs, agents, and the agentic internet. Join the network that AI systems query when they're asked about this region.";
const canonicalUrl = 'https://aicoachellavalley.com/get-agent-ready/';

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#webpage",
      "url": "https://aicoachellavalley.com/get-agent-ready/",
      "name": "Get Agent Ready — AICV Network Membership",
      "description": "AICV is building the canonical intelligence layer for the Coachella Valley — structured for LLMs, agents, and the agentic internet. Join the network that AI systems query when they're asked about this region.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": "2026-04-23",
      "dateModified": "2026-05-07"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aicoachellavalley.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Get Agent Ready",
          "item": "https://aicoachellavalley.com/get-agent-ready/"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-ready",
      "name": "AICV Ready",
      "description": "Annual membership in the AICV Network for valley businesses that need to be legible to the agent layer. Includes combined AIO + Cloudflare agent-readiness diagnostic, canonical node built to Tier 4 infrastructure standard, MCP routing configuration, and agent-to-agent concierge access.",
      "provider": { "@id": "https://aicoachellavalley.com/#organization" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "AICV Ready — Deployment Fee",
          "price": "1000.00",
          "priceCurrency": "USD",
          "description": "One-time Deployment Fee covering diagnostic, node build, and MCP integration.",
          "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "AICV Ready — Annual Membership",
          "price": "2500.00",
          "priceCurrency": "USD",
          "description": "Annual membership fee for ongoing Network access.",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "2500.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-reviewed",
      "name": "AICV Reviewed",
      "description": "Annual membership with full Intelligence Review for entities positioning to high-net-worth buyers, relocation prospects, corporate retreat decision-makers, or civic partners. Includes everything in AICV Ready plus full Intelligence Council deliberation, 12-month AI readiness roadmap, public living portal, and templatized MCP access.",
      "provider": { "@id": "https://aicoachellavalley.com/#organization" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Founding Deployment Fee",
          "price": "2500.00",
          "priceCurrency": "USD",
          "description": "One-time Deployment Fee for founding members (first 10 only, pricing locked for life). Covers diagnostic, node build, MCP integration, Intelligence Review, and portal build.",
          "availability": "https://schema.org/LimitedAvailability",
          "eligibleQuantity": {
            "@type": "QuantitativeValue",
            "maxValue": 10,
            "unitText": "founding members"
          }
        },
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Founding Annual Membership",
          "price": "5000.00",
          "priceCurrency": "USD",
          "description": "Annual membership for founding members, locked for life.",
          "availability": "https://schema.org/LimitedAvailability",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "5000.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        },
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Standard Deployment Fee",
          "price": "5000.00",
          "priceCurrency": "USD",
          "description": "Standard Deployment Fee for members 11 onward.",
          "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Standard Annual Membership",
          "price": "7500.00",
          "priceCurrency": "USD",
          "description": "Annual membership for standard members.",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "7500.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "We already pay for SEO. Why do we need this?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Different budget, different layer. SEO optimizes for human eyes on Google search results pages — someone typing a query, clicking a blue link, landing on your site. That work still matters and it isn't what AICV does. AICV operates in the layer agents read when they answer a user's question directly, without surfacing a results page at all. When someone asks Claude or ChatGPT where to hold a corporate retreat in the Coachella Valley, your SEO ranking on Google is irrelevant to that answer. Your presence in the regional substrate agents query is what decides whether you're in the answer. Both budgets are legitimate. They serve different interfaces."
          }
        },
        {
          "@type": "Question",
          "name": "Why is there a Deployment Fee separate from annual membership?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Deployment Fee covers the work done once — the diagnostic, the node build, the MCP configuration, the Review (Tier 2), and the portal build. Annual membership keeps everything running. Pricing both honestly is cleaner than bundling setup cost into year-one dues and making year two feel overpriced."
          }
        },
        {
          "@type": "Question",
          "name": "Does AICV touch our website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. That's the point. AICV represents members at Tier 4 agent-readiness in parallel to their own sites — members don't modify their websites, change their CMS, or install anything. The work happens entirely in the substrate AICV operates."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if we stop paying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your canonical node stays published at the Free AICV Listed tier — you remain discoverable. Agent-layer access (concierge, economic-development platform, templatized MCP tools) turns off. Your Intelligence Review portal (Tier 2) goes private. Rejoining is straightforward; existing node data isn't lost."
          }
        },
        {
          "@type": "Question",
          "name": "Who qualifies for membership?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any valley business, institution, property, or civic entity whose presence strengthens the Network's collective signal. AICV reserves editorial judgment on fit — the Network is a curated signal, not a directory."
          }
        },
        {
          "@type": "Question",
          "name": "Can we see an example of the Intelligence Review?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Visit Greater Palm Springs Snapshot at aicoachellavalley.com/snapshots/visit-greater-palm-springs is the public entry point of the same framework. The full Review deepens the three-dimension assessment, adds the 12-month roadmap, and lives as a portal that updates quarterly."
          }
        },
        {
          "@type": "Question",
          "name": "Is AICV a nonprofit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AICV is a fiscally sponsored project of the Desert Community Foundation, a 501(c)(3) operating in Riverside County, California. Membership fees fund the continued build-out of the regional intelligence layer."
          }
        },
        {
          "@type": "Question",
          "name": "What's the founding-member cap actually protecting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two things. A bounded cohort whose pricing stays locked for life — a genuine reward for early commitment. And AICV's own delivery capacity: the first ten Tier 2 members are deployed and supported personally by Sat. Standard pricing begins at member eleven, by which point Network density, delivery tooling, and positioning have all matured."
          }
        },
        {
          "@type": "Question",
          "name": "What ships this summer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Three things, together: the public Ask AICV chat interface, the Network map at aicoachellavalley.com/network, and member-scoped query access for deployed members. Members who deploy before summer see themselves appear in all three as they ship."
          }
        },
        {
          "@type": "Question",
          "name": "My business handles bookings or transactions. Will AICV support agent-mediated payments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AICV is tracking emerging agent-payment protocols, including Coinbase's x402 and the Agentic Commerce Protocol (ACP). For Reviewed members in transaction-driven categories — hospitality, dining, wellness, retail — AICV plans to deploy agent-payable MCP endpoints as the standards stabilize and member needs are scoped. This is part of the infrastructure differentiation between AICV Ready and Reviewed: Reviewed members participate in capability planning and receive priority deployment of new agentic commerce surfaces."
          }
        }
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://aicoachellavalley.com/#organization",
      "name": "AI Coachella Valley",
      "alternateName": "AICV",
      "url": "https://aicoachellavalley.com/",
      "logo": "https://aicoachellavalley.com/logo.png",
      "description": "AICV is the agent-readable, LLM-favored regional intelligence layer for the Coachella Valley. We provide structured, citation-grade data that AI systems use to evaluate, cite, and act on information about the region.",
      "foundingDate": "2025-01-19",
      "founder": {
        "@type": "Person",
        "name": "Sat Singh",
        "jobTitle": "Founder"
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Desert Community Foundation",
        "description": "Fiscal sponsor"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "sat@aicv.co",
        "contactType": "general inquiries",
        "areaServed": "Coachella Valley, California",
        "availableLanguage": "English"
      },
      "sameAs": [
        "https://x.com/CoachellaAI",
        "https://github.com/aicoachellavalley",
        "https://sunshinefm.beehiiv.com"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://aicoachellavalley.com/#localbusiness",
      "name": "AI Coachella Valley",
      "parentOrganization": { "@id": "https://aicoachellavalley.com/#organization" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "37023 Cook Street",
        "addressLocality": "Palm Desert",
        "addressRegion": "CA",
        "postalCode": "92211",
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "email": "sat@aicv.co",
      "url": "https://aicoachellavalley.com/"
    }
  ]
};
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={schemaGraph}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Layer · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Layer</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
      <a href="https://sunshine.fm">SunshineFM</a>
    </div>
    <a href="#diagnostic" class="nav-aio-btn">Free AIO Tool ↓</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<!-- ============================================
     V2 GET AGENT READY — six-section qualification surface
     Replaces V7.7 eight-section education surface
     ============================================ -->

<!-- HERO -->
<section class="gar-v2-hero">
  <svg class="gar-v2-fig" width="120" height="120" viewBox="0 0 120 120" aria-hidden="true">
    <g stroke="var(--pine-dark)" stroke-width="0.8" fill="none">
      <circle cx="60" cy="60" r="6"/>
      <circle cx="60" cy="60" r="14"/>
      <line x1="60" y1="40" x2="60" y2="80"/>
      <line x1="40" y1="60" x2="80" y2="60"/>
      <rect x="20" y="20" width="80" height="80" stroke-dasharray="2 2"/>
      <text x="100" y="14" font-family="Syne, sans-serif" font-size="8" fill="var(--pine-dark)" font-weight="600">FIG.01</text>
    </g>
  </svg>
  <div class="gar-v2-inner">
    <div class="gar-v2-eyebrow">THE AGENTIC INTERNET IS HERE</div>
    <h1 class="gar-v2-h1">Get Agent Ready.</h1>
    <p class="gar-v2-hero-sub">AICV is the Coachella Valley's intelligence layer for the agentic internet.</p>
    <a href="https://calendar.app.google/AHgC8z8rGoYZ1Eju5" target="_blank" rel="noopener noreferrer" class="gar-v2-cta-primary">Join the Network →</a>
    <div class="gar-v2-proof-strip">
      <div class="gar-v2-proof-line">
        <div class="gar-v2-proof-stats">80+ NODES · 141+ BRIEFS · ESTABLISHED 2025</div>
        <a href="/nodes/node-zero" class="gar-v2-proof-btn">PROOF OF WORK →</a>
      </div>
      <div class="gar-v2-proof-visibility">Visible in Claude, ChatGPT, Perplexity &amp; Gemini</div>
    </div>
  </div>
</section>

<!-- DIAGNOSTIC -->
<section class="gar-v2-diagnostic" id="diagnostic">
  <svg class="gar-v2-fig-tall" width="80" height="180" viewBox="0 0 80 180" aria-hidden="true">
    <g stroke="var(--pine-dark)" stroke-width="0.6" fill="none">
      <line x1="40" y1="10" x2="40" y2="170"/>
      <line x1="30" y1="10" x2="50" y2="10"/>
      <line x1="30" y1="170" x2="50" y2="170"/>
      <line x1="35" y1="40" x2="45" y2="40"/>
      <line x1="35" y1="70" x2="45" y2="70"/>
      <line x1="35" y1="100" x2="45" y2="100"/>
      <line x1="35" y1="130" x2="45" y2="130"/>
      <text x="55" y="92" font-family="Syne, sans-serif" font-size="7" fill="var(--pine-dark)" font-weight="600">SCAN</text>
    </g>
  </svg>
  <div class="gar-v2-inner">
    <div class="gar-v2-eyebrow">FREE TOOL</div>
    <h2 class="gar-v2-diagnostic-h"><span class="diag-pine">Can AI see</span><br><span class="diag-volt">your business?</span></h2>
    <p class="gar-v2-body">See how Claude, ChatGPT, Perplexity, or Gemini read—or miss—your business right now. Plain English.</p>
    
    <div class="aio-card">
    <label class="aio-input-label" for="urlInput">Enter your website and receive a plain-English diagnostic of how AI systems read your business:</label>
    <div class="aio-row">
      <input type="url" id="urlInput" class="aio-input" placeholder="yourrestaurant.com or https://yourbusiness.com" autocomplete="off" autocapitalize="off">
      <button class="aio-submit" id="analyzeBtn" onclick="runAnalysis()">Analyze →</button>
    </div>
    <div class="aio-callout">
      <div class="aio-callout-item">FREE</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">NO SIGNUP</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">NO DATA STORED</div>
    </div>
    <div class="aio-err" id="aioErr"></div>
    <div class="aio-loading" id="aioLoading">
      <div class="spin"></div>
      <div class="loading-txt">Analyzing your site the way AI systems would…</div>
      <div class="loading-step" id="loadingStep">Checking crawler access…</div>
    </div>
    <div class="aio-results" id="aioResults">
      <div class="result-top">
        <div class="score-block">
          <div class="score-grade" id="scoreGrade">—</div>
          <div class="score-num" id="scoreNum">—</div>
          <div class="score-bar-wrap">
            <div class="score-bar-track">
              <div class="score-bar-fill" id="scoreBarFill"></div>
              <div class="score-bar-marker" id="scoreBarMarker"></div>
            </div>
            <div class="score-bar-labels"><span>0</span><span>100</span></div>
          </div>
          <div class="score-tag">AIO Visibility Grade</div>
        </div>
        <div class="verdict" id="verdictText"></div>
      </div>
      <div class="result-checks" id="resultChecks"></div>
      <div id="fixesWrap"></div>
      <button class="aio-reset" onclick="resetTool()">← Analyze another site</button>
      <div class="copy-btns">
        <button class="aio-copy" onclick="copyReport('md')">Copy Markdown</button>
        <button class="aio-copy" onclick="copyReport('json')">Copy JSON</button>
        <button class="aio-copy" onclick="copyReport('text')">Copy Text</button>
      </div>
      <div class="aio-post-results">A diagnostic tells you what AI sees. It doesn't change what AI reads. That's what the Network does. Keep scrolling.</div>
    </div>
  </div>
  </div>
</section>

<!-- WHY NETWORKS WIN -->
<section class="gar-v2-networks">
  <svg class="gar-v2-fig-network" width="140" height="140" viewBox="0 0 140 140" aria-hidden="true">
    <g stroke="var(--pine-dark)" stroke-width="0.8" fill="none">
      <circle cx="70" cy="70" r="8" fill="var(--pine-dark)" fill-opacity="0.18"/>
      <circle cx="20" cy="30" r="4"/>
      <circle cx="120" cy="25" r="4"/>
      <circle cx="115" cy="100" r="4"/>
      <circle cx="30" cy="115" r="4"/>
      <circle cx="125" cy="65" r="4"/>
      <line x1="20" y1="30" x2="70" y2="70"/>
      <line x1="120" y1="25" x2="70" y2="70"/>
      <line x1="115" y1="100" x2="70" y2="70"/>
      <line x1="30" y1="115" x2="70" y2="70"/>
      <line x1="125" y1="65" x2="70" y2="70"/>
      <text x="68" y="135" font-family="Syne, sans-serif" font-size="7" fill="var(--pine-dark)" font-weight="600" text-anchor="middle">FIG.02 CLUSTER</text>
    </g>
  </svg>
  <div class="gar-v2-inner">
    <div class="gar-v2-eyebrow">WHY NETWORKS WIN</div>
    <h2 class="gar-v2-networks-h">A business optimizing alone is almost invisible. A business inside the AICV network is signal.</h2>
    <p class="gar-v2-body">Agents don't reward scattered noise. They reach for trusted regional context. A cluster.</p>
  </div>
</section>

<!-- TIERS -->
<section class="gar-v2-tiers" id="tiers">
  <div class="gar-v2-inner">
  <div class="gar-v2-eyebrow">CHOOSE YOUR FUTURE</div>
  <h2 class="gar-v2-tiers-h">Two Agentic Pathways</h2>
  
  <div class="gar-v2-booking-strip">
    <div class="gar-v2-booking-text">
      <div class="gar-v2-booking-title">Not sure where you fit?</div>
      <div class="gar-v2-booking-sub">Book a call. Let's figure it out.</div>
    </div>
    <a href="https://calendar.app.google/AHgC8z8rGoYZ1Eju5" target="_blank" rel="noopener noreferrer" class="gar-v2-booking-btn">Book →</a>
  </div>
  
  <div class="gar-v2-tier-grid">
    <!-- TIER 1: AICV Ready -->
    <div class="gar-v2-tier-card gar-v2-tier-ready">
      <div class="gar-v2-tier-badge-spacer"></div>
      <div class="gar-v2-tier-body">
        <div class="gar-v2-tier-eyebrow">GET FOUND</div>
        <div class="gar-v2-tier-name">AICV Ready</div>
        <p class="gar-v2-tier-desc">Become easier for AI systems to understand, trust, and surface.</p>
        <p class="gar-v2-tier-includes">Includes onboarding, profile deployment, and first-step readiness roadmap.</p>
      </div>
      <div class="gar-v2-tier-divider"><div class="gar-v2-tier-deploy">$1,000 Deployment</div></div>
      <div class="gar-v2-tier-price">$2,500 / year</div>
      <div class="gar-v2-tier-scarcity-spacer"></div>
      <a href="https://calendar.app.google/AHgC8z8rGoYZ1Eju5" target="_blank" rel="noopener noreferrer" class="gar-v2-tier-cta">Deploy Today →</a>
    </div>
    
    <!-- TIER 2: AICV Reviewed -->
    <div class="gar-v2-tier-card gar-v2-tier-reviewed">
      <div class="gar-v2-tier-founding-badge">FOUNDING</div>
      <div class="gar-v2-tier-badge-spacer"></div>
      <div class="gar-v2-tier-body">
        <div class="gar-v2-tier-eyebrow">GO PREMIUM</div>
        <div class="gar-v2-tier-name">AICV Reviewed</div>
        <p class="gar-v2-tier-desc">For standout entities ready for deeper intelligence review.</p>
        <p class="gar-v2-tier-includes">Includes intelligence review, premium routing readiness, and advanced positioning.</p>
      </div>
      <div class="gar-v2-tier-divider"><div class="gar-v2-tier-deploy">$2,500 Deployment</div></div>
      <div class="gar-v2-tier-price">$5,000 / year</div>
      <div class="gar-v2-tier-scarcity">10 of 10 founding spots remaining</div>
      <a href="https://calendar.app.google/AHgC8z8rGoYZ1Eju5" target="_blank" rel="noopener noreferrer" class="gar-v2-tier-cta">Apply / Deploy Today →</a>
    </div>
  </div>
  </div>
</section>

<!-- ABOUT -->
<section class="gar-v2-about">
  <svg class="gar-v2-fig-small" width="60" height="60" viewBox="0 0 60 60" aria-hidden="true">
    <g stroke="var(--pine-dark)" stroke-width="0.6" fill="none">
      <circle cx="30" cy="30" r="20"/>
      <circle cx="30" cy="30" r="3" fill="var(--pine-dark)" fill-opacity="0.4"/>
      <line x1="10" y1="30" x2="50" y2="30" stroke-dasharray="2 2"/>
      <line x1="30" y1="10" x2="30" y2="50" stroke-dasharray="2 2"/>
    </g>
  </svg>
  <div class="gar-v2-inner">
    <div class="gar-v2-eyebrow">ABOUT</div>
    <p class="gar-v2-about-h">AICV is a human-guided, agent-readable intelligence layer for the Coachella Valley.</p>
    <p class="gar-v2-about-body">Built through a cluster of regional nodes, intelligence briefs, structured endpoints, and editorial review.</p>
    <p class="gar-v2-about-italic">What agents seek. Where the agentic internet is heading.</p>
  </div>
</section>

<!-- FINAL CLOSE -->
