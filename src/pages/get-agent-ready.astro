---
import Footer from '../components/Footer.astro';
import pricing from '../data/pricing.json';
import pageDates from '../data/page-dates.json';
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { latestDate, latestResearchDate } from '../../scripts/research-dates.mjs';

// Read authored content at build time (also updates in local Astro dev). No
// browser request or clock-based freshness badge; a rebuild alone changes nothing.
const [briefs, nodes, reports, records] = await Promise.all([
  getCollection('briefs'), getCollection('nodes'), getCollection('reports'), getCollection('records'),
]);
const researchDate = latestResearchDate({ briefs, nodes, reports, records });
const pageModified = latestDate([pageDates['/get-agent-ready/'], researchDate]);

/* HERO STRIP REDUCED 2026-08-19 to "Established 2025". It was
 * "{nodeCount} nodes · {briefCount} briefs · est. 2025 · Proof of work →".
 *
 * The two counts went for three reasons: they are a second place to maintain,
 * the homepage stat bar already carries them, and as prose inside a <span> they
 * prove nothing to an agent — the machine-readable claim is nodes.json and
 * briefs.json, which is where a consumer actually reads them.
 *
 * nodes.json and briefs.json were imported for those counts and NOTHING else on
 * this page — neither feeds its JSON-LD — so both imports and both consts went
 * with them. The "Proof of work" link to /nodes/node-zero went too: that page is
 * reached from ~40 other routes, including this page's own nav, so nothing is
 * orphaned. Checked before removal.
 *
 * Kept in frontmatter, not as an HTML comment: this rationale is for whoever
 * edits the page, and an HTML comment would ship seven lines of it to every
 * reader of the served document. */

const pageTitle = 'AI Agents in the Coachella Valley — Get Agent Ready | AICV';
const pageDescription = "Help AI agents and assistants understand your Coachella Valley business. Start with a free website check, then get your MVA business profile and private review.";
const canonicalUrl = 'https://aicoachellavalley.com/get-agent-ready/';
// Human-facing details and machine-readable Service descriptions share the
// same text. Short card copy comes from pricing.json, alongside the prices.
const previewDescription = 'A free check of what an AI agent can read on one public web page. No signup, nothing stored, and no changes to your website. It does not build or activate an MVA.';
const readyDescription = 'Your Minimum Viable Agent (MVA): a public, agent-readable business profile on the AICV network, plus a private review of what to improve. We confirm which business your purchase is for before publishing. Pay once, with no annual fee or separate setup fee.';
const businessDescription = 'Your MVA with ongoing care for its discovery tools. Includes maintained discovery infrastructure, MCP routing (a way for agents to find and use your information) and agent-to-agent concierge access. For Cloudflare sites, onboarding includes an owner-assisted Search, Agent and Training (SAT) review. You or your site manager confirm the settings; configuration changes are separately agreed.';
const premiumDescription = 'Everything in Business, plus a deeper Agentic Review by the AICV LLM Council and a 12-month AI-readiness action plan. Includes a public living portal and templated MCP access for agents. Designed for businesses and organizations reaching high-net-worth buyers, people relocating, retreat planners or civic partners.';
// A planned direction, not a Service entitlement. Keep the FAQ and both paid
// membership detail panels in sync; do not imply a tested merchant integration.
const commerceRoadmap = "We want customers to be able to ask their AI assistant to book with you or buy from you. That's a planned next step for Business and Premium, not included today. We'll test what works with your existing systems and agree the work and cost with you before offering it. Premium has priority for integration planning.";

/* FAQ — ONE ARRAY, TWO SURFACES (2026-09-14). Rendered as the visible
 * "Questions" section AND as the FAQPage mainEntity in the JSON-LD graph, from
 * this array alone, so the copy an agent reads in structured data and the copy
 * a person reads on the page cannot drift (same pattern as the records
 * collection's `faq` field). Until today the FAQ existed only in JSON-LD —
 * agent-only since V2 (624f71d, 2026-05-07) — and a re-query of AI Search on
 * 2026-09-14 showed the consequence: the instance indexes rendered visible text,
 * so not one FAQ answer was in the corpus. Keep answers plain text: no markup,
 * no straight double quotes (they are emitted verbatim into JSON-LD). */
const faq = [
  {
    q: "We already pay for SEO. Why do we need this?",
    a: "SEO helps people find your website. AICV helps AI agents and assistants understand your business when people ask for help choosing, comparing or planning. Your MVA adds clear business facts and local context. It complements SEO; it does not guarantee a recommendation, ranking or sale.",
  },
  {
    q: "What do you mean by guaranteed visibility?",
    a: "We guarantee visibility to agents on the AICV network: once your purchase is matched to your business, your MVA is public and readable by agents. Your original website stays unchanged. See What visibility means for the full scope.",
  },
  {
    q: "What changes when I activate a preview?",
    a: "It's the same business page, activated as your MVA with facts you supply and your private review of what to improve. Some previews are already public and readable by agents. Your MVA helps people and assistants understand your business and follow your contact or booking links. Your website stays as it is.",
  },
  {
    q: "What do the setup and annual fees cover?",
    a: "Setup covers the initial assessment, profile and service configuration. Annual fees keep your membership services running. Business and Premium start with a call to agree the work before billing. The $500 MVA is a one-time purchase with no separate setup fee or annual fee.",
  },
  {
    q: "Does AICV touch our website?",
    a: "No rebuild or plugin. Your MVA lives on AICV and links to your website. For Cloudflare sites, Business and Premium include an access review with you or your site manager. Any changes need a separately agreed scope. Private areas stay private.",
  },
  {
    q: "What happens if we stop paying?",
    a: "Your profile stays published. Annual services, including concierge access and agent tools, stop, and your Agentic Review portal goes private. Your profile data is kept if you return. The $500 MVA has no annual fee.",
  },
  {
    q: "Who qualifies for membership?",
    a: "Coachella Valley businesses, institutions, properties and civic organizations. We review fit with the regional network; payment alone does not guarantee inclusion.",
  },
  {
    q: "What does the $500 MVA look like?",
    a: "The examples above show your MVA before and after activation. Your private review is for you alone, not a public sample. Premium adds a deeper LLM Council review and action plan.",
  },
  {
    q: "Who owns AICV?",
    a: "AICV is a product and service of SunshineFM LLC, a California limited liability company. AICV operates from Palm Desert and is led by founder Sat Singh.",
  },
  {
    q: "Can Cloudflare or our website's security block AI agents?",
    a: "Yes. A site can work for people but block agents. Our free check cannot verify private Cloudflare settings. Business and Premium include an owner-assisted SAT review — Search, Agent and Training — for Cloudflare sites; changes are separately scoped. Training is a separate owner choice, not a visibility requirement. The $500 profile purchase does not include a Cloudflare account audit.",
  },
  {
    q: "Can customers book and pay through AI?",
    a: "Yes, where their assistant works with your booking or checkout system. Your MVA can point it to your official booking or ordering page; it doesn't manage availability, confirm appointments or take payments itself. Purchases still need the customer's approval. You don't need AICV membership for an assistant to use a compatible checkout.",
  },
  {
    q: "Which AI assistants is AICV built for?",
    a: "AICV helps your business become easier to understand for ChatGPT, Claude from Anthropic, Google Gemini, Grok, Muse and Perplexity. The list keeps growing.",
  },
  {
    q: "What's next for Business and Premium?",
    a: commerceRoadmap,
  },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#webpage",
      "url": "https://aicoachellavalley.com/get-agent-ready/",
      "name": "AI Agents in the Coachella Valley — Get Agent Ready | AICV",
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": "2026-04-23",
      "dateModified": pageModified
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aicoachellavalley.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Get Agent Ready",
          "item": "https://aicoachellavalley.com/get-agent-ready/"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-preview",
      "name": "Agent Preview",
      "description": previewDescription,
      "provider": { "@id": "https://aicoachellavalley.com/#organization" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "Agent Preview",
          "price": "0.00",
          "priceCurrency": "USD",
          "description": "Free website check. No signup, no cost, nothing stored.",
          "availability": "https://schema.org/InStock"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-agent-ready",
      "name": "Agent Ready",
      "description": readyDescription,
      "provider": { "@id": "https://aicoachellavalley.com/#organization" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
