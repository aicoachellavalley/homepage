        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-ready",
      "name": "Agent Ready Business",
      "description": businessDescription,
      "provider": { "@id": "https://aicoachellavalley.com/#organization" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "Agent Ready Business — Deployment Fee",
          "price": "1000.00",
          "priceCurrency": "USD",
          "description": "One-time Deployment Fee covering diagnostic, MVA build, and MCP integration.",
          "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "Agent Ready Business — Annual Membership",
          "price": "2500.00",
          "priceCurrency": "USD",
          "description": "Annual membership fee for ongoing Network access.",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "2500.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-reviewed",
      "name": "Agent Ready Premium",
      "description": premiumDescription,
      "provider": { "@id": "https://aicoachellavalley.com/#organization" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "Agent Ready Premium — Deployment Fee",
          "price": "5000.00",
          "priceCurrency": "USD",
          "description": "One-time Deployment Fee covering diagnostic, MVA build, MCP integration, Agentic Review, and portal build.",
          "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "Agent Ready Premium — Annual Membership",
          "price": "10000.00",
          "priceCurrency": "USD",
          "description": "Annual membership fee for ongoing Network access, monitoring, and LLM Council editorial reviews.",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "10000.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#faq",
      "mainEntity": faq.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a },
      }))
    },
    {
      /* CANONICAL LEGAL ENTITY — described ONCE, referenced by @id everywhere.
       * AICV is a BRAND, not a legal entity: it owns nothing and is nothing in
       * law. aicoachellavalley.com is a commercial sub-brand of SunshineFM LLC.
       * The fiscal sponsorship belongs to the .org project only and must never
       * be asserted on this domain. legalName sits HERE, on the entity that has
       * one — putting it on the AICV node would assert AICV *is* the LLC. */
      "@type": "Organization",
      "@id": "https://aicoachellavalley.com/#llc",
      "name": "SunshineFM LLC",
      "legalName": "SunshineFM LLC"
    },
    {
      "@type": "Organization",
      "@id": "https://aicoachellavalley.com/#organization",
      "name": "AI Coachella Valley",
      "alternateName": "AICV",
      "url": "https://aicoachellavalley.com/",
      "logo": "https://aicoachellavalley.com/logo.png",
      "description": "AICV is the Coachella Valley's intelligence network for the agentic internet. We publish structured business profiles and local research that people, AI agents and assistants can read and use.",
      "foundingDate": "2025-01-19",
      "founder": {
        "@type": "Person",
        "name": "Sat Singh",
        "jobTitle": "Founder"
      },
      "parentOrganization": { "@id": "https://aicoachellavalley.com/#llc" },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "sat@aicv.co",
        "contactType": "general inquiries",
        "areaServed": "Coachella Valley, California",
        "availableLanguage": "English"
      },
      "sameAs": [
        "https://x.com/CoachellaAI",
        "https://github.com/aicoachellavalley",
        "https://sunshinefm.beehiiv.com"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://aicoachellavalley.com/#localbusiness",
      "name": "AI Coachella Valley",
      "parentOrganization": { "@id": "https://aicoachellavalley.com/#organization" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "37023 Cook Street",
        "addressLocality": "Palm Desert",
        "addressRegion": "CA",
        "postalCode": "92211",
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "image": "https://aicoachellavalley.com/logo.png",
      "priceRange": "$0 - $15,000+",
      "email": "sat@aicv.co",
      "url": "https://aicoachellavalley.com/"
    }
  ]
};
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={schemaGraph}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Network</a>
      <a href="/minimum-viable-agent/">MVAs</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
    </div>
    <a href="#diagnostic" class="nav-aio-btn">Agent Preview ↓</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<!-- ============================================
     V2 GET AGENT READY — six-section qualification surface
     Replaces V7.7 eight-section education surface
     ============================================ -->

<!-- ABOVE THE FOLD: hero (left) + diagnostic tool (right) -->
<section class="gr-fold">
  <div class="gr-wrap gr-fold-grid">
    <div class="gr-hero">
      <div class="gr-eyebrow">The agentic internet is here</div>
      <h1 class="gr-h1">Get agent ready.</h1>
      <p class="gr-sub">A clear place for your business on the agentic internet.</p>
      <p class="gr-lead">We turn your business information into a profile AI agents and assistants can read and people can use. It's your Minimum Viable Agent (MVA), on the Coachella Valley's AICV network. No website rebuild.</p>
      <div class="gr-stats">
        <span class="gr-stat">Established 2025</span>
      </div>
    </div>
    <div class="gr-tool" id="diagnostic">
      <div class="gr-tool-label">Free tool</div>
      <h2 class="gr-tool-h">Can AI see your business?</h2>
      <p class="gr-tool-sub">Find out what AI can read on your website and what it may miss. Private account settings need an owner review. <a href="#agent-access">What we check</a>.</p>
    
    <div class="aio-card">
    <label class="aio-input-label gr-sr-only" for="urlInput">Enter your website and receive a plain-English diagnostic of how AI systems read your business:</label>
    <form
      id="aio-analyzer"
      toolname="analyze_agent_readiness"
      tooldescription="Analyzes a public website URL for content clarity and observable agent-access signals. Returns qualitative findings, not a score. Cloudflare Search, Agent and Training policy is unverified without an owner-assisted account review."
      novalidate
      onsubmit="runAnalysis(event); return false;"
    >
    <div class="aio-row">
      <input type="url" id="urlInput" name="url" class="aio-input" placeholder="yourbusiness.com" autocomplete="off" autocapitalize="off" toolparamdescription="Public website URL to analyze. Must include http:// or https://." required>
      <button type="submit" class="aio-submit" id="analyzeBtn" aria-label="Analyze website">Analyze →</button>
    </div>
    </form>
    <div class="aio-callout">
      <div class="aio-callout-item">FREE</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">NO SIGNUP</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">NO DATA STORED</div>
    </div>
    <div class="aio-err" id="aioErr"></div>
    <div class="aio-loading" id="aioLoading">
      <div class="spin"></div>
      <div class="loading-txt">Analyzing your site the way AI systems would…</div>
      <div class="loading-step" id="loadingStep">Checking public access signals…</div>
    </div>
  </div>

    </div>
  </div>
  <div class="gr-wrap gr-results-wrap">
    <div class="aio-results" id="aioResults">
      <div id="reviewCard"></div>
      <div class="aicv-actions">
        <button class="btn" aria-label="Analyze another website" onclick="resetTool()">← Analyze another site</button>
        <div class="copy-row">
          <button class="btn btn-primary" aria-label="Copy results as JSON" onclick="copyReport('json')">Copy JSON</button>
          <button class="btn" aria-label="Copy results as Markdown" onclick="copyReport('md')">Copy Markdown</button>
          <button class="btn" aria-label="Copy results as plain text" onclick="copyReport('text')">Copy Text</button>
          <button class="btn" id="saveCardBtn" aria-label="Download the result card as an image" onclick="saveCard()">⬇ Save card</button>
        </div>
      </div>
      <section id="businessMatch" class="business-match" aria-label="Confirm your business" aria-live="polite" hidden></section>
      <div class="aio-post-results">This check shows what we could read. It doesn't change your website or Cloudflare settings. An MVA is a separate purchase.</div>
    </div>
  </div>
</section>

<!-- TIERS -->
<section class="gar-v2-tiers" id="tiers">
  <div class="gar-v2-inner">
  <div class="gar-v2-eyebrow">CHOOSE YOUR FUTURE</div>
  <h2 class="gar-v2-tiers-h">Start free. Build when you're ready.</h2>

  <div class="gar-v2-booking-strip">
    <div class="gar-v2-booking-text">
      <div class="gar-v2-booking-title">Not sure where you fit?</div>
      <div class="gar-v2-booking-sub">Book a call. Let's figure it out.</div>
    </div>
    <a href="https://calendar.app.google/AHgC8z8rGoYZ1Eju5" target="_blank" rel="noopener noreferrer" class="gar-v2-booking-btn">Book →</a>
  </div>
  
  <div class="gar-v2-tier-grid">
    <!-- TIER 0: Agent Preview -->
    <div class="gar-v2-tier-card">
      <div class="gar-v2-tier-body">
