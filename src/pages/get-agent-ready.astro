    .gar-bridge, .gar-substrate, .gar-tiers, .gar-deployment, .gar-bet, .gar-faq, .gar-about {
      padding: 3.5rem 1.5rem;
    }

    .gar-tier-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .gar-network-statements { grid-template-columns: 1fr; gap: 1rem; }
    .gar-proof-strip-inner { padding: 1.5rem; }


    .gar-v2-fig, .gar-v2-fig-tall, .gar-v2-fig-network,
    .gar-v2-fig-small, .gar-v2-fig-close { display: none; }
  }

