      </div>
      <a href="#diagnostic" class="gar-v2-tier-cta">Check your website&nbsp;→</a>
      <button type="button" class="gar-v2-tier-inc" onclick="document.getElementById('inc-preview').classList.add('on');return false;">What's included</button>
    </div>

    <!-- TIER 1: Agent Ready -->
