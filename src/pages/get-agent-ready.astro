  }
  .score-bar-marker {
    position: absolute;
    top: -4px;
    width: 16px;
    height: 16px;
    background: white;
    border-radius: 50%;
    border: 2px solid rgba(0,0,0,0.3);
    transform: translateX(-50%);
    transition: left 1s ease;
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
