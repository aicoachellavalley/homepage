---
import Base from '../layouts/Base.astro';
import nodesData from '../../public/nodes.json';
import briefsData from '../../public/briefs.json';

const nodeCount = nodesData.length;
const briefCount = briefsData.length;

const pageTitle = 'AI Agents in the Coachella Valley — Get Agent Ready | AICV';
const pageDescription = "How do AI agents see your Coachella Valley business? Free agent-readiness diagnostic from AICV, the region's intelligence network for the agentic internet.";
const canonicalUrl = 'https://aicoachellavalley.com/get-agent-ready/';

const schemaGraph = {
