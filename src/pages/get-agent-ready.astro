<!-- ABOVE THE FOLD: hero (left) + diagnostic tool (right) -->
<section class="gr-fold">
  <div class="gr-wrap gr-fold-grid">
    <div class="gr-hero">
      <div class="gr-eyebrow">The agentic internet is here</div>
      <h1 class="gr-h1">Get agent ready.</h1>
      <p class="gr-sub">AICV is the Coachella Valley's intelligence network for the agentic internet.</p>
      <p class="gr-lead">AICV gives your business a structured, AI-readable profile — so AI tools can understand, discover, and route people to you, without touching your website.</p>
      <p class="gr-proofline">Designed to be discovered by Claude, ChatGPT, Perplexity &amp; Gemini.</p>
      <div class="gr-stats">
        <span class="gr-stat">{nodeCount} nodes</span>
        <span class="gr-dot" aria-hidden="true">·</span>
        <span class="gr-stat">{briefCount} briefs</span>
        <span class="gr-dot" aria-hidden="true">·</span>
        <span class="gr-stat">est. 2025</span>
        <a href="/nodes/node-zero" class="gr-proof-link">Proof of work →</a>
      </div>
    </div>
    <div class="gr-tool" id="diagnostic">
      <div class="gr-tool-label">Free tool</div>
      <h2 class="gr-tool-h">Can AI see your business?</h2>
      <p class="gr-tool-sub">See how Claude, ChatGPT, Perplexity, or Gemini read — or miss — your business right now. Plain English.</p>
    
    <div class="aio-card">
    <label class="aio-input-label gr-sr-only" for="urlInput">Enter your website and receive a plain-English diagnostic of how AI systems read your business:</label>
    <form
      id="aio-analyzer"
      toolname="analyze_agent_readiness"
      tooldescription="Analyzes a public website URL and returns an agent-readiness score, verdict, and specific findings. Use to evaluate how well a site is structured for AI agent interaction."
      novalidate
      onsubmit="runAnalysis(event); return false;"
    >
    <div class="aio-row">
      <input type="url" id="urlInput" name="url" class="aio-input" placeholder="yourbusiness.com" autocomplete="off" autocapitalize="off" toolparamdescription="Public website URL to analyze. Must include http:// or https://." required>
      <button type="submit" class="aio-submit" id="analyzeBtn" aria-label="Analyze website">Analyze →</button>
    </div>
    </form>
    <div class="aio-callout">
      <div class="aio-callout-item">FREE</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">NO SIGNUP</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">NO DATA STORED</div>
    </div>
    <div class="aio-err" id="aioErr"></div>
    <div class="aio-loading" id="aioLoading">
      <div class="spin"></div>
      <div class="loading-txt">Analyzing your site the way AI systems would…</div>
      <div class="loading-step" id="loadingStep">Checking crawler access…</div>
    </div>
    <div class="aio-results" id="aioResults">
      <div class="result-top">
        <div class="score-block">
          <div class="score-grade" id="scoreGrade">—</div>
          <div class="score-num" id="scoreNum">—</div>
          <div class="score-bar-wrap">
            <div class="score-bar-track">
              <div class="score-bar-fill" id="scoreBarFill"></div>
              <div class="score-bar-marker" id="scoreBarMarker"></div>
            </div>
            <div class="score-bar-labels"><span>0</span><span>100</span></div>
          </div>
          <div class="score-tag">AIO Visibility Grade</div>
        </div>
        <div class="verdict" id="verdictText"></div>
      </div>
      <div class="result-checks" id="resultChecks"></div>
      <div id="fixesWrap"></div>
      <button class="aio-reset" aria-label="Analyze another website" onclick="resetTool()">← Analyze another site</button>
      <div class="copy-btns">
        <button class="aio-copy" aria-label="Copy results as Markdown" onclick="copyReport('md')">Copy Markdown</button>
        <button class="aio-copy" aria-label="Copy results as JSON" onclick="copyReport('json')">Copy JSON</button>
        <button class="aio-copy" aria-label="Copy results as plain text" onclick="copyReport('text')">Copy Text</button>
      </div>
      <div class="aio-post-results">A diagnostic tells you what AI sees today. It doesn't change what AI reads tomorrow. That's what the Network does. Keep scrolling.</div>
    </div>
  </div>

    </div>
  </div>
</section>

