  /* ================================================================
     GET AGENT READY — sales-page refresh
     DM Sans throughout · flat white hairline cards · volt = CTAs only
     ================================================================ */
  .gr-wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
  .gr-fold, .gr-why { font-family: 'DM Sans', sans-serif; color: var(--pine); }

  /* Above the fold */
  .gr-fold { background: var(--pine-tint); padding: 64px 0 72px; }
  .gr-fold-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  .gr-eyebrow { font-size: .75rem; letter-spacing: .09em; text-transform: uppercase; color: var(--pine-light); font-weight: 500; margin-bottom: .9rem; }
  .gr-h1 { font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(2.4rem, 4.6vw, 3.4rem); line-height: 1.08; letter-spacing: -.01em; color: var(--pine-dark); margin: 0 0 1rem; }
  .gr-sub { font-size: 1.15rem; line-height: 1.6; color: var(--pine); margin: 0 0 1rem; }
  .gr-lead { font-size: 1rem; line-height: 1.7; color: var(--pine); margin: 0 0 1.1rem; max-width: 42ch; }
  .gr-proofline { font-size: .95rem; line-height: 1.6; color: var(--pine-light); margin: 0 0 1.4rem; }
  .gr-stats { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .9rem; color: var(--pine); }
  .gr-dot { color: var(--pine-light); }
  .gr-proof-link { color: var(--pine-dark); font-weight: 500; text-decoration: underline; text-underline-offset: 3px; margin-left: .4rem; }

  /* Tool card */
  .gr-tool { background: #fff; border: .5px solid rgba(18,43,34,.2); border-radius: 12px; padding: 28px 28px 30px; }
  .gr-tool-label { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--pine-light); font-weight: 600; margin-bottom: .7rem; }
  .gr-tool-h { font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 1.55rem; line-height: 1.2; color: var(--pine-dark); margin: 0 0 .4rem; }
  .gr-tool-sub { font-size: .95rem; line-height: 1.6; color: var(--pine); margin: 0 0 1.2rem; }
  .gr-tool .aio-card { background: transparent; border: none; border-radius: 0; padding: 0; margin: 0; }
  .gr-tool .aio-callout-item { color: var(--pine-light); }
  .gr-tool .aio-callout-divider { color: var(--pine-light); opacity: .5; }
  .gr-tool { scroll-margin-top: 96px; }
  .gr-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }

  /* Tiers: 4 compact flat cards */
  .gar-v2-tiers { background: var(--pine-mist); font-family: 'DM Sans', sans-serif; }
  .gar-v2-tiers-h { font-family: 'DM Sans', sans-serif; font-weight: 500; letter-spacing: -.01em; text-transform: none; color: var(--pine-dark); }
  .gar-v2-tier-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .gar-v2-tier-card { background: #fff; border: .5px solid rgba(18,43,34,.18); border-radius: 12px; padding: 22px; box-shadow: none; }
  .gar-v2-tier-eyebrow { font-size: .68rem; letter-spacing: .08em; color: var(--pine-light); font-weight: 600; text-transform: uppercase; }
  .gar-v2-tier-name { font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 1.15rem; color: var(--pine-dark); }
  .gar-v2-tier-desc { font-size: .88rem; line-height: 1.55; color: var(--pine); }
  .gar-v2-tier-price-main { font-family: 'DM Sans', sans-serif; font-weight: 500; color: var(--pine-dark); }
  /* Equal button height so 1-line ("Join Premium") and 2-line CTAs share a grid row,
     keeping price + CTA baselines aligned across all four cards. */
  .gar-v2-tier-cta { background: var(--pine); color: #fff; border: none; min-height: 82px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center; }
  .gar-v2-tier-cta:hover { background: var(--pine-dark); }
  .gar-v2-booking-btn { background: var(--pine); color: #fff; }
  .gr-cta-volt { background: var(--volt); color: var(--pine-dark); font-weight: 600; }
  .gr-cta-volt:hover { background: var(--volt); filter: brightness(.95); }
  .gr-starthere { display: inline-block; background: var(--pine-dark); color: #fff; font-size: .58rem; font-weight: 700; letter-spacing: .06em; padding: 2px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }

  /* Condensed persuasion */
  .gr-why { background: var(--pine-tint); padding: 48px 0; }
  .gr-why-lead { font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 1.4; color: var(--pine-dark); max-width: none; margin: 0 0 1.75rem; }
  .gr-why-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 56px; }
  .gr-col-h { font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 1rem; color: var(--pine-dark); margin: 0 0 .75rem; }
  .gr-col-body { font-size: .88rem; line-height: 1.6; color: var(--pine); margin: 0; }
  .gr-steps { margin: 0; padding-left: 1.1rem; font-size: .88rem; line-height: 1.6; color: var(--pine); }
  .gr-steps li { margin-bottom: .6rem; }
  .gr-agents { margin-top: 3rem; }
  .gr-agents-label { font-size: .72rem; letter-spacing: .09em; text-transform: uppercase; color: var(--pine-light); font-weight: 500; }
  .gr-pills { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  .gr-pill { font-size: .8rem; color: var(--pine); background: rgba(255,255,255,.55); border: .5px solid rgba(18,43,34,.15); border-radius: 999px; padding: .3rem .8rem; }
  .gr-fiscal { margin-top: 2.5rem; font-size: .8rem; line-height: 1.6; color: var(--pine-light); max-width: 72ch; }
  .gr-fiscal a { color: var(--pine-dark); }

  /* Focus + motion */
  .gr-fold a:focus-visible, .gr-why a:focus-visible, .gar-v2-tier-cta:focus-visible { outline: 2px solid var(--pine-dark); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .gr-cta-volt, .gar-v2-tier-cta, .gar-v2-booking-btn { transition: none; } }

  /* Responsive: two-column → stack */
  @media (max-width: 900px) {
    .gr-fold-grid { grid-template-columns: 1fr; gap: 36px; }
    .gar-v2-tier-grid { grid-template-columns: repeat(2, 1fr); }
    .gr-why-grid { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 560px) {
    .gar-v2-tier-grid { grid-template-columns: 1fr; }
    .gr-fold { padding: 48px 0 56px; }
  }
</style>

<script is:inline>
  /* Behavior only — focus the diagnostic input when a CTA jumps to #diagnostic.
     Does not touch runAnalysis or the tool form wiring. */
  (function () {
    var focusTool = function () {
      var i = document.getElementById('urlInput');
      if (i) { try { i.focus({ preventScroll: true }); } catch (e) { i.focus(); } }
    };
    document.querySelectorAll('a[href="#diagnostic"]').forEach(function (a) {
      a.addEventListener('click', function () { setTimeout(focusTool, 500); });
    });
    window.addEventListener('hashchange', function () {
      if (location.hash === '#diagnostic') { setTimeout(focusTool, 500); }
    });
  })();
</script>

<script is:inline>
  const WORKER_BASE = 'https://aicv-api.sunshinefm.workers.dev';

  const STEPS = [
    "Checking if AI crawlers can access your site…",
    "Reading your page content…",
    "Looking for business information…",
    "Checking structured data…",
    "Analyzing local signals…",
    "Generating your plain-English report…"
  ];

  let ticker;

  function norm(s) {
    s = s.trim();
    if (!s) return null;
    if (!/^https?:\/\//i.test(s)) s = 'https://' + s;
    try { return new URL(s).href; } catch { return null; }
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function resetTool() {
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('aioErr').classList.remove('on');
    document.getElementById('urlInput').value = '';
    document.getElementById('analyzeBtn').disabled = false;
    clearInterval(ticker);
  }

  function showErr(msg) {
    const el = document.getElementById('aioErr');
    el.textContent = msg;
    el.classList.add('on');
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('analyzeBtn').disabled = false;
    clearInterval(ticker);
  }

  function gradeFromScore(score) {
    if (score >= 90) return { grade: 'A', color: '#7BAE8C' };
    if (score >= 80) return { grade: 'B', color: '#A8BC7B' };
    if (score >= 70) return { grade: 'C', color: '#C9B87A' };
    if (score >= 60) return { grade: 'D', color: '#C49A7B' };
    return { grade: 'F', color: '#C48A8A' };
  }

  async function runAnalysis(event) {
    if (event && event.preventDefault) event.preventDefault();
    const url = norm(document.getElementById('urlInput').value);
    if (!url) { showErr('Please enter a valid website address, like yourrestaurant.com'); return; }

    document.getElementById('aioErr').classList.remove('on');
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('aioLoading').classList.add('on');
    document.getElementById('analyzeBtn').disabled = true;

    let i = 0;
    const stepEl = document.getElementById('loadingStep');
    stepEl.textContent = STEPS[0];
    ticker = setInterval(() => { stepEl.textContent = STEPS[++i % STEPS.length]; }, 1800);

    try {
      const res = await fetch(WORKER_BASE + '/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });

      if (!res.ok) throw new Error('Analysis service unavailable. Please try again in a moment.');

      const data = await res.json();
      if (data.error) {
        showErr(data.error);
        return;
      }
      let r;
      try {
        const raw = data.content[0].text.replace(/^```json\s*/i, '').replace(/\s*```$/, '').trim();
        r = JSON.parse(raw);
        if (!r.score) throw new Error('Could not read results. Please try again.');
      } catch { throw new Error('Could not read results. Please try again.'); }

      clearInterval(ticker);
      document.getElementById('aioLoading').classList.remove('on');

      const score = Math.max(0, Math.min(100, Math.round(r.score)));
      const sEl = document.getElementById('scoreNum');
      sEl.textContent = score + '%';
      sEl.className = 'score-num';
      const { grade, color: gradeColor } = gradeFromScore(score);
      const gradeEl = document.getElementById('scoreGrade');
      gradeEl.textContent = grade;
      gradeEl.style.color = gradeColor;

      const fill = document.getElementById('scoreBarFill');
      const marker = document.getElementById('scoreBarMarker');
      if (fill && marker) {
        const pct = score;
        fill.style.width = (100 - pct) + '%';
        fill.style.left = pct + '%';
        marker.style.left = pct + '%';
      }

      document.getElementById('verdictText').innerHTML = esc(r.verdict || '');

      document.getElementById('resultChecks').innerHTML = (r.checks || []).map(c => `
        <div class="r-check">
          <div class="r-dot ${c.status}"></div>
          <div>
            <div class="r-name">${esc(c.name)}</div>
            <div class="r-detail">${esc(c.detail)}</div>
          </div>
        </div>
      `).join('');

      const fixes = r.fixes || [];
      document.getElementById('fixesWrap').innerHTML = fixes.length ? `
        <div class="fixes-label" style="margin-top:1.5rem;">Your top fixes</div>
        ${fixes.map(f => `
          <div class="fix ${f.priority}">
            <span class="fix-p ${f.priority}">${f.priority}</span>
            <div class="fix-t">${esc(f.text)}</div>
          </div>
        `).join('')}
      ` : '';

      document.getElementById('aioResults').classList.add('on');
      document.getElementById('analyzeBtn').disabled = false;
      document.getElementById('aioResults').scrollIntoView({ behavior: 'smooth', block: 'start' });

    } catch(err) {
      showErr(err.message || 'Something went wrong. Please try again.');
    }
  }

  document.getElementById('urlInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') runAnalysis();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('tosModal').classList.remove('on');
  });

  function copyReport(format) {
    const score = document.getElementById('scoreNum').textContent;
    const grade = document.getElementById('scoreGrade').textContent;
    const verdict = document.getElementById('verdictText').textContent;
    const url = document.getElementById('urlInput').value;

    const checks = [...document.querySelectorAll('.r-check')].map(el => {
      const dot = el.querySelector('.r-dot');
      const status = dot.classList.contains('pass') ? 'pass' : dot.classList.contains('warn') ? 'warn' : 'fail';
      const name = el.querySelector('.r-name').textContent;
      const detail = el.querySelector('.r-detail').textContent;
      return { status, name, detail };
    });

    const fixes = [...document.querySelectorAll('.fix')].map(el => {
      const priority = el.querySelector('.fix-p').textContent;
      const text = el.querySelector('.fix-t').textContent;
      return { priority, text };
    });

    let output = '';

    if (format === 'md') {
      const statusIcon = s => s === 'pass' ? '✅' : s === 'warn' ? '⚠️' : '❌';
      output = `# AIO Visibility Report\n\n**Site:** ${url}\n**AIO Visibility Grade:** ${grade}\n\n## Summary\n\n${verdict}\n\n## Checks\n\n${checks.map(c => `${statusIcon(c.status)} **${c.name}** — ${c.detail}`).join('\n')}\n\n## Top Fixes\n\n${fixes.map(f => `- **[${f.priority.toUpperCase()}]** ${f.text}`).join('\n')}\n\n---\n*Generated by AICV AIO Tool · aicoachellavalley.com*`;
    }

    if (format === 'json') {
      const data = { site: url, score: parseInt(score), verdict, checks, fixes, generated: new Date().toISOString(), source: 'AICV AIO Tool' };
      output = JSON.stringify(data, null, 2);
    }

    if (format === 'text') {
      const statusIcon = s => s === 'pass' ? '✅' : s === 'warn' ? '⚠️' : '❌';
      output = `AIO VISIBILITY GRADE: ${grade}\nSite: ${url}\n\n${verdict}\n\nCHECKS\n${checks.map(c => `${statusIcon(c.status)} ${c.name}: ${c.detail}`).join('\n')}\n\nTOP FIXES\n${fixes.map(f => `[${f.priority.toUpperCase()}] ${f.text}`).join('\n')}\n\nGenerated by AICV AIO Tool · aicoachellavalley.com`;
    }

    navigator.clipboard.writeText(output).then(() => {
      const btns = document.querySelectorAll('.aio-copy');
      btns.forEach(b => {
        if (b.textContent.toLowerCase().includes(format === 'md' ? 'markdown' : format)) {
          b.textContent = 'Copied ✓';
          setTimeout(() => {
            b.textContent = format === 'md' ? 'Copy Markdown' : format === 'json' ? 'Copy JSON' : 'Copy Text';
          }, 2000);
        }
      });
    });
  }
</script>

</Base>
