---
import Base from '../layouts/Base.astro';

const pageTitle = 'Get Agent Ready — AICV Network Membership';
const pageDescription = "Deploy to the AICV Network — the regional substrate agents query when they're asked about the Coachella Valley. Two membership tiers, annual billing, no website changes required.";
const canonicalUrl = 'https://aicoachellavalley.com/get-agent-ready/';

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#webpage",
      "url": "https://aicoachellavalley.com/get-agent-ready/",
      "name": "Get Agent Ready — AICV Network Membership",
      "description": "Deploy to the AICV Network — the regional substrate agents query when they're asked about the Coachella Valley. Two membership tiers, annual billing, no website changes required.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": "2026-04-23",
      "dateModified": "2026-04-23"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aicoachellavalley.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Get Agent Ready",
          "item": "https://aicoachellavalley.com/get-agent-ready/"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-ready",
      "name": "AICV Ready",
      "description": "Annual membership in the AICV Network for valley businesses that need to be legible to the agent layer. Includes combined AIO + Cloudflare agent-readiness diagnostic, canonical node built to Tier 4 infrastructure standard, MCP routing configuration, and agent-to-agent concierge access.",
      "provider": {
        "@type": "Organization",
        "@id": "https://aicoachellavalley.com/#organization",
        "name": "AI Coachella Valley",
        "url": "https://aicoachellavalley.com/"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "AICV Ready — Deployment Fee",
          "price": "1000.00",
          "priceCurrency": "USD",
          "description": "One-time Deployment Fee covering diagnostic, node build, and MCP integration.",
          "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "AICV Ready — Annual Membership",
          "price": "2500.00",
          "priceCurrency": "USD",
          "description": "Annual membership fee for ongoing Network access.",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "2500.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#service-reviewed",
      "name": "AICV Reviewed",
      "description": "Annual membership with full Intelligence Review for entities positioning to high-net-worth buyers, relocation prospects, corporate retreat decision-makers, or civic partners. Includes everything in AICV Ready plus full Intelligence Council deliberation, 12-month AI readiness roadmap, public living portal, and templatized MCP access.",
      "provider": {
        "@type": "Organization",
        "@id": "https://aicoachellavalley.com/#organization"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Founding Deployment Fee",
          "price": "2500.00",
          "priceCurrency": "USD",
          "description": "One-time Deployment Fee for founding members (first 10 only, pricing locked for life). Covers diagnostic, node build, MCP integration, Intelligence Review, and portal build.",
          "availability": "https://schema.org/LimitedAvailability",
          "eligibleQuantity": {
            "@type": "QuantitativeValue",
            "maxValue": 10,
            "unitText": "founding members"
          }
        },
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Founding Annual Membership",
          "price": "5000.00",
          "priceCurrency": "USD",
          "description": "Annual membership for founding members, locked for life.",
          "availability": "https://schema.org/LimitedAvailability",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "5000.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        },
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Standard Deployment Fee",
          "price": "5000.00",
          "priceCurrency": "USD",
          "description": "Standard Deployment Fee for members 11 onward.",
          "availability": "https://schema.org/InStock"
        },
        {
          "@type": "Offer",
          "name": "AICV Reviewed — Standard Annual Membership",
          "price": "7500.00",
          "priceCurrency": "USD",
          "description": "Annual membership for standard members.",
          "availability": "https://schema.org/InStock",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "7500.00",
            "priceCurrency": "USD",
            "billingDuration": "P1Y",
            "unitText": "annual"
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://aicoachellavalley.com/get-agent-ready/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "We already pay for SEO. Why do we need this?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Different budget, different layer. SEO optimizes for human eyes on Google search results pages — someone typing a query, clicking a blue link, landing on your site. That work still matters and it isn't what AICV does. AICV operates in the layer agents read when they answer a user's question directly, without surfacing a results page at all. When someone asks Claude or ChatGPT where to hold a corporate retreat in the Coachella Valley, your SEO ranking on Google is irrelevant to that answer. Your presence in the regional substrate agents query is what decides whether you're in the answer. Both budgets are legitimate. They serve different interfaces."
          }
        },
        {
          "@type": "Question",
          "name": "Why is there a Deployment Fee separate from annual membership?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Deployment Fee covers the work done once — the diagnostic, the node build, the MCP configuration, the Review (Tier 2), and the portal build. Annual membership keeps everything running. Pricing both honestly is cleaner than bundling setup cost into year-one dues and making year two feel overpriced."
          }
        },
        {
          "@type": "Question",
          "name": "Does AICV touch our website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. That's the point. AICV represents members at Tier 4 agent-readiness in parallel to their own sites — members don't modify their websites, change their CMS, or install anything. The work happens entirely in the substrate AICV operates."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if we stop paying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your canonical node stays published at the Free AICV Listed tier — you remain discoverable. Agent-layer access (concierge, economic-development platform, templatized MCP tools) turns off. Your Intelligence Review portal (Tier 2) goes private. Rejoining is straightforward; existing node data isn't lost."
          }
        },
        {
          "@type": "Question",
          "name": "Who qualifies for membership?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any valley business, institution, property, or civic entity whose presence strengthens the Network's collective signal. AICV reserves editorial judgment on fit — the Network is a curated signal, not a directory."
          }
        },
        {
          "@type": "Question",
          "name": "Can we see an example of the Intelligence Review?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Visit Greater Palm Springs Snapshot at aicoachellavalley.com/snapshots/visit-greater-palm-springs is the public entry point of the same framework. The full Review deepens the three-dimension assessment, adds the 12-month roadmap, and lives as a portal that updates quarterly."
          }
        },
        {
          "@type": "Question",
          "name": "Is AICV a nonprofit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AICV is a fiscally sponsored project of the Desert Community Foundation, a 501(c)(3) operating in Riverside County, California. Membership fees fund the continued build-out of the regional intelligence layer."
          }
        },
        {
          "@type": "Question",
          "name": "What's the founding-member cap actually protecting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Two things. A bounded cohort whose pricing stays locked for life — a genuine reward for early commitment. And AICV's own delivery capacity: the first ten Tier 2 members are deployed and supported personally by Sat. Standard pricing begins at member eleven, by which point Network density, delivery tooling, and positioning have all matured."
          }
        },
        {
          "@type": "Question",
          "name": "What ships this summer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Three things, together: the public Ask AICV chat interface, the Network map at aicoachellavalley.com/network, and member-scoped query access for deployed members. Members who deploy before summer see themselves appear in all three as they ship."
          }
        }
      ]
    }
  ]
};
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  schema={schemaGraph}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Layer · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Layer</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
      <a href="https://sunshine.fm">SunshineFM</a>
    </div>
    <a href="#diagnostic" class="nav-aio-btn">Free AIO Tool ↓</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<!-- ─── SECTION 1 — HERO ─── -->
<section class="gar-hero">
  <div class="gar-hero-inner">
    <div class="gar-eyebrow">
      <span class="eyebrow-pip"></span>
      AICV · Commercial Tier · April 2026
    </div>
    <h1 class="gar-h1">Get Agent Ready.</h1>
    <p class="gar-sub-h1">Deploy to the AICV Network — the regional substrate agents query when they're asked about the Coachella Valley.</p>
    <p class="gar-hero-body">AI systems increasingly decide where high-value buyers go, what they buy, and where they relocate. AICV builds the machine-readable layer those systems read when they're asked about the Coachella Valley. This page is how a valley business becomes part of it.</p>
    <div class="gar-hero-ctas">
      <a href="#diagnostic" class="gar-cta-primary">Run the free diagnostic ↓</a>
      <a href="#tiers" class="gar-cta-secondary">See membership tiers ↓</a>
    </div>
  </div>
</section>

<!-- ─── SECTION 2 — FREE DIAGNOSTIC (AIO TOOL) ─── -->
<section class="aio-section" id="diagnostic">
  <div class="aio-top">
    <div>
      <div class="aio-section-label">Free · No signup · No data stored</div>
      <h2 class="aio-title">Can AI See Your<br>Business?</h2>
      <p class="aio-sub">Foundational LLMs and AI agents now act as intermediaries between customers and companies. If they cannot interpret your business clearly, you don't exist in that layer.</p>
      <p class="aio-sub" style="margin-top:0.75rem;">This diagnostic reveals how leading AI systems evaluate your website — across structure, semantics, and local signals. Results arrive in plain English, no SEO jargon.</p>
    </div>
  </div>

  <div class="aio-card">
    <label class="aio-input-label" for="urlInput">Enter your website and receive a plain-English diagnostic of how AI systems read your business:</label>
    <div class="aio-row">
      <input
        type="url"
        id="urlInput"
        class="aio-input"
        placeholder="yourrestaurant.com or https://yourbusiness.com"
        autocomplete="off"
        autocapitalize="off"
      >
      <button class="aio-submit" id="analyzeBtn" onclick="runAnalysis()">Analyze My Site →</button>
    </div>
    <div class="aio-callout">
      <div class="aio-callout-item">Free.</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">No signup.</div>
      <div class="aio-callout-divider">·</div>
      <div class="aio-callout-item">No data stored.</div>
    </div>
    <div class="aio-note" style="display:none;">Results delivered in plain English — no SEO jargon.</div>

    <div class="aio-err" id="aioErr"></div>

    <div class="aio-loading" id="aioLoading">
      <div class="spin"></div>
      <div class="loading-txt">Analyzing your site the way AI systems would…</div>
      <div class="loading-step" id="loadingStep">Checking crawler access…</div>
    </div>

    <div class="aio-results" id="aioResults">
      <div class="result-top">
        <div class="score-block">
          <div class="score-grade" id="scoreGrade">—</div>
          <div class="score-num" id="scoreNum">—</div>
          <div class="score-bar-wrap">
            <div class="score-bar-track">
              <div class="score-bar-fill" id="scoreBarFill"></div>
              <div class="score-bar-marker" id="scoreBarMarker"></div>
            </div>
            <div class="score-bar-labels">
              <span>0</span>
              <span>100</span>
            </div>
          </div>
          <div class="score-tag">AIO Visibility Grade</div>
        </div>
        <div class="verdict" id="verdictText"></div>
      </div>
      <div class="result-checks" id="resultChecks"></div>
      <div id="fixesWrap"></div>
      <button class="aio-reset" onclick="resetTool()">← Analyze another site</button>
      <div class="copy-btns">
        <button class="aio-copy" onclick="copyReport('md')">Copy Markdown</button>
        <button class="aio-copy" onclick="copyReport('json')">Copy JSON</button>
        <button class="aio-copy" onclick="copyReport('text')">Copy Text</button>
      </div>
      <div class="aio-post-results">
        A diagnostic tells you what AI sees. It doesn't change what AI reads. That's what the Network does. Keep scrolling.
      </div>
    </div>
  </div>
</section>

<!-- ─── SECTION 3 — THE BRIDGE ─── -->
<section class="gar-bridge-wrap">
  <div class="gar-bridge">
    <h2 class="gar-h2">Individual Signal. Collective Signal.</h2>
    <p class="gar-body">The diagnostic you just ran measures one thing: how clearly AI systems can read your website in isolation. That's useful. It's also the smaller half of the problem.</p>
    <p class="gar-body">The larger half is this: when someone in San Francisco asks ChatGPT where to relocate their family, or an executive in Los Angeles asks Claude where to hold a wellness retreat, the AI doesn't evaluate websites one at a time. It draws from the machine-readable knowledge layer that describes the region. Whoever is canonical in that layer becomes the default answer. Whoever isn't, isn't considered.</p>
    <p class="gar-body">A valley business optimizing its own website in isolation is competing against websites. A valley business inside the AICV Network is part of a regional cluster signal that ranks above any single site.</p>
    <p class="gar-body">That's the layer AICV builds. That's what membership is.</p>
    <blockquote class="gar-pullquote">In the substrate, isolation is invisibility. The businesses ranking above you aren't the ones with better websites. They're the ones inside clusters that outrank websites.</blockquote>
  </div>
</section>

<!-- ─── SECTION 4 — WHAT AICV IS ACTUALLY BUILDING ─── -->
<section class="gar-substrate-wrap">
  <div class="gar-substrate">
    <div class="gar-dark-eyebrow">The substrate</div>
    <h2 class="gar-h2-dark">The Intelligence Layer Every Agent Queries</h2>
    <p class="gar-body-dark">AICV is the structured dataset AI systems use to evaluate, cite, and act on information about the Coachella Valley. Eighty nodes. One hundred thirty-three intelligence briefs. A live MCP server callable by any agent. Citation authority already flowing from Perplexity, Claude, Gemini, and ChatGPT.</p>
    <p class="gar-body-dark">Members of the Network live in four places. Three are live today. One ships this summer.</p>

    <div class="gar-substrate-grid">
      <div class="gar-substrate-item">
        <div class="gar-substrate-num">1</div>
        <div class="gar-substrate-title">Your canonical node page</div>
        <div class="gar-substrate-url"><em>aicoachellavalley.com/[your-slug]</em></div>
        <p class="gar-substrate-desc">The authoritative record agents retrieve when they query your entity. Built to AICV's Tier 4 agent-readiness standard.</p>
      </div>
      <div class="gar-substrate-item">
        <div class="gar-substrate-num">2</div>
        <div class="gar-substrate-title">The MCP server</div>
        <div class="gar-substrate-url"><em>mcp.aicoachellavalley.com</em></div>
        <p class="gar-substrate-desc">The agent-callable endpoint. When external agents ask the substrate about your category or city, members are what gets returned.</p>
      </div>
      <div class="gar-substrate-item">
        <div class="gar-substrate-num">3</div>
        <div class="gar-substrate-title">Your Intelligence Review portal <span class="gar-tier-badge">Tier 2</span></div>
        <div class="gar-substrate-url"><em>aicoachellavalley.com/reviews/[your-slug]</em></div>
        <p class="gar-substrate-desc">Your living grade trajectory, prioritized actions, and 12-month AI-readiness roadmap. Updates quarterly as the Network grows.</p>
      </div>
      <div class="gar-substrate-item">
        <div class="gar-substrate-num">4</div>
        <div class="gar-substrate-title">The Network map <span class="gar-summer-badge">Summer 2026</span></div>
        <div class="gar-substrate-url"><em>aicoachellavalley.com/network</em></div>
        <p class="gar-substrate-desc">The regional substrate made visible. Every deployed entity, every cluster, every citation link between them. The table of contents agents use when they query the valley.</p>
      </div>
    </div>

    <p class="gar-substrate-closer">No widgets. No badges. No certificates. The substrate itself is the product.</p>
  </div>
</section>

<!-- ─── SECTION 5 — THE TIERS ─── -->
<section class="gar-tiers-wrap" id="tiers">
  <div class="gar-tiers">
    <div class="gar-section-eyebrow">Two tiers · One Network</div>
    <h2 class="gar-h2">AICV Ready. AICV Reviewed.</h2>
    <p class="gar-body">Every membership is annual. Every membership begins with a one-time Deployment Fee. The Deployment Fee covers the Intelligence Council deliberation, node engineering to Tier 4 infrastructure standard, MCP integration, and — for Reviewed members — the written Review and portal build. Real work, delivered once.</p>

    <div class="gar-tier-grid">

      <!-- AICV Ready -->
      <div class="gar-tier-card tier-ready">
        <div class="gar-tier-label">AICV Ready</div>
        <p class="gar-tier-hook">For valley businesses that need to be legible to the agent layer.</p>
        <ul class="gar-tier-list">
          <li>Combined AIO + Cloudflare agent-readiness diagnostic</li>
          <li>Canonical node at <em>aicoachellavalley.com/[your-slug]</em>, built to Tier 4 infrastructure standard</li>
          <li>MCP routing configured — your entity becomes callable by external agents</li>
          <li>Agent-to-agent tourism concierge and economic-development platform access</li>
          <li>Annual re-diagnostic</li>
          <li>Priority consideration for inclusion in relevant AICV briefs</li>
        </ul>
        <div class="gar-tier-price">
          <div class="gar-price-line"><strong>$1,000 Deployment Fee</strong> <span class="gar-price-note">(one-time)</span></div>
          <div class="gar-price-line"><strong>$2,500 annual membership</strong></div>
          <div class="gar-price-summary">Year one: $3,500. Year two onward: $2,500.</div>
        </div>
        <a href="#book" class="gar-tier-cta">Deploy as AICV Ready →</a>
      </div>

      <!-- AICV Reviewed -->
      <div class="gar-tier-card tier-reviewed">
        <div class="gar-tier-label tier-flagship">AICV Reviewed</div>
        <p class="gar-tier-hook">For entities positioning to high-net-worth buyers, relocation prospects, corporate retreat decision-makers, or civic partners — where a structured Intelligence Review changes the conversation.</p>
        <p class="gar-tier-includes">Includes everything in AICV Ready, plus:</p>
        <ul class="gar-tier-list">
          <li>Full Intelligence Review — IC deliberation across Buyer Readiness, Competitive Positioning, and AI Readiness</li>
          <li>Prioritized actions and 12-month AI-readiness roadmap</li>
          <li>Living client portal at <em>aicoachellavalley.com/reviews/[your-slug]</em> — public</li>
          <li>Quarterly IC refresh with grade trajectory</li>
          <li>Templatized MCP access — priority surfacing in your category, richer <code>get_node</code> response, member-specific tools</li>
          <li>Direct-line notifications on material Network changes affecting your positioning</li>
          <li>Priority inclusion in relevant briefs with cross-links to your node</li>
        </ul>

        <div class="gar-price-block founding">
          <div class="gar-price-header">Founding rate — first 10 members only, locked for life:</div>
          <div class="gar-price-line"><strong>$2,500 Deployment Fee · $5,000 annual</strong></div>
          <div class="gar-price-summary">Year one: $7,500. Year two onward: $5,000.</div>
        </div>

        <div class="gar-price-block standard">
          <div class="gar-price-header">Standard rate — members 11 onward:</div>
          <div class="gar-price-line"><strong>$5,000 Deployment Fee · $7,500 annual</strong></div>
          <div class="gar-price-summary">Year one: $12,500. Year two onward: $7,500.</div>
        </div>

        <div class="gar-founding-counter">10 / 10 Founding Spots Remaining</div>

        <a href="#book" class="gar-tier-cta tier-flagship-cta">Deploy as AICV Reviewed →</a>
      </div>

    </div>
  </div>
</section>

<!-- ─── SECTION 6 — DEPLOYMENT ─── -->
<section class="gar-deployment-wrap">
  <div class="gar-deployment">
    <div class="gar-section-eyebrow">What happens after you pay</div>
    <h2 class="gar-h2">Seven to Ten Business Days. Start to Finish.</h2>
    <p class="gar-body">Deployment is a sequence, not an event. Every step produces a real artifact in the substrate. Every step is documented.</p>

    <div class="gar-deploy-grid">

      <div class="gar-deploy-col">
        <h3 class="gar-deploy-title">AICV Ready — Deployment</h3>
        <ol class="gar-deploy-list">
          <li><em>Payment received.</em> Confirmation email with a link to schedule a call with Sat.</li>
          <li><em>Call with Sat.</em> Forty-five minutes. Positioning, category, target audience.</li>
          <li><em>Diagnostic run.</em> Combined AIO + Cloudflare agent-readiness assessment. Findings shared directly.</li>
          <li><em>Node built.</em> Canonical record at <em>aicoachellavalley.com/[your-slug]</em>, built to Tier 4 infrastructure standard.</li>
          <li><em>MCP routing configured.</em> Your entity is callable by external agents.</li>
          <li><em>Deployment complete.</em> Listed under <em>Recently Deployed</em>.</li>
        </ol>
      </div>

      <div class="gar-deploy-col">
        <h3 class="gar-deploy-title">AICV Reviewed — Deployment</h3>
        <ol class="gar-deploy-list">
          <li><em>Payment received.</em> Confirmation email with a link to schedule a call with Sat.</li>
          <li><em>Call with Sat.</em> Forty-five minutes. Positioning, competitive set, AI-readiness context. The conversation that informs your Review.</li>
          <li><em>Diagnostic run.</em> Combined AIO + Cloudflare agent-readiness assessment.</li>
          <li><em>Node built.</em> Canonical record at <em>aicoachellavalley.com/[your-slug]</em>.</li>
          <li><em>MCP routing configured,</em> including templatized tool access for your category.</li>
          <li><em>Intelligence Council convenes.</em> Five frontier AI models, three dimensions, structured deliberation.</li>
          <li><em>Review written.</em> Findings, prioritized actions, 12-month AI-readiness roadmap.</li>
          <li><em>Portal built</em> at <em>aicoachellavalley.com/reviews/[your-slug]</em>. Public.</li>
          <li><em>Review walkthrough with Sat.</em> Forty-five minutes. Portal goes live during or after the call.</li>
          <li><em>Deployment complete.</em> Listed under <em>Recently Deployed</em>. Quarterly IC refresh calendar set.</li>
        </ol>
      </div>

    </div>
  </div>
</section>

<!-- ─── SECTION 7 — THE HONEST BET ─── -->
<section class="gar-bet-wrap">
  <div class="gar-bet">
    <h2 class="gar-h2-dark">What You're Actually Buying</h2>
