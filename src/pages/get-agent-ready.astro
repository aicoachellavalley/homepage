    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.2rem 0.5rem; flex-shrink: 0; margin-top: 2px;
  }
  .fix-p.high { background: rgba(248,113,113,0.08); color: var(--danger); }
  .fix-p.med  { background: rgba(251,191,36,0.08);  color: var(--warning); }
  .fix-p.low  { background: rgba(74,222,128,0.12);  color: #166534; }

  .fix-t { font-size: 0.88rem; color: rgba(27,67,50,0.75); line-height: 1.6; font-weight: 400; }
  .fix-t strong { color: var(--pine); font-weight: 600; }

  .aio-reset {
    margin-top: 1.5rem;
    background: white;
    border: 1px solid rgba(27,67,50,0.2);
    color: rgba(27,67,50,0.5);
    padding: 0.6rem 1.2rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.77rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .aio-reset:hover { border-color: var(--pine); color: var(--pine); }

  .copy-btns { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }

  .aio-copy {
    background: white;
    border: 1px solid rgba(27,67,50,0.2);
    color: var(--pine);
    padding: 0.6rem 1.1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.77rem;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 500;
  }
  .aio-copy:hover { background: var(--pine); color: var(--volt); border-color: var(--pine); }

  .aio-err {
    display: none; margin-top: 1rem;
    padding: 0.875rem 1.1rem;
    background: rgba(248,113,113,0.06);
    border-left: 2px solid var(--danger);
    font-size: 0.8rem; color: rgba(232,226,208,0.6);
  }
  .aio-err.on { display: block; }

  .aio-post-results {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    background: rgba(27,67,50,0.05);
    border-left: 3px solid var(--pine);
    font-size: 0.95rem;
    color: var(--pine-dark);
    font-weight: 400;
    line-height: 1.6;
    font-style: italic;
  }

  /* ─── SECTION 3 — BRIDGE ─── */
  .gar-bridge-wrap { background: var(--sand-light); }
  .gar-bridge {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    color: var(--pine);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.75rem;
  }

  .gar-body {
    font-size: 1rem;
    color: var(--pine-dark);
    font-weight: 300;
    line-height: 1.85;
    max-width: 72ch;
    margin-bottom: 1.1rem;
  }
  .gar-body strong { color: var(--pine); font-weight: 600; }
  .gar-body em { font-style: italic; color: var(--pine); }
  .gar-body a { color: var(--pine); text-decoration: underline; text-decoration-color: rgba(27,67,50,0.3); }
  .gar-body a:hover { text-decoration-color: var(--pine); }

  .gar-pullquote {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    color: var(--pine);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.015em;
    border-left: 3px solid var(--volt);
    padding: 0.5rem 0 0.5rem 1.75rem;
    margin: 2.5rem 0 0;
    max-width: 64ch;
  }

  /* ─── SECTION 4 — SUBSTRATE ─── */
  .gar-substrate-wrap { background: var(--pine); }
  .gar-substrate {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-dark-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--volt);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .gar-h2-dark {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    color: var(--sand);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.75rem;
  }

  .gar-body-dark {
    font-size: 1rem;
    color: rgba(232,226,208,0.85);
    font-weight: 300;
    line-height: 1.85;
    max-width: 72ch;
    margin-bottom: 1.1rem;
  }
  .gar-body-dark strong { color: var(--sand); font-weight: 600; }
  .gar-body-dark em { font-style: italic; color: var(--volt); }

  .gar-substrate-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(232,226,208,0.08);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .gar-substrate-item {
    background: var(--pine);
    padding: 1.75rem 1.5rem;
    border-top: 2px solid rgba(216,255,0,0.25);
  }

  .gar-substrate-num {
    font-family: 'Syne', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--volt);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
    line-height: 1;
  }

  .gar-substrate-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--sand);
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-bottom: 0.45rem;
  }

  .gar-tier-badge, .gar-summer-badge {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: middle;
    background: rgba(216,255,0,0.12);
    color: var(--volt);
    border: 1px solid rgba(216,255,0,0.25);
  }
  .gar-summer-badge {
    background: rgba(232,226,208,0.08);
    color: rgba(232,226,208,0.7);
    border-color: rgba(232,226,208,0.25);
  }

  .gar-substrate-url {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    color: rgba(216,255,0,0.6);
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }
  .gar-substrate-url em { font-style: italic; }

  .gar-substrate-desc {
    font-size: 0.87rem;
    color: rgba(232,226,208,0.65);
    font-weight: 300;
    line-height: 1.65;
  }

  .gar-substrate-closer {
    font-family: 'Syne', sans-serif;
    font-size: 0.95rem;
    color: var(--volt);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.55;
    border-top: 1px solid rgba(216,255,0,0.2);
    padding-top: 1.5rem;
    margin-top: 1rem;
  }

  /* ─── SECTION 5 — TIERS ─── */
  .gar-tiers-wrap {
    background: var(--sand);
    scroll-margin-top: 100px;
  }
  .gar-tiers {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-section-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pine-light);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .gar-tier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: stretch;
  }

  .gar-tier-card {
    background: var(--sand-light);
    border: 1px solid rgba(27,67,50,0.15);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .gar-tier-card.tier-reviewed {
    background: var(--pine);
    border: 2px solid var(--volt);
  }

  .gar-tier-label {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--pine);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }
  .gar-tier-label.tier-flagship { color: var(--volt); }

  .gar-tier-hook {
    font-size: 0.92rem;
    color: var(--pine-light);
    font-weight: 300;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .tier-reviewed .gar-tier-hook { color: rgba(232,226,208,0.75); }

  .gar-tier-includes {
    font-family: 'Syne', sans-serif;
    font-size: 0.8rem;
    color: var(--volt);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
  }

  .gar-tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .gar-tier-list li {
    font-size: 0.86rem;
    color: var(--pine-dark);
    font-weight: 400;
    line-height: 1.55;
    padding-left: 1.1rem;
    position: relative;
  }
  .gar-tier-list li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.58rem;
    width: 5px; height: 5px;
    background: var(--pine);
    border-radius: 50%;
    opacity: 0.6;
  }
  .gar-tier-list li em { font-style: italic; }
  .gar-tier-list li code {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    background: rgba(27,67,50,0.08);
    padding: 0.05rem 0.35rem;
    border-radius: 2px;
  }

  .tier-reviewed .gar-tier-list li { color: rgba(232,226,208,0.8); }
  .tier-reviewed .gar-tier-list li::before { background: var(--volt); opacity: 0.8; }
  .tier-reviewed .gar-tier-list li code {
    background: rgba(216,255,0,0.1);
    color: var(--volt);
  }

  .gar-tier-price {
    margin-top: auto;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(27,67,50,0.15);
  }

  .gar-price-block {
    padding: 1rem 0;
    border-top: 1px solid rgba(216,255,0,0.15);
  }
  .gar-price-block.founding { border-top: 1px solid rgba(216,255,0,0.3); }

  .gar-price-header {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(232,226,208,0.55);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .gar-price-line {
    font-size: 1rem;
    color: var(--pine);
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }
  .gar-price-line strong { font-weight: 700; }
  .tier-reviewed .gar-price-line { color: var(--sand); }
  .tier-reviewed .gar-price-line strong { color: var(--volt); }

  .gar-price-note {
    font-size: 0.8rem;
    color: rgba(27,67,50,0.55);
    font-weight: 400;
  }
  .tier-reviewed .gar-price-note { color: rgba(232,226,208,0.5); }

  .gar-price-summary {
    font-size: 0.8rem;
    color: rgba(27,67,50,0.6);
    font-weight: 400;
    line-height: 1.55;
  }
  .tier-reviewed .gar-price-summary { color: rgba(232,226,208,0.55); }

  .gar-founding-counter {
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: rgba(216,255,0,0.08);
    border: 1px solid rgba(216,255,0,0.25);
    font-family: 'Syne', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--volt);
    text-align: center;
  }

  .gar-tier-cta {
    margin-top: 1.5rem;
    display: inline-block;
    background: var(--volt);
    color: var(--pine);
    padding: 0.95rem 1.6rem;
    font-family: 'Syne', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s;
  }
  .gar-tier-cta:hover { background: #e8ff33; }

  /* ─── SECTION 6 — DEPLOYMENT ─── */
  .gar-deployment-wrap { background: var(--sand-light); }
  .gar-deployment {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-deploy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .gar-deploy-col {
    background: var(--sand);
    padding: 2rem 1.75rem;
    border-left: 3px solid var(--volt);
  }

  .gar-deploy-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--pine);
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .gar-deploy-list {
    list-style: none;
    counter-reset: deploy;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .gar-deploy-list li {
    counter-increment: deploy;
    font-size: 0.88rem;
    color: var(--pine-dark);
    line-height: 1.6;
    padding-left: 2rem;
    position: relative;
    font-weight: 400;
  }
  .gar-deploy-list li::before {
    content: counter(deploy);
    position: absolute;
    left: 0; top: 0;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--volt);
    background: var(--pine);
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gar-deploy-list li em { font-style: italic; color: var(--pine); font-weight: 500; }

  /* ─── SECTION 7 — BET ─── */
  .gar-bet-wrap { background: var(--pine-dark); }
  .gar-bet {
    max-width: 1060px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }
  .gar-bet-closer {
    font-family: 'Syne', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--volt);
    letter-spacing: -0.01em;
    margin-top: 1.25rem;
  }

  /* ─── SECTION 8 — FAQ ─── */
  .gar-faq-wrap { background: var(--sand); }
  .gar-faq {
    max-width: 960px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-faq-item {
    border-top: 1px solid rgba(27,67,50,0.12);
    padding: 1.75rem 0;
  }
  .gar-faq-item:first-of-type { border-top: none; }

  .gar-faq-q {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--pine);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .gar-faq-a {
    font-size: 0.92rem;
    color: var(--pine-dark);
    font-weight: 300;
    line-height: 1.75;
    max-width: 68ch;
  }
  .gar-faq-a em { font-style: italic; color: var(--pine); }
  .gar-faq-a a { color: var(--pine); text-decoration: underline; text-decoration-color: rgba(27,67,50,0.3); }
  .gar-faq-a a:hover { text-decoration-color: var(--pine); }

  /* ─── SECTION 9 — BOOK ─── */
  .gar-book-wrap {
    background: var(--pine);
    scroll-margin-top: 100px;
  }
  .gar-book {
    max-width: 960px;
    margin: 0 auto;
    padding: 5rem 3rem;
  }

  .gar-book-lede {
    font-family: 'Syne', sans-serif;
    font-size: 1.15rem;
    color: var(--volt);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .gar-book-cta-wrap {
    margin-top: 2.5rem;
    margin-bottom: 3rem;
  }

  .gar-book-cta {
    display: inline-block;
    background: var(--volt);
    color: var(--pine);
    padding: 1.2rem 2.25rem;
    font-family: 'Syne', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.2s, gap 0.2s;
  }
  .gar-book-cta:hover { background: #e8ff33; }

  .gar-book-note {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: rgba(232,226,208,0.5);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .gar-book-fineprint {
    font-size: 0.78rem;
    color: rgba(232,226,208,0.5);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1.6;
    font-style: italic;
    padding-top: 2rem;
    border-top: 1px solid rgba(232,226,208,0.1);
  }

  /* ─── FOOTER (shared with homepage) ─── */
  footer {
    background: var(--pine-dark);
    padding: 4rem 3rem 2.5rem;
  }
  .foot-inner { max-width: 1060px; margin: 0 auto; }
  .foot-top {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(232,226,208,0.08);
    margin-bottom: 2rem;
  }
  .foot-mark {
    width: 38px; height: 38px;
    background: var(--volt);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif;
    font-weight: 800; font-size: 11px;
    color: var(--pine);
    margin-bottom: 0.875rem;
  }
  .foot-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700; font-size: 0.88rem;
    color: var(--sand); margin-bottom: 0.3rem;
  }
  .foot-full {
    font-size: 0.7rem; color: rgba(232,226,208,0.6);
    font-weight: 300; line-height: 1.6;
  }
  .foot-cities-label {
    font-size: 0.6rem; letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232,226,208,0.6);
    margin-bottom: 1rem; font-weight: 500;
  }
  .foot-cities {
    font-size: 0.8rem;
    color: rgba(232,226,208,0.4);
    font-weight: 300;
    line-height: 2;
  }
  .foot-sep { color: rgba(232,226,208,0.15); margin: 0 0.4rem; }
  .foot-bottom {
    display: flex; align-items: center;
    justify-content: space-between; gap: 2rem;
  }
  .foot-copy {
    font-size: 0.72rem;
    color: rgba(232,226,208,0.6);
    font-weight: 300;
    line-height: 1.6;
  }
  .foot-links { display: flex; gap: 1.75rem; align-items: center; flex-wrap: wrap; }
  .foot-links a {
    font-size: 0.72rem;
    color: rgba(232,226,208,0.6);
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.02em;
  }
  .foot-links a:hover { color: var(--volt); }

  /* ─── TERMS OF USE MODAL ─── */
  .tos-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(18, 43, 34, 0.85);
    backdrop-filter: blur(4px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .tos-overlay.on { display: flex; }

  .tos-panel {
    background: var(--gunmetal);
    border: 1px solid rgba(232,226,208,0.12);
    border-top: 3px solid var(--volt);
    max-width: 660px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 3rem 3rem 2.5rem;
    position: relative;
  }

  .tos-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: none;
    border: 1px solid rgba(232,226,208,0.2);
    color: rgba(232,226,208,0.6);
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, color 0.2s;
  }
  .tos-close:hover { border-color: var(--volt); color: var(--volt); }

  .tos-label {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--volt);
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  .tos-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--sand);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .tos-date {
    font-size: 0.7rem;
    color: rgba(232,226,208,0.4);
    font-weight: 300;
    margin-bottom: 2rem;
  }

  .tos-body p {
    font-size: 0.875rem;
    color: rgba(232,226,208,0.7);
    font-weight: 300;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .tos-body h3 {
    font-family: 'Syne', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sand);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 1.75rem 0 0.5rem;
  }

  .tos-body a { color: var(--volt); text-decoration: none; }
  .tos-body a:hover { text-decoration: underline; }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 860px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }

    .gar-hero { padding: 3.5rem 1.5rem 3rem; }
    .aio-section { padding: 2rem 1.5rem 3.5rem; }
    .aio-top { grid-template-columns: 1fr; gap: 1rem; }
    .aio-row { flex-direction: column; }
    .aio-input { border-right: 1px solid var(--sand); }
    .result-top { grid-template-columns: 1fr; }

    .gar-bridge, .gar-substrate, .gar-tiers, .gar-deployment, .gar-bet, .gar-faq, .gar-book {
      padding: 3.5rem 1.5rem;
    }

    .gar-substrate-grid { grid-template-columns: 1fr; }
    .gar-tier-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .gar-deploy-grid { grid-template-columns: 1fr; gap: 1.5rem; }

    footer { padding: 2.5rem 1.5rem 2rem; }
    .foot-top { grid-template-columns: 1fr; gap: 2rem; }
    .foot-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

<script is:inline>
  const WORKER_BASE = 'https://aicv-api.sunshinefm.workers.dev';

  const STEPS = [
    "Checking if AI crawlers can access your site…",
    "Reading your page content…",
    "Looking for business information…",
    "Checking structured data…",
    "Analyzing local signals…",
    "Generating your plain-English report…"
  ];

  let ticker;

  function norm(s) {
    s = s.trim();
    if (!s) return null;
    if (!/^https?:\/\//i.test(s)) s = 'https://' + s;
    try { return new URL(s).href; } catch { return null; }
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function resetTool() {
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('aioErr').classList.remove('on');
    document.getElementById('urlInput').value = '';
    document.getElementById('analyzeBtn').disabled = false;
    clearInterval(ticker);
  }

  function showErr(msg) {
    const el = document.getElementById('aioErr');
    el.textContent = msg;
    el.classList.add('on');
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('analyzeBtn').disabled = false;
    clearInterval(ticker);
  }

  function gradeFromScore(score) {
    if (score >= 90) return { grade: 'A', color: '#7BAE8C' };
    if (score >= 80) return { grade: 'B', color: '#A8BC7B' };
    if (score >= 70) return { grade: 'C', color: '#C9B87A' };
    if (score >= 60) return { grade: 'D', color: '#C49A7B' };
    return { grade: 'F', color: '#C48A8A' };
  }

  async function runAnalysis() {
    const url = norm(document.getElementById('urlInput').value);
    if (!url) { showErr('Please enter a valid website address, like yourrestaurant.com'); return; }

    document.getElementById('aioErr').classList.remove('on');
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('aioLoading').classList.add('on');
    document.getElementById('analyzeBtn').disabled = true;

    let i = 0;
    const stepEl = document.getElementById('loadingStep');
    stepEl.textContent = STEPS[0];
    ticker = setInterval(() => { stepEl.textContent = STEPS[++i % STEPS.length]; }, 1800);

    try {
      const res = await fetch(WORKER_BASE + '/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });

      if (!res.ok) throw new Error('Analysis service unavailable. Please try again in a moment.');

      const data = await res.json();
      if (data.error) {
        showErr(data.error);
        return;
      }
      let r;
      try {
        const raw = data.content[0].text.replace(/^```json\s*/i, '').replace(/\s*```$/, '').trim();
        r = JSON.parse(raw);
        if (!r.score) throw new Error('Could not read results. Please try again.');
      } catch { throw new Error('Could not read results. Please try again.'); }

      clearInterval(ticker);
      document.getElementById('aioLoading').classList.remove('on');

      const score = Math.max(0, Math.min(100, Math.round(r.score)));
      const sEl = document.getElementById('scoreNum');
      sEl.textContent = score + '%';
      sEl.className = 'score-num';
      const { grade, color: gradeColor } = gradeFromScore(score);
      const gradeEl = document.getElementById('scoreGrade');
      gradeEl.textContent = grade;
      gradeEl.style.color = gradeColor;

      const fill = document.getElementById('scoreBarFill');
      const marker = document.getElementById('scoreBarMarker');
      if (fill && marker) {
        const pct = score;
        fill.style.width = (100 - pct) + '%';
        fill.style.left = pct + '%';
        marker.style.left = pct + '%';
      }

      document.getElementById('verdictText').innerHTML = esc(r.verdict || '');

      document.getElementById('resultChecks').innerHTML = (r.checks || []).map(c => `
        <div class="r-check">
          <div class="r-dot ${c.status}"></div>
          <div>
            <div class="r-name">${esc(c.name)}</div>
            <div class="r-detail">${esc(c.detail)}</div>
          </div>
        </div>
      `).join('');

      const fixes = r.fixes || [];
      document.getElementById('fixesWrap').innerHTML = fixes.length ? `
        <div class="fixes-label" style="margin-top:1.5rem;">Your top fixes</div>
        ${fixes.map(f => `
          <div class="fix ${f.priority}">
            <span class="fix-p ${f.priority}">${f.priority}</span>
            <div class="fix-t">${esc(f.text)}</div>
          </div>
        `).join('')}
      ` : '';

      document.getElementById('aioResults').classList.add('on');
      document.getElementById('analyzeBtn').disabled = false;
      document.getElementById('aioResults').scrollIntoView({ behavior: 'smooth', block: 'start' });

    } catch(err) {
      showErr(err.message || 'Something went wrong. Please try again.');
    }
  }

  document.getElementById('urlInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') runAnalysis();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('tosModal').classList.remove('on');
  });

  function copyReport(format) {
    const score = document.getElementById('scoreNum').textContent;
    const grade = document.getElementById('scoreGrade').textContent;
    const verdict = document.getElementById('verdictText').textContent;
    const url = document.getElementById('urlInput').value;

    const checks = [...document.querySelectorAll('.r-check')].map(el => {
      const dot = el.querySelector('.r-dot');
      const status = dot.classList.contains('pass') ? 'pass' : dot.classList.contains('warn') ? 'warn' : 'fail';
      const name = el.querySelector('.r-name').textContent;
      const detail = el.querySelector('.r-detail').textContent;
      return { status, name, detail };
    });

    const fixes = [...document.querySelectorAll('.fix')].map(el => {
      const priority = el.querySelector('.fix-p').textContent;
      const text = el.querySelector('.fix-t').textContent;
      return { priority, text };
    });

    let output = '';

    if (format === 'md') {
      const statusIcon = s => s === 'pass' ? '✅' : s === 'warn' ? '⚠️' : '❌';
      output = `# AIO Visibility Report\n\n**Site:** ${url}\n**AIO Visibility Grade:** ${grade}\n\n## Summary\n\n${verdict}\n\n## Checks\n\n${checks.map(c => `${statusIcon(c.status)} **${c.name}** — ${c.detail}`).join('\n')}\n\n## Top Fixes\n\n${fixes.map(f => `- **[${f.priority.toUpperCase()}]** ${f.text}`).join('\n')}\n\n---\n*Generated by AICV AIO Tool · aicoachellavalley.com*`;
    }

    if (format === 'json') {
      const data = { site: url, score: parseInt(score), verdict, checks, fixes, generated: new Date().toISOString(), source: 'AICV AIO Tool' };
      output = JSON.stringify(data, null, 2);
    }

    if (format === 'text') {
      const statusIcon = s => s === 'pass' ? '✅' : s === 'warn' ? '⚠️' : '❌';
      output = `AIO VISIBILITY GRADE: ${grade}\nSite: ${url}\n\n${verdict}\n\nCHECKS\n${checks.map(c => `${statusIcon(c.status)} ${c.name}: ${c.detail}`).join('\n')}\n\nTOP FIXES\n${fixes.map(f => `[${f.priority.toUpperCase()}] ${f.text}`).join('\n')}\n\nGenerated by AICV AIO Tool · aicoachellavalley.com`;
    }

    navigator.clipboard.writeText(output).then(() => {
      const btns = document.querySelectorAll('.aio-copy');
      btns.forEach(b => {
        if (b.textContent.toLowerCase().includes(format === 'md' ? 'markdown' : format)) {
          b.textContent = 'Copied ✓';
          setTimeout(() => {
            b.textContent = format === 'md' ? 'Copy Markdown' : format === 'json' ? 'Copy JSON' : 'Copy Text';
          }, 2000);
        }
      });
    });
  }
</script>

</Base>
