  .business-match :global(a) { color: var(--pine); }
  .purchase-match-note { font-size: .9rem; line-height: 1.6; margin: 1rem 0 0; color: var(--pine); }
  .purchase-match-note a { color: inherit; text-underline-offset: .15em; }
</style>

<script is:inline>
  const WORKER_BASE = 'https://aicv-api.sunshinefm.workers.dev';

  const STEPS = [
    "Checking public reachability and crawler preferences…",
    "Reading your page content…",
    "Looking for business information…",
    "Checking structured data…",
    "Analyzing local signals…",
    "Generating your plain-English report…"
  ];

  let ticker;
  let lastResult = null; // last structured review, source of truth for exports
  let analysisGeneration = 0;

  function clearBusinessMatch() {
    document.dispatchEvent?.(new CustomEvent('aicv:diagnostic-reset'));
  }

  function norm(s) {
    s = s.trim();
    if (!s) return null;
    if (!/^https?:\/\//i.test(s)) s = 'https://' + s;
    try { return new URL(s).href; } catch { return null; }
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function resetTool() {
    analysisGeneration++;
    lastResult = null;
    clearBusinessMatch();
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('aioErr').classList.remove('on');
    document.getElementById('urlInput').value = '';
    document.getElementById('analyzeBtn').disabled = false;
    clearInterval(ticker);
  }

  function showErr(msg) {
    clearBusinessMatch();
    const el = document.getElementById('aioErr');
    el.textContent = msg;
    el.classList.add('on');
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('analyzeBtn').disabled = false;
    clearInterval(ticker);
  }

  async function runAnalysis(event) {
    const generation = ++analysisGeneration;
    clearBusinessMatch();
    if (event && event.preventDefault) event.preventDefault();
    const url = norm(document.getElementById('urlInput').value);
    if (!url) { showErr('Please enter a valid website address, like yourrestaurant.com'); return; }

    document.getElementById('aioErr').classList.remove('on');
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('aioLoading').classList.add('on');
    document.getElementById('analyzeBtn').disabled = true;

    let i = 0;
    const stepEl = document.getElementById('loadingStep');
    stepEl.textContent = STEPS[0];
    ticker = setInterval(() => { stepEl.textContent = STEPS[++i % STEPS.length]; }, 1800);

    try {
      const res = await fetch(WORKER_BASE + '/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });

      if (!res.ok) throw new Error('Analysis service unavailable. Please try again in a moment.');

      const r = await res.json();
      if (generation !== analysisGeneration) return;
      if (r.error) {
        showErr(r.error);
        return;
      }
      if (r.review_status !== 'access-only' && (!r.verdict || !r.dimensions)) throw new Error('Could not read results. Please try again.');

      clearInterval(ticker);
      document.getElementById('aioLoading').classList.remove('on');

      lastResult = r;
      document.getElementById('reviewCard').innerHTML = renderReview(r);
      document.dispatchEvent?.(new CustomEvent('aicv:diagnostic-complete', { detail: { url } }));

      document.getElementById('aioResults').classList.add('on');
      document.getElementById('analyzeBtn').disabled = false;
      document.getElementById('aioResults').scrollIntoView({ behavior: 'smooth', block: 'start' });

    } catch(err) {
      if (generation !== analysisGeneration) return;
      showErr(err.message || 'Something went wrong. Please try again.');
    }
  }

  const DIM_LABELS = { identity: 'Identity', structure: 'Structure', substance: 'Substance', credibility: 'Credibility' };
  // Display labels only — the underlying state enum (clear/partial/missing)
  // is unchanged everywhere, including Copy JSON. One rung, two causes:
  // the label carries how bad, the note carries why (absent vs stale).
  const STATE_LABELS = { clear: 'CLEAR', partial: 'PARTIAL', missing: 'MISSING/STALE' };
  // "Discoverable", not "Cited": locked vocabulary rule (2026-07-16) —
  // "Cited" is reserved for premium-tier materials only.
  const RUNGS = ['Invisible', 'Partly visible', 'Visible', 'Agent ready', 'Discoverable'];

  function accessLines(r) {
    const a = r.agent_access;
    if (!a) return ['Agent Access was not returned by this diagnostic version. Public access and Cloudflare SAT settings are unverified.'];
    return [a.summary, `Checked URL: ${a.checked_url}`, `Checked at: ${a.checked_at}`,
      `Page fetch: ${a.http.note}`, `Robots preferences: ${a.robots.note}`,
      'Cloudflare SAT: Search — UNVERIFIED; Agent — UNVERIFIED; Training — UNVERIFIED.',
      a.edge_policy.note,
      ...(a.robots.crawlers || []).map(c => `${c.agent} (${c.purpose} use examined): ${c.policy} for the checked URL — robots preference only, not enforced access.`),
      ...(a.content_signals || []).map(s => `Content-Signal (${s.source}; ${s.agents.join(', ')}): ${Object.entries(s.preferences).map(([k,v]) => `${k}=${v}`).join(', ')} — declared preference, not a SAT setting.`),
      'Training permission is a separate owner choice, not a visibility requirement.', a.next_step];
  }

  function renderAgentAccess(r) {
    const lines = accessLines(r);
    return `<section class="aicv-access" aria-label="Agent Access">
      <h3>Agent Access — Cloudflare SAT unverified</h3>
      <p>${esc(lines[0])}</p>
      <p><strong>Search: UNVERIFIED · Agent: UNVERIFIED · Training: UNVERIFIED</strong></p>
      <details><summary>Public observations and their limits</summary><ul>${lines.slice(1).map(line => `<li>${esc(line)}</li>`).join('')}</ul></details>
      <p><a href="#agent-access">How to check Cloudflare with your site manager</a></p>
    </section>`;
  }

  function renderReview(r) {
    if (r.review_status === 'access-only') return `<div class="aicv-review">
      <div class="aicv-eyebrow">AGENT PREVIEW — ACCESS ONLY</div>
      <h2 class="aicv-biz">Content not assessed</h2>
      <p class="aicv-url">${esc(r.domain || '')} · ${esc(r.reviewed_date || '')}</p>
      <p class="aicv-scope">${esc(r.summary || '')}</p>${renderAgentAccess(r)}</div>`;
    const dims = r.dimensions || {};
    const urlLine = [esc(r.domain || ''), esc(r.locality || '')].filter(Boolean).join(' · ');

    const rungs = RUNGS.map((label, i) => {
      const n = i + 1;
      const active = n === r.active_rung;
      const horizon = n > 3;
      return `<div class="aicv-rung${active ? ' is-active' : ''}${horizon ? ' is-horizon' : ''}">
        <span class="aicv-rung-dot"></span>
        <span class="aicv-rung-label">${label}</span>
        ${active ? '<span class="aicv-rung-here">you are here</span>' : ''}
      </div>`;
    }).join('');

    const cards = Object.keys(DIM_LABELS).map(k => {
      const d = dims[k] || {};
      const state = ['clear', 'partial', 'missing'].includes(d.state) ? d.state : 'partial';
      return `<div class="aicv-dim st-${state}">
        <div class="aicv-dim-head"><span class="aicv-dim-name">${DIM_LABELS[k]}</span><span class="aicv-dim-state">${STATE_LABELS[state]}</span></div>
        <div class="aicv-dim-note">${esc(d.note || '')}</div>
      </div>`;
    }).join('');

    const fixes = (r.fixes || []).slice(0, 3).map(f => {
      const sev = ['high', 'med', 'low'].includes(f.severity) ? f.severity : 'med';
      return `<div class="aicv-fix-row"><span class="aicv-sev aicv-sev-${sev}">${sev.toUpperCase()}</span><span class="aicv-fix-txt">${esc(f.text)}</span></div>`;
    }).join('');

    return `<div class="aicv-review">
      <div class="aicv-head">
        <div>
          <div class="aicv-eyebrow">AGENT PREVIEW</div>
          <div class="aicv-biz">${esc(r.business_name || 'This business')}</div>
          ${urlLine ? `<div class="aicv-url">${urlLine}</div>` : ''}
          <div class="aicv-reviewed">Reviewed ${esc(r.reviewed_date || '')}</div>
        </div>
        <div class="aicv-head-right">
          <div class="aicv-eyebrow">CONTENT ASSESSMENT</div>
          <div class="aicv-verdict">${esc(r.verdict || '')} — content only</div>
        </div>
      </div>
      <p class="aicv-scope">${esc(r.visibility_scope || 'Content assessment only; access for every crawler and Cloudflare SAT settings are unverified.')}</p>
      <div class="aicv-ladder">
        <div class="aicv-ladder-track">${rungs}</div>
        <div class="aicv-ladder-net">— the Network —</div>
      </div>
      <div class="aicv-dims">${cards}</div>
      ${renderAgentAccess(r)}
      ${fixes ? `<div class="aicv-fixes"><div class="aicv-eyebrow aicv-fixes-cap">WHAT YOU COULD FIX YOURSELF</div>${fixes}</div>` : ''}
      <div class="aicv-foot">
        <span class="aicv-foot-meta">Generated by AICV · aicoachellavalley.com · Reviewed ${esc(r.reviewed_date || '')}</span>
        <a class="aicv-cta" href="#tiers">Get to Agent Ready →</a>
      </div>
    </div>`;
  }

  document.getElementById('urlInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') runAnalysis();
  });
  document.getElementById('urlInput').addEventListener('input', () => {
    analysisGeneration++;
    clearBusinessMatch();
    clearInterval(ticker);
    lastResult = null;
    document.getElementById('aioLoading').classList.remove('on');
    document.getElementById('aioResults').classList.remove('on');
    document.getElementById('analyzeBtn').disabled = false;
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.getElementById('tosModal').classList.remove('on');
  });

  // Exports read from lastResult (the worker's structured response), not the
  // DOM. The public payload is qualitative only: verdict enum, dimensions,
  // fixes, dates — never a score, never a claim about the horizon rungs.
  function copyReport(format) {
    if (!lastResult) return;
    const r = lastResult;
    const dims = Object.keys(DIM_LABELS).map(k => {
      const d = (r.dimensions || {})[k] || {};
      return { name: DIM_LABELS[k], state: STATE_LABELS[d.state] || (d.state || '').toUpperCase(), note: d.note || '' };
    });
    const fixes = (r.fixes || []).map(f => ({ severity: f.severity, text: f.text }));
    const accessText = accessLines(r).join('\n');

    let output = '';

    if (format === 'md') {
      output = `# Agent Preview — ${r.business_name}\n\n**Site:** ${r.domain}${r.locality ? `\n**Location:** ${r.locality}` : ''}\n**Reviewed:** ${r.reviewed_date}\n**How agents see you:** ${r.verdict}\n\n${r.summary}\n\n## The four dimensions\n\n${dims.map(d => `- **${d.name} — ${d.state}.** ${d.note}`).join('\n')}\n\n## What you could fix yourself\n\n${fixes.map(f => `- **[${f.severity.toUpperCase()}]** ${f.text}`).join('\n')}\n\n---\n*Generated by AICV Agent Preview · aicoachellavalley.com · Reviewed ${r.reviewed_date}*`;
    }

    if (format === 'json') {
      output = JSON.stringify({
        site: r.domain,
        business_name: r.business_name,
        locality: r.locality,
        reviewed_date: r.reviewed_date,
        verdict: r.verdict ? `${r.verdict} — content only; crawler access not fully verified` : 'Content not assessed',
        review_status: r.review_status || 'complete',
        visibility_scope: r.visibility_scope || 'Content not assessed; Cloudflare SAT settings unverified.',
        agent_access: r.agent_access || { state: 'inconclusive', summary: accessText },
        dimensions: r.dimensions,
        fixes,
        source: 'AICV Agent Preview · aicoachellavalley.com'
      }, null, 2);
    }

    if (format === 'text') {
      output = `AGENT PREVIEW\n${r.business_name}\nSite: ${r.domain}${r.locality ? `\nLocation: ${r.locality}` : ''}\nReviewed: ${r.reviewed_date}\nHow agents see you: ${r.verdict}\n\n${r.summary}\n\nTHE FOUR DIMENSIONS\n${dims.map(d => `${d.name} — ${d.state}: ${d.note}`).join('\n')}\n\nWHAT YOU COULD FIX YOURSELF\n${fixes.map(f => `[${f.severity.toUpperCase()}] ${f.text}`).join('\n')}\n\nGenerated by AICV Agent Preview · aicoachellavalley.com · Reviewed ${r.reviewed_date}`;
    }

    if (format !== 'json') {
      if (r.review_status === 'access-only') output = `AGENT PREVIEW — CONTENT NOT ASSESSED\n${r.domain}\nReviewed: ${r.reviewed_date}\n\n${r.summary}`;
      else output = output.replace(`How agents see you:** ${r.verdict}`, `Content assessment:** ${r.verdict} — content only; crawler access not fully verified`).replace(`How agents see you: ${r.verdict}`, `Content assessment: ${r.verdict} — content only; crawler access not fully verified`);
      output += `\n\n${format === 'md' ? '## ' : ''}Agent Access\n\n${accessText}\n\nhttps://aicoachellavalley.com/get-agent-ready/#agent-access`;
    }
    navigator.clipboard.writeText(output).then(() => {
      const btns = document.querySelectorAll('.aicv-actions .btn');
      btns.forEach(b => {
        if (b.textContent.toLowerCase().includes(format === 'md' ? 'markdown' : format)) {
          b.textContent = 'Copied ✓';
          setTimeout(() => {
            b.textContent = format === 'md' ? 'Copy Markdown' : format === 'json' ? 'Copy JSON' : 'Copy Text';
          }, 2000);
        }
      });
    });
  }

  // ── Save-card PNG export. html-to-image is lazy-loaded from cdnjs on
  // first tap (zero page-weight until used); capture is #reviewCard at 2x
  // on the cream ground. Double-render is the Safari warm-up (first pass
  // can drop webfonts); document.fonts.ready guards font timing. Failure
  // never touches the copy exports: capture errors show a polite note and
  // re-enable; a library-load failure hides the button.
  let htiLoad = null;
  function loadHti() {
    if (window.htmlToImage) return Promise.resolve(window.htmlToImage);
    if (!htiLoad) {
      htiLoad = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.13/html-to-image.min.js';
        s.integrity = 'sha512-iZ2ORl595Wx6miw+GuadDet4WQbdSWS3JLMoNfY8cRGoEFy6oT3G9IbcrBeL6AfkgpA51ETt/faX6yLV+/gFJg==';
        s.crossOrigin = 'anonymous';
        s.referrerPolicy = 'no-referrer';
        s.onload = () => window.htmlToImage ? resolve(window.htmlToImage) : reject(new Error('no global'));
        s.onerror = () => { htiLoad = null; reject(new Error('load failed')); };
        document.head.appendChild(s);
      });
    }
    return htiLoad;
  }

  async function saveCard() {
    const btn = document.getElementById('saveCardBtn');
    const wrap = document.getElementById('reviewCard');
    // Capture the card itself, not the full-width wrapper — avoids a slab
    // of empty ground on the right of the PNG.
    const card = wrap && (wrap.querySelector('.aicv-review') || wrap);
    if (!btn || !card || !lastResult) return;
    const idle = '⬇ Save card';
    btn.disabled = true;
    btn.textContent = 'Saving…';

    let hti;
    try {
      hti = await loadHti();
    } catch (e) {
      btn.textContent = "Couldn't save — try a screenshot";
      setTimeout(() => { btn.style.display = 'none'; }, 3000);
      return;
    }

    try {
      await document.fonts.ready;
      // toSvg (serializer + font embed) plus our own rasterize step. The
      // library's toPng path rides on Image.decode(), which hangs or flakes
      // on SVG payloads in some engines (Safari included) — onload doesn't.
      const rect = card.getBoundingClientRect();
      const svgUrl = await hti.toSvg(card, { backgroundColor: '#FAFAF7' });
      const rasterize = () => new Promise((resolve, reject) => {
        const img = new Image();
        const t = setTimeout(() => reject(new Error('capture timed out')), 15000);
        img.onload = () => {
          clearTimeout(t);
          try {
            const c = document.createElement('canvas');
            c.width = Math.round(rect.width * 2);   // 2x pixel density
            c.height = Math.round(rect.height * 2);
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#FAFAF7';              // cream ground baked in
            ctx.fillRect(0, 0, c.width, c.height);
            ctx.drawImage(img, 0, 0, c.width, c.height);
            resolve(c.toDataURL('image/png'));
          } catch (e) { reject(e); }
        };
        img.onerror = () => { clearTimeout(t); reject(new Error('render failed')); };
        img.src = svgUrl;
      });
      await rasterize();                 // Safari warm-up pass (fonts settle)
      const dataUrl = await rasterize(); // keep the second
      if (!dataUrl || dataUrl.length < 2000) throw new Error('blank capture');

      const domain = (lastResult.domain || 'site').replace(/[^a-zA-Z0-9.-]/g, '');
      const when = new Date(lastResult.reviewed_date || Date.now());
      const d = isNaN(when) ? new Date() : when;
      const date = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const a = document.createElement('a');
      a.download = `agent-preview-${domain}-${date}.png`;
      a.href = dataUrl;
      a.click();

      btn.textContent = 'Saved ✓';
      setTimeout(() => { btn.textContent = idle; btn.disabled = false; }, 2000);
    } catch (e) {
      btn.textContent = "Couldn't save — try a screenshot";
      setTimeout(() => { btn.textContent = idle; btn.disabled = false; }, 3000);
    }
  }
</script>

</Base>
