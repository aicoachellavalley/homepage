---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const CITY_ORDER = [
  'Valley Wide',
  'Rancho Mirage',
  'Palm Desert',
  'Indian Wells',
  'La Quinta',
  'Palm Springs',
  'Indio',
  'Coachella',
  'Adjacent Communities',
];

const CITY_LABELS: Record<string, string> = {
  'Valley Wide':          'Valley Wide',
  'Coachella Valley':     'Valley Wide',
  'Rancho Mirage':        'Rancho Mirage',
  'Palm Desert':          'Palm Desert',
  'Indian Wells':         'Indian Wells',
  'La Quinta':            'La Quinta',
  'Palm Springs':         'Palm Springs',
  'Indio':                'Indio',
  'Coachella':            'Coachella',
  'Adjacent Communities': 'Adjacent Communities',
};

const CITY_SLUG: Record<string, string> = {
  'Valley Wide':          'valley-wide',
  'Coachella Valley':     'valley-wide',
  'Rancho Mirage':        'rancho-mirage',
  'Palm Desert':          'palm-desert',
  'Indian Wells':         'indian-wells',
  'La Quinta':            'la-quinta',
  'Palm Springs':         'palm-springs',
  'Indio':                'indio',
  'Coachella':            'coachella',
  'Adjacent Communities': 'adjacent-communities',
};

const allNodes = await getCollection('nodes');
const totalNodes = allNodes.length;

// Normalize city values — group "Valley Wide", "Valley-Wide", "valley-wide", "Coachella Valley" together
function normalizeCity(city: string): string {
  const s = city.trim().toLowerCase().replace(/-/g, ' ');
  if (s === 'valley wide' || s === 'coachella valley') return 'Valley Wide';
  // Title-case lookup
  for (const k of Object.keys(CITY_LABELS)) {
    if (k.toLowerCase() === s) return k;
  }
  return city;
}

const byCity: Record<string, typeof allNodes> = {};
for (const entry of allNodes) {
  const city = normalizeCity(entry.data.city || 'Other');
  if (!byCity[city]) byCity[city] = [];
  byCity[city].push(entry);
}
for (const city of Object.keys(byCity)) {
  byCity[city].sort((a, b) => a.data.title.localeCompare(b.data.title));
}

const pageTitle       = 'Intelligence Nodes — AI Coachella Valley';
const pageDescription = `The complete AICV node directory — ${totalNodes} geographic and concept nodes documenting the Coachella Valley's institutions, infrastructure, and intelligence layer for AI agents and search.`;
const canonicalUrl    = 'https://aicoachellavalley.com/nodes/';
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Layer · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <a href="/reports/" class="nav-link">Reports</a>
    <a href="/#aio" class="nav-link">Free AIO Tool</a>
    <a href="/nodes/node-zero" class="nav-docs-btn">Node Zero →</a>
  </div>
</nav>

<!-- ─── HEADER ─── -->
<header class="page-header">
  <div class="page-header-inner">
    <div class="page-eyebrow">AI Coachella Valley · Intelligence Layer</div>
    <h1 class="page-title">Intelligence Nodes</h1>
    <p class="page-desc">{totalNodes} intelligence nodes across the Coachella Valley — venues, institutions, and infrastructure documented for AI agents and researchers.</p>
  </div>
</header>

<!-- ─── FILTER NAV ─── -->
<div class="filter-bar">
  <div class="filter-bar-inner">
    <span class="filter-label">Browse by city</span>
    <div class="filter-links">
      <a href="/nodes/city/valley-wide/">Valley Wide</a>
      <a href="/nodes/city/rancho-mirage/">Rancho Mirage</a>
      <a href="/nodes/city/palm-desert/">Palm Desert</a>
      <a href="/nodes/city/indian-wells/">Indian Wells</a>
      <a href="/nodes/city/la-quinta/">La Quinta</a>
      <a href="/nodes/city/palm-springs/">Palm Springs</a>
      <a href="/nodes/city/indio/">Indio</a>
    </div>
    <span class="filter-divider">|</span>
    <span class="filter-label">By category</span>
    <div class="filter-links">
      <a href="/nodes/category/intelligence/">Concept Nodes</a>
      <a href="/nodes/category/hospitality/">Hospitality</a>
      <a href="/nodes/category/golf/">Golf</a>
      <a href="/nodes/category/wellness/">Wellness</a>
      <a href="/nodes/category/innovation/">Innovation</a>
      <a href="/nodes/category/economic/">Economic</a>
    </div>
  </div>
</div>

<!-- ─── NODE GROUPS ─── -->
<main class="nodes-main">
  {CITY_ORDER.map((city) => {
    const entries = byCity[city];
    if (!entries || entries.length === 0) return null;
    const citySlug = CITY_SLUG[city] ?? city.toLowerCase().replace(/\s+/g, '-');
    return (
      <section class="city-group">
        <div class="city-label">
          {CITY_LABELS[city] ?? city}
          <span class="city-count">{entries.length}</span>
          <a href={`/nodes/city/${citySlug}/`} class="city-browse">Browse all →</a>
        </div>
        <ul class="node-list">
          {entries.map((entry) => {
            const slug = entry.id.replace(/\.mdx$/, '');
            const { title, description, subcategory } = entry.data;
            return (
              <li class="node-item">
                <div class="node-top">
                  <a href={`/nodes/${slug}/`} class="node-title">{title}</a>
                  {subcategory && <span class="node-sub">{subcategory}</span>}
                </div>
                {description && <p class="node-desc">{description}</p>}
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</main>

<!-- ─── FOOTER ─── -->
<footer>
  <div class="foot-inner">
    <div class="foot-copy">
      © 2026 AI Coachella Valley · <a href="mailto:sat@aicv.co">sat@aicv.co</a>
    </div>
    <div class="foot-links">
      <a href="/">Home</a>
      <a href="/reports/">Reports</a>
      <a href="/nodes/node-zero">Node Zero</a>
      <a href="https://x.com/CoachellaAI">@CoachellaAI</a>
    </div>
  </div>
</footer>

<style is:global>
  /* ─── NAV ─── */
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 3rem;
    background: var(--gunmetal);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .nav-logo-mark {
    width: 36px;
    height: 36px;
    background: var(--volt);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 11px;
    color: var(--pine);
    flex-shrink: 0;
  }

  .nav-logo-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 2px;
  }

  .nav-logo-aicv {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--sand);
    letter-spacing: 0.04em;
  }

  .nav-logo-sub {
    font-size: 0.6rem;
    font-weight: 300;
    color: rgba(232,226,208,0.4);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.78rem;
    color: var(--sand);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .nav-link:hover { color: var(--volt); }

  .nav-docs-btn {
    background: var(--volt);
    color: var(--pine);
    padding: 0.45rem 1.1rem;
    font-family: 'Syne', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background 0.2s;
  }

  .nav-docs-btn:hover { background: #e8ff33; }

  /* ─── FILTER BAR ─── */
  .filter-bar {
    background: var(--pine-dark);
    border-bottom: 1px solid rgba(232,226,208,0.06);
    padding: 0.75rem 3rem;
  }

  .filter-bar-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--pine-light);
    font-weight: 500;
    flex-shrink: 0;
  }

  .filter-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-links a {
    font-size: 0.72rem;
    color: var(--sand);
    text-decoration: none;
    border: 1px solid rgba(232,226,208,0.12);
    padding: 3px 10px;
    border-radius: 3px;
    transition: border-color 0.15s, color 0.15s;
  }

  .filter-links a:hover {
    border-color: var(--volt);
    color: var(--volt);
  }

  .filter-divider {
    color: rgba(232,226,208,0.2);
    font-size: 0.8rem;
  }

  /* ─── PAGE HEADER ─── */
  .page-header {
    background: var(--pine-dark);
    padding: 4rem 3rem 3.5rem;
    border-bottom: 2px solid var(--pine-light);
  }

  .page-header-inner {
    max-width: 1060px;
    margin: 0 auto;
  }

  .page-eyebrow {
    font-size: 0.67rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pine-light);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--sand-light);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .page-desc {
    font-size: 0.95rem;
    color: rgba(232,226,208,0.65);
    font-weight: 300;
    max-width: 64ch;
    line-height: 1.7;
  }

  /* ─── MAIN ─── */
  .nodes-main {
    max-width: 1060px;
    margin: 0 auto;
    padding: 4rem 3rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* ─── CITY GROUP ─── */
  .city-label {
    font-family: 'Syne', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pine-light);
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--sand-dark);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .city-count {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--sand-dark);
    letter-spacing: 0;
  }

  .city-browse {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--volt);
    text-decoration: none;
    letter-spacing: 0;
    margin-left: auto;
    opacity: 0.7;
    transition: opacity 0.15s;
  }

  .city-browse:hover { opacity: 1; }

  /* ─── NODE LIST ─── */
  .node-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .node-item {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(212,204,186,0.4);
  }

  .node-item:last-child { border-bottom: none; }

  .node-top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.2rem;
  }

  .node-title {
    font-family: 'Syne', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--pine);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .node-title:hover { color: var(--pine-light); }

  .node-sub {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(27,67,50,0.35);
    flex-shrink: 0;
  }

  .node-desc {
    font-size: 0.82rem;
    color: var(--pine-light);
    font-weight: 300;
    line-height: 1.6;
    max-width: 80ch;
  }

  /* ─── FOOTER ─── */
  footer {
    background: var(--pine-dark);
    padding: 2rem 3rem;
    border-top: 1px solid rgba(232,226,208,0.06);
  }

  .foot-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .foot-copy {
    font-size: 0.72rem;
    color: rgba(232,226,208,0.5);
    font-weight: 300;
  }

  .foot-copy a {
    color: rgba(232,226,208,0.5);
    text-decoration: none;
  }

  .foot-links {
    display: flex;
    gap: 1.5rem;
  }

  .foot-links a {
    font-size: 0.72rem;
    color: rgba(232,226,208,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .foot-links a:hover { color: var(--volt); }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 860px) {
    nav { padding: 1rem 1.5rem; }
    .filter-bar { padding: 0.75rem 1.5rem; }
    .filter-divider { display: none; }
    .page-header { padding: 3rem 1.5rem 2.5rem; }
    .nodes-main { padding: 2.5rem 1.5rem 4rem; }
    footer { padding: 1.75rem 1.5rem; }
    .foot-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>

</Base>
