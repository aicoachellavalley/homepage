---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('nodes');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, '') },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.id.replace(/\.mdx$/, '');
const { title, description, city, category, subcategory, last_updated } = entry.data;

const canonicalUrl = `https://aicoachellavalley.com/nodes/${slug}/`;
const pageTitle    = `${title} — AICV Intelligence Node`;

const subcategoryLabels: Record<string, string> = {
  'hospitality':   'Hospitality',
  'golf':          'Golf',
  'wellness':      'Wellness',
  'cultural':      'Cultural',
  'entertainment': 'Entertainment',
  'economic':      'Economic',
  'education':     'Education',
  'retail':        'Retail',
  'intelligence':  'Intelligence',
  'nonprofit':     'Nonprofit',
  'real-estate':   'Real Estate',
  'innovation':    'Innovation',
};
const subcatLabel = subcategoryLabels[subcategory ?? ''] ?? subcategory ?? '';

const schemaTypeMap: Record<string, string> = {
  'hospitality': 'LocalBusiness',
  'golf': 'LocalBusiness',
  'wellness': 'LocalBusiness',
  'cultural': 'Organization',
  'entertainment': 'Organization',
  'retail': 'LocalBusiness',
  'economic': 'Organization',
  'innovation': 'Organization',
  'education': 'Organization',
  'nonprofit': 'Organization',
  'intelligence': 'Organization',
  'real-estate': 'LocalBusiness',
};

const schemaType = category === 'event'
  ? 'Event'
  : (schemaTypeMap[subcategory ?? ''] ?? 'LocalBusiness');

const schemaJson = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  'name': title,
  'description': description,
  'url': canonicalUrl,
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': city,
    'addressRegion': 'CA',
    'addressCountry': 'US'
  },
  'areaServed': {
    '@type': 'AdministrativeArea',
    'name': 'Coachella Valley'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com'
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />

  <script type="application/ld+json" set:html={JSON.stringify(schemaJson, null, 2)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <style>
    :root {
      --volt:       #D8FF00;
      --pine:       #1B4332;
      --pine-light: #2D6A4F;
      --pine-dark:  #122B22;
      --gunmetal:   #1E1E1E;
      --snow:       #F5F5F5;
      --sand:       #FAFAF7;
      --sand-light: #FFFFFF;
      --sand-dark:  #E8E5DD;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; }
    body {
      background-color: var(--sand-light);
      color: var(--pine);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3 { font-family: 'Syne', sans-serif; }

    .site-header {
      background-color: var(--pine-dark);
      border-bottom: 2px solid var(--pine-light);
      padding: 40px 24px 32px;
    }
    .site-header .inner { max-width: 760px; margin: 0 auto; }

    .node-eyebrow {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .badge {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 2px;
    }
    .badge-subcat { background: rgba(216,255,0,0.12); color: var(--volt); border: 1px solid rgba(216,255,0,0.25); }
    .badge-city   { background: rgba(255,255,255,0.08); color: var(--sand-dark); }

    .node-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--sand-light);
      line-height: 1.2;
    }

    .page-wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    /* Markdown body styles */
    .node-body h1 { display: none; } /* title already in header */
    .node-body h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin: 36px 0 12px;
      padding-top: 4px;
      border-top: 1px solid var(--sand-dark);
    }
    .node-body h3 {
      font-family: 'Syne', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--pine);
      margin: 20px 0 6px;
    }
    .node-body p {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.75;
      margin-bottom: 14px;
    }
    .node-body strong { font-weight: 600; color: var(--pine-dark); }
    .node-body em { font-style: italic; }
    .node-body ul, .node-body ol {
      margin: 0 0 16px 20px;
    }
    .node-body li {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .node-body a {
      color: var(--pine);
      text-decoration: underline;
      text-decoration-color: var(--pine-light);
    }
    .node-body a:hover { color: var(--pine-dark); }
    .node-body hr {
      border: none;
      border-top: 1px solid var(--sand-dark);
      margin: 32px 0;
    }
    .node-body blockquote {
      border-left: 3px solid var(--volt);
      padding: 8px 0 8px 18px;
      margin: 20px 0;
      background: var(--sand);
      border-radius: 0 4px 4px 0;
    }
    .node-body blockquote p { margin-bottom: 0; }

    .site-footer {
      margin-top: 60px;
      padding-top: 24px;
      border-top: 1px solid var(--sand-dark);
      font-size: 0.8rem;
      color: var(--pine-light);
      line-height: 1.7;
    }
    .site-footer a { color: var(--pine); text-decoration: none; }
    .site-footer a:hover { text-decoration: underline; }

    @media (max-width: 640px) {
      .node-title { font-size: 1.5rem; }
      .site-header { padding: 28px 20px 24px; }
    }
  </style>
</head>
<body>

<nav style="background:var(--color-gunmetal,#1a1a2e);padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;">
  <a href="/" style="color:var(--color-snow,#f5f5f5);font-weight:700;font-size:1rem;text-decoration:none;letter-spacing:0.02em;">AICV</a>
  <div style="display:flex;gap:1.5rem;align-items:center;">
    <a href="/nodes/" style="color:var(--color-snow,#f5f5f5);font-size:0.875rem;text-decoration:none;opacity:0.8;">Nodes</a>
    <a href="/briefs/" style="color:var(--color-snow,#f5f5f5);font-size:0.875rem;text-decoration:none;opacity:0.8;">Briefs</a>
    <a href="/get-agent-ready/#diagnostic" style="color:var(--color-volt,#d4ff00);font-size:0.875rem;text-decoration:none;font-weight:600;">Agent Preview</a>
  </div>
</nav>

<a href="/nodes/" style="display:inline-block;margin:1.5rem 2rem 0;color:var(--color-volt,#d4ff00);font-size:0.875rem;text-decoration:none;opacity:0.8;">← All Nodes</a>

  <header class="site-header">
    <div class="inner">
      <div class="node-eyebrow">
        {subcatLabel && <span class="badge badge-subcat">{subcatLabel}</span>}
        {city && <span class="badge badge-city">{city}</span>}
      </div>
      <h1 class="node-title">{title}</h1>
    </div>
  </header>

  <div class="page-wrap">
    <div class="node-body">
      <Content />
    </div>

    <footer style="margin-top:4rem;padding:2rem;border-top:1px solid rgba(255,255,255,0.1);text-align:center;font-size:0.8rem;opacity:0.5;">
      <p>AI Coachella Valley · <a href="https://aicoachellavalley.com" style="color:inherit;">aicoachellavalley.com</a> · <a href="/nodes/" style="color:inherit;">Nodes</a> · <a href="/briefs/" style="color:inherit;">Briefs</a></p>
      {last_updated && <p style="margin-top:0.5rem;">Last reviewed: {last_updated}</p>}
    </footer>
  </div>

</body>
</html>
