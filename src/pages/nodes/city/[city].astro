---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

function toCitySlug(city: string): string {
  const s = city.trim().toLowerCase().replace(/-/g, ' ');
  if (s === 'valley wide' || s === 'coachella valley') return 'valley-wide';
  return s.replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
}

const CITY_LABELS: Record<string, string> = {
  'valley-wide':          'Valley Wide',
  'rancho-mirage':        'Rancho Mirage',
  'palm-desert':          'Palm Desert',
  'indian-wells':         'Indian Wells',
  'la-quinta':            'La Quinta',
  'palm-springs':         'Palm Springs',
  'indio':                'Indio',
  'coachella':            'Coachella',
  'adjacent-communities': 'Adjacent Communities',
  'pioneertown':          'Pioneertown',
  'thermal':              'Thermal',
};

export async function getStaticPaths() {
  function toCitySlug(city: string): string {
    const s = city.trim().toLowerCase().replace(/-/g, ' ');
    if (s === 'valley wide' || s === 'coachella valley') return 'valley-wide';
    return s.replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
  }

  const allNodes = await getCollection('nodes');
  const cityGroups: Record<string, typeof allNodes> = {};
  for (const node of allNodes) {
    if (!node.data.city) continue;
    const slug = toCitySlug(node.data.city);
    if (!cityGroups[slug]) cityGroups[slug] = [];
    cityGroups[slug].push(node);
  }
  return Object.entries(cityGroups).map(([citySlug, nodes]) => ({
    params: { city: citySlug },
    props: {
      nodes: nodes.sort((a, b) => a.data.title.localeCompare(b.data.title)),
      citySlug,
    },
  }));
}

const { nodes, citySlug } = Astro.props;
const cityLabel = CITY_LABELS[citySlug] ?? citySlug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
const pageTitle = `${cityLabel} Intelligence Nodes — AI Coachella Valley`;
const pageDescription = `All AICV intelligence nodes in ${cityLabel} — ${nodes.length} nodes documenting the institutions, infrastructure, and economic signals of this Coachella Valley region.`;
const canonicalUrl = `https://aicoachellavalley.com/nodes/city/${citySlug}/`;
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <a href="/reports/" class="nav-link">Reports</a>
    <a href="/get-agent-ready/#diagnostic" class="nav-link">Agent Preview</a>
    <a href="/nodes/node-zero" class="nav-docs-btn">Node Zero →</a>
  </div>
</nav>

<!-- ─── HEADER ─── -->
<header class="page-header">
  <div class="page-header-inner">
    <div class="page-eyebrow">
      <a href="/nodes/" class="breadcrumb-link">Intelligence Nodes</a>
      {' → '}
      {cityLabel}
    </div>
    <h1 class="page-title">{cityLabel}</h1>
    <p class="page-desc">{nodes.length} node{nodes.length !== 1 ? 's' : ''} in the AICV intelligence layer</p>
  </div>
</header>

<!-- ─── NODE LIST ─── -->
<main class="nodes-main">
  <div class="node-grid">
    {nodes.map((node) => {
      const slug = node.id.replace(/\.mdx$/, '');
      return (
        <a href={`/nodes/${slug}/`} class="node-card">
          <div class="node-card-top">
            <span class="node-card-title">{node.data.title}</span>
            {node.data.subcategory && (
              <span class="node-card-sub">{node.data.subcategory}</span>
            )}
          </div>
          {node.data.agent_summary && (
            <p class="node-card-summary">{node.data.agent_summary}</p>
          )}
        </a>
      );
    })}
  </div>
  <div class="back-row">
    <a href="/nodes/" class="back-link">← All nodes</a>
  </div>
</main>

<!-- ─── FOOTER ─── -->
<footer>
  <div class="foot-inner">
    <div class="foot-copy">
      © 2026 AICV · <a href="mailto:sat@aicv.co">sat@aicv.co</a>
    </div>
    <div class="foot-links">
      <a href="/">Home</a>
      <a href="/nodes/">Nodes</a>
      <a href="/reports/">Reports</a>
      <a href="https://x.com/CoachellaAI">@CoachellaAI</a>
    </div>
  </div>
</footer>

<style is:global>
  /* ─── NAV ─── */
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 3rem;
    background: var(--gunmetal);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
  .nav-logo-mark {
    width: 36px; height: 36px; background: var(--volt);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif; font-weight: 800; font-size: 11px;
    color: var(--pine); flex-shrink: 0;
  }
  .nav-logo-words { display: flex; flex-direction: column; line-height: 1; gap: 2px; }
  .nav-logo-aicv { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 0.9rem; color: var(--sand); letter-spacing: 0.04em; }
  .nav-logo-sub { font-size: 0.6rem; font-weight: 300; color: rgba(232,226,208,0.4); letter-spacing: 0.08em; text-transform: uppercase; }
  .nav-right { display: flex; align-items: center; gap: 1.5rem; }
  .nav-link { font-size: 0.78rem; color: var(--sand); text-decoration: none; letter-spacing: 0.03em; transition: color 0.2s; }
  .nav-link:hover { color: var(--volt); }
  .nav-docs-btn {
    background: var(--volt); color: var(--pine); padding: 0.45rem 1.1rem;
    font-family: 'Syne', sans-serif; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.08em; text-decoration: none; transition: background 0.2s;
  }
  .nav-docs-btn:hover { background: #e8ff33; }

  /* ─── PAGE HEADER ─── */
  .page-header {
    background: var(--pine-dark);
    padding: 4rem 3rem 3.5rem;
    border-bottom: 2px solid var(--pine-light);
  }
  .page-header-inner { max-width: 1060px; margin: 0 auto; }
  .page-eyebrow {
    font-size: 0.67rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--pine-light); font-weight: 500; margin-bottom: 1rem;
  }
  .breadcrumb-link { color: var(--volt); text-decoration: none; }
  .breadcrumb-link:hover { text-decoration: underline; }
  .page-title {
    font-family: 'Syne', sans-serif; font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.25rem); color: var(--sand-light);
    letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 1rem;
  }
  .page-desc { font-size: 0.95rem; color: rgba(232,226,208,0.65); font-weight: 300; line-height: 1.7; }

  /* ─── MAIN ─── */
  .nodes-main { max-width: 1060px; margin: 0 auto; padding: 3rem 3rem 5rem; }

  /* ─── NODE GRID ─── */
  .node-grid { display: flex; flex-direction: column; gap: 2px; margin-bottom: 3rem; }
  .node-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid rgba(232,226,208,0.06);
    border-radius: 4px;
    text-decoration: none;
    display: block;
    transition: border-color 0.15s, background 0.15s;
  }
  .node-card:hover { border-color: rgba(232,226,208,0.18); background: rgba(27,67,50,0.15); }
  .node-card-top { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.35rem; }
  .node-card-title {
    font-family: 'Syne', sans-serif; font-size: 0.95rem; font-weight: 600;
    color: var(--sand); letter-spacing: -0.01em;
  }
  .node-card-sub {
    font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--volt); opacity: 0.7;
  }
  .node-card-summary { font-size: 0.82rem; color: rgba(232,226,208,0.5); font-weight: 300; line-height: 1.55; }

  /* ─── BACK ─── */
  .back-row { padding-top: 1rem; }
  .back-link { font-size: 0.85rem; color: var(--volt); text-decoration: none; opacity: 0.8; }
  .back-link:hover { opacity: 1; }

  /* ─── FOOTER ─── */
  footer { background: var(--pine-dark); padding: 2rem 3rem; border-top: 1px solid rgba(232,226,208,0.06); }
  .foot-inner { max-width: 1060px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .foot-copy { font-size: 0.72rem; color: rgba(232,226,208,0.5); font-weight: 300; }
  .foot-copy a { color: rgba(232,226,208,0.5); text-decoration: none; }
  .foot-links { display: flex; gap: 1.5rem; }
  .foot-links a { font-size: 0.72rem; color: rgba(232,226,208,0.5); text-decoration: none; transition: color 0.2s; }
  .foot-links a:hover { color: var(--volt); }

  @media (max-width: 860px) {
    nav { padding: 1rem 1.5rem; }
    .page-header { padding: 3rem 1.5rem 2.5rem; }
    .nodes-main { padding: 2rem 1.5rem 4rem; }
    footer { padding: 1.75rem 1.5rem; }
    .foot-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>

</Base>
