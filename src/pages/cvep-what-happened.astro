---
/**
 * /cvep-what-happened/ — thin renderer over the `records` collection.
 *
 * Shape B: this file owns the route, the markup and the @graph SHAPE. The
 * record itself — title, description, dates, the 13 questions and the two
 * source citations — lives in src/content/records/cvep-what-happened.mdx and
 * is pulled through getEntry. Nothing factual is duplicated here.
 */
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('records', 'cvep-what-happened');
if (!entry) throw new Error('records/cvep-what-happened is missing — refusing to build an empty record page');
const { Content } = await render(entry);
const { title, description, datePublished, dateModified, faq, sources } = entry.data;

/* Route identity. Deliberately a page constant, not record data: the record
   could in principle be rendered elsewhere, but THIS route is what every other
   surface links to. */
const canonicalUrl = 'https://aicoachellavalley.com/cvep-what-happened/';

const pageTitle = `${title} — AICV`;
const pageDescription = description;

/* Dates are derived from the ISO values, never carried twice. String-split
   rather than Date() so no timezone can shift a day. Two forms because the
   page uses two: "July 31, 2026" in the standfirst, "May 27 2026" in the
   sources line. */
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const dparts = (iso: string) => { const [y, m, d] = iso.split('-'); return { y, m: MONTHS[Number(m) - 1], d: String(Number(d)) }; };
const longDate   = (iso: string) => { const p = dparts(iso); return `${p.m} ${p.d}, ${p.y}`; };
const sourceDate = (iso: string) => { const p = dparts(iso); return `${p.m} ${p.d} ${p.y}`; };

const CVEP_ID = `${canonicalUrl}#cvep-organization`;
const citeId = (s: { id: string }) => `${canonicalUrl}#${s.id}`;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://aicoachellavalley.com/#website",
        "url": "https://aicoachellavalley.com/",
        "name": "AI Coachella Valley"
      },
      "inLanguage": "en-US",
      "datePublished": datePublished,
      "dateModified": dateModified,
      /* The page is ABOUT CVEP. `about` points at a CVEP Organization node with
         its own @id, scoped to this URL — deliberately never the AICV
         organization node, and never markup that could be read as CVEP
         publishing this itself. */
      "about": { "@id": CVEP_ID },
      "publisher": { "@id": "https://aicoachellavalley.com/#organization" },
      "citation": sources.map((s) => ({ "@id": citeId(s) }))
    },
    {
      /* The subject. A dissolved organization described by a third party.
         AICV is the publisher; this node is the topic. */
      "@type": "Organization",
      "@id": CVEP_ID,
      "name": "Coachella Valley Economic Partnership",
      "legalName": "Coachella Valley Economic Partnership",
      "alternateName": "CVEP",
      "description": "A 501(c)(3) nonprofit regional economic development organization serving California's Coachella Valley from 1994 until it wound down in 2025 and filed for Chapter 7 bankruptcy in March 2026.",
      "disambiguatingDescription": "Dissolved. The executive committee voted to dissolve in 2025; Chapter 7 bankruptcy was filed March 28, 2026 and the case closed May 5, 2026 with creditors paid nothing. This organization is no longer operating. Directory listings that still present it as active are out of date.",
      "foundingDate": "1994",
      /* NO dissolutionDate. We can source a Chapter 7 FILING date (2026-03-28)
         and a case-CLOSING date (2026-05-05). Neither is a dissolution date —
         California nonprofit dissolution is a separate state filing we have no
         evidence of. Same standard applied to nonprofitStatus and
         numberOfEmployees: leave out what cannot be verified.
         It would also undercut the page: the "when did CVEP shut down" answer
         exists to explain why one date is wrong, and a single machine-readable
         dissolutionDate hands agents exactly the flattened version the prose
         argues against. Both dates stay in the visible copy, where they are
         explained. */
      "areaServed": {
        "@type": "Place",
        "name": "Coachella Valley, California"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://aicoachellavalley.com/#organization",
      "name": "AI Coachella Valley",
      "url": "https://aicoachellavalley.com/"
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "isPartOf": { "@id": `${canonicalUrl}#webpage` },
      "about": { "@id": CVEP_ID },
      "mainEntity": faq.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    },
    ...sources.map((s) => ({
      "@type": "NewsArticle",
      "@id": citeId(s),
      "url": s.url,
      "author": { "@type": "Person", "name": s.author },
      "datePublished": s.publicationDate,
      "publisher": { "@type": "Organization", "name": s.publisher }
    })),
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumbs`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aicoachellavalley.com/" },
        { "@type": "ListItem", "position": 2, "name": "CVEP: What Happened", "item": canonicalUrl }
      ]
    }
  ]
};
---

<Base title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={schemaGraph}>

<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Network</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
    </div>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<main class="cvep">
  <div class="cvep-inner">

    <header class="cvep-head">
      <div class="cvep-eyebrow">AICV · Factual Record</div>
      <h1 class="cvep-h1">{title}</h1>
      <p class="cvep-standfirst">A factual record, compiled from court reporting and primary sources. Last verified <time datetime={dateModified}>{longDate(dateModified)}</time>.</p>
      <p class="cvep-sources">
        Sources: {sources.map((s, i) => (
          <Fragment>
            {i > 0 && <Fragment> · </Fragment>}
            <a href={s.url} rel="nofollow noopener" target="_blank">{s.author}, {s.publisher}, {sourceDate(s.publicationDate)}</a>
          </Fragment>
        ))}
      </p>
    </header>

    {faq.map((f) => (
      <section class="cvep-q">
        <h2 class="cvep-h2">{f.question}</h2>
        <p class="cvep-a">{f.answer}</p>
      </section>
    ))}

    {/* A <div>, not a <footer>: the site-wide `footer` rule below paints the
        real page footer dark, and a second <footer> element would inherit it. */}
    <div class="cvep-foot">
      <Content />
    </div>

  </div>
</main>

<footer>
  <div class="foot-inner">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="foot-mark">AICV</div>
        <div class="foot-name">AI Coachella Valley</div>
        <div class="foot-full">
          Intelligence Network · Est. 2025<br>
          Coachella Valley, California<br>
          Built for agents. Powered by humans.<br>
          A fiscally sponsored project of Desert Community Foundation, a 501(c)(3) nonprofit organization.
        </div>
      </div>
      <div>
        <div class="foot-cities-label">Serving the Coachella Valley</div>
        <div class="foot-cities">
          Palm Springs<span class="foot-sep">·</span>
          Desert Hot Springs<span class="foot-sep">·</span>
          Cathedral City<span class="foot-sep">·</span>
          Rancho Mirage<span class="foot-sep">·</span>
          Palm Desert<span class="foot-sep">·</span>
          Indian Wells<span class="foot-sep">·</span>
          La Quinta<span class="foot-sep">·</span>
          Indio<span class="foot-sep">·</span>
          Coachella<span class="foot-sep">·</span>
          Bermuda Dunes<span class="foot-sep">·</span>
          Thousand Palms<span class="foot-sep">·</span>
          Mecca<span class="foot-sep">·</span>
          Thermal<span class="foot-sep">·</span>
          Desert Center
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <div class="foot-copy">
        © 2026 AICV · Established 2025 · Coachella Valley, California<br>
        Built for agents. Powered by humans. · <a href="mailto:sat@aicv.co" style="color:rgba(232,226,208,0.6);text-decoration:none;">sat@aicv.co</a>
      </div>
      <div class="foot-links">
        <a href="/nodes/">Intelligence Network</a>
        <a href="/briefs/">Briefs</a>
        <a href="/reports/">Reports</a>
        <a href="https://sunshine.fm">SunshineFM</a>
        <a href="/get-agent-ready/#diagnostic">Agent Preview</a>
        <a href="https://x.com/CoachellaAI">@CoachellaAI</a>
        <a href="https://github.com/aicoachellavalley">GitHub</a>
        <a href="/terms/">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* ─── NAV ─── */
  nav { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 3rem; background:var(--gunmetal); position:sticky; top:0; z-index:50; }
  .nav-logo { display:flex; align-items:center; gap:0.75rem; text-decoration:none; }
  .nav-logo-mark { width:36px; height:36px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); letter-spacing:0.02em; flex-shrink:0; }
  .nav-logo-words { display:flex; flex-direction:column; line-height:1; gap:2px; }
  .nav-logo-aicv { font-family:'Syne',sans-serif; font-weight:800; font-size:0.9rem; color:var(--sand); letter-spacing:0.04em; }
  .nav-logo-sub { font-size:0.6rem; font-weight:300; color:rgba(232,226,208,0.4); letter-spacing:0.08em; text-transform:uppercase; }
  .nav-right { display:flex; align-items:center; gap:1.5rem; }
  .nav-links { display:flex; align-items:center; gap:1.75rem; }
  .nav-links a { font-size:0.78rem; color:var(--sand); text-decoration:none; letter-spacing:0.03em; transition:color 0.2s; }
  .nav-links a:hover { color:var(--volt); }
  .nav-aio-btn { font-size:0.72rem; color:var(--sand); text-decoration:none; border:1px solid rgba(232,226,208,0.25); padding:0.4rem 0.9rem; letter-spacing:0.04em; transition:all 0.2s; font-weight:500; }
  .nav-aio-btn:hover { background:var(--volt); color:var(--pine); border-color:var(--volt); }
  .nav-docs-btn { background:var(--volt); color:var(--pine); padding:0.45rem 1.1rem; font-family:'Syne',sans-serif; font-size:0.72rem; font-weight:700; text-decoration:none; letter-spacing:0.04em; transition:background 0.2s; }
  .nav-docs-btn:hover { background:var(--pine-tint); }

  /* ─── FOOTER ─── */
  footer { background:var(--pine-dark); padding:4rem 3rem 2.5rem; }
  .foot-inner { max-width:1060px; margin:0 auto; padding:0 48px; }
  .foot-top { display:grid; grid-template-columns:220px 1fr; gap:4rem; padding-bottom:2.5rem; border-bottom:1px solid rgba(232,226,208,0.08); margin-bottom:2rem; }
  .foot-mark { width:38px; height:38px; background:var(--volt); display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; font-weight:800; font-size:11px; color:var(--pine); margin-bottom:0.875rem; }
  .foot-name { font-family:'Syne',sans-serif; font-weight:700; font-size:0.88rem; color:var(--sand); margin-bottom:0.3rem; }
  .foot-full { font-size:0.7rem; color:rgba(232,226,208,0.6); font-weight:300; line-height:1.6; }
  .foot-cities-label { font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(232,226,208,0.6); margin-bottom:1rem; font-weight:500; }
  .foot-cities { font-size:0.8rem; color:rgba(232,226,208,0.4); font-weight:300; line-height:2; }
  .foot-sep { color:rgba(232,226,208,0.15); margin:0 0.4rem; }
  .foot-bottom { display:flex; align-items:center; justify-content:space-between; gap:2rem; }
  .foot-copy { font-size:0.72rem; color:rgba(232,226,208,0.6); font-weight:300; line-height:1.6; }
  .foot-links { display:flex; gap:1.75rem; align-items:center; flex-wrap:wrap; }
  .foot-links a { font-size:0.72rem; color:rgba(232,226,208,0.6); text-decoration:none; transition:color 0.2s; letter-spacing:0.02em; }
  .foot-links a:hover { color:var(--volt); }

  /* ─── CVEP RECORD PAGE ─── */
  .cvep {
    background: var(--sand);
    color: var(--pine);
    padding: 3.5rem 1.5rem 5rem;
  }
  /* A reading measure, deliberately narrower than the site's 1060px shell —
     this page is a long-form Q&A record, not a landing page. */
  .cvep-inner { max-width: 44rem; margin: 0 auto; }

  /* TYPE — every declaration below the comment in each rule is copied verbatim
     from how-we-do-this.astro's own block (.hwd-eyebrow / .hwd-h1 / .hwd-def /
     .hwd-h2 / .hwd-body). Where this page's narrower column needs a different
     LAYOUT value, the override follows the copied block and says so. */
  .cvep-eyebrow {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    color: var(--pine);
    margin-bottom: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .cvep-h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -3px;
    color: var(--pine-dark);
    margin: 0 0 32px;
  }
  .cvep-standfirst {
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    line-height: 1.65;
    color: var(--pine);
    max-width: 620px;
    margin: 0;
    /* overrides .hwd-def's `margin: 0` — the sources line follows this one */
    margin: 0 0 .55rem;
  }
  .cvep-h2 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    color: var(--pine-dark);
    margin: 0 0 28px;
    max-width: 680px;
  }
  .cvep-a {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--pine);
    max-width: 640px;
    margin: 0 0 1.25rem;
  }
  /* .hwd-body:last-child in how-we-do-this. .cvep-a is always the last child
     of its section, so this zeroes the copied trailing margin. */
  .cvep-a:last-child { margin-bottom: 0; }

  .cvep-sources {
    font-family: 'DM Sans', sans-serif;
    font-size: .86rem;
    line-height: 1.7;
    margin: 0;
    opacity: .8;
  }
  .cvep-sources a { color: var(--pine); }

  /* --pine at 18% via color-mix rather than a hardcoded rgba(27,67,50,…):
     27,67,50 IS #1B4332 IS var(--pine), and tokens.css carries no alpha or
     rule token that substitutes as a bare var(). Same pixels, one source. */
  .cvep-head {
    padding-bottom: 2.2rem;
    margin-bottom: .6rem;
    border-bottom: 2px solid color-mix(in srgb, var(--pine) 18%, transparent);
  }

  .cvep-q { padding-top: 2.3rem; }

  .cvep-foot {
    margin-top: 3.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--pine) 18%, transparent);
    font-size: .94rem;
    line-height: 1.72;
    opacity: .88;
  }
  .cvep-foot p { margin: 0; max-width: 40rem; }

  /* Responsive — the nav and footer rules are the site's own 860px block; the
     nav collapses its link list here, so this breakpoint is not optional once
     the nav CSS is present. */
  @media (max-width: 860px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    footer { padding: 2.5rem 0 2rem; }
    .foot-inner { padding: 0 1.5rem; }
    .foot-top { grid-template-columns: 1fr; gap: 2rem; }
    .foot-bottom { flex-direction: column; align-items: flex-start; }
    /* matches .hwd-inner's 1.5rem gutter at this breakpoint */
    .cvep { padding: 2.5rem 1.5rem 3.5rem; }
  }

  /* Retuned for the shared scale. The old rule also cut the gutter to 1.15rem,
     which was sized for the previous half-size type and is too tight for a
     56px h1 — the gutter now comes from the 860px block above. */
  @media (max-width: 640px) {
    .cvep-q { padding-top: 1.9rem; }
  }
</style>

</Base>
