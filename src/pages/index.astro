---
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';
import briefsData from '../../public/briefs.json';
import reportsData from '../../public/reports.json';
import corpus from '../data/corpus.json';
import pricing from '../data/pricing.json';
import org from '../data/org.json';
import deployed from '../data/previews-deployed.json';
import { latestFromAicvNews, AICV_NEWS } from '../lib/aicv-news';
const previewManifests = import.meta.glob('../data/previews/previews-index-*.json', { eager: true });

/* Derived, never literal — and derived from what is SERVING, not what was
 * built. The manifests are build artifacts: one appears the moment a tranche
 * is built, whether or not anyone deployed it, so summing them all counts
 * pages that may be unreachable. `previews-deployed.json` names the segments
 * actually serving; a built-but-undeployed tranche is absent there and is not
 * counted. The cell says "live", so it must not be able to over-claim.
 *
 * Throws rather than under-counting on a typo: a segment named as deployed
 * with no manifest beside it means the two sources disagree, and silently
 * contributing 0 would read as a smaller corpus rather than as a defect. */
const manifestBySegment = new Map(
  Object.entries(previewManifests).map(([path, m]) => [
    path.match(/previews-index-(.+)\.json$/)[1],
    m.default,
  ])
);
const previewsLive = deployed.segments.reduce((n, seg) => {
  const m = manifestBySegment.get(seg);
  if (!m) throw new Error(`previews-deployed.json lists "${seg}" but no previews-index-${seg}.json exists.`);
  return n + (m.count ?? 0);
}, 0);
const businessesMapped = corpus.businesses_mapped;

/* EVERY stat cell formats through this one function. Applying it per-cell is
 * what produced the defect it fixes: `businessesMapped` carried
 * .toLocaleString() and `previewsLive` did not, so the bar rendered "1568"
 * beside "2,914". Briefs (174) and Reports (13) render identically with or
 * without it today — they are included because Briefs climbs, and on crossing
 * 1,000 it would reproduce exactly this. A new cell inherits the format
 * instead of having to remember it. */
const stat = (n) => n.toLocaleString('en-US');

// Bar shape RULED 2026-07-25: exactly four cells — Briefs · Reports ·
// Businesses Mapped · Live Agent Previews. The grid is repeat(4,1fr) desktop
// and 1fr 1fr phone, so a fifth cell orphans on both. Nodes keep their page
// and nav presence; they left the headline bar ("Regional Nodes" is internal
// vocabulary, and Reports are the original-research signal).

const briefCount = briefsData.length;
const latestBriefs = briefsData.slice(0, 3);
// SUBSCRIBER BAND (founder ruling 2026-09-14): aicv.news is the origin, this
// site pulls from it. Three newest pieces across News, Views and Field Notes,
// outbound. Empty on feed failure — the section then does not render at all.
const aicvNews = await latestFromAicvNews(3);
const fmtNews = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// DISPLAY-ONLY filter. reports.json keeps all 13 entries — the surface-health
// monitor asserts three-way agreement on that feed, so it must not change. The
// homepage labels this cell "Reports Published", and the evergreen methodology
// page is not a Report, so it is excluded from the DISPLAYED number only.
const reportCount = reportsData.filter((r) => r.report_type !== 'methodology').length;

/* The "Updated <date>" line was DELETED 2026-08-19, along with the
 * `dateModified` it shared. Both read `stats.generated_at`, which is stamped
 * by scripts/generate-stats.mjs on every build — so the page asserted freshness
 * that any rebuild would refresh whether or not a single number had changed.
 * A build clock is not a data-change date. Nothing replaced it: the honest
 * per-datum dates already live beside their data (`corpus.updated`, each
 * manifest's `generated`, previews-deployed.json's `deployed_at`), and one
 * banner date over four independently-dated cells could only ever be wrong for
 * three of them. */

const pageTitle = 'AI Coachella Valley — The Intelligence Network for the Coachella Valley';
const pageDescription = 'AI Coachella Valley (AICV) is the intelligence network helping businesses, venues, institutions, and civic assets across the Coachella Valley become easier for AI systems to understand, cite, recommend, and route. Built for agents. Powered by humans.';
const canonicalUrl = 'https://aicoachellavalley.com/';
const ogImage = 'https://aicoachellavalley.com/learn-to-get-agent-ready-blueprint.png';

/* CANONICAL LEGAL ENTITY — same @id as the nodes in get-agent-ready.astro and
 * aiqna/index.astro, so consumers resolve all three to ONE entity. Restated
 * per document because JSON-LD is processed per document. AICV is a brand,
 * not a legal entity; legalName belongs to the LLC, never to AICV. */
const llcSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://aicoachellavalley.com/#llc",
  "name": "SunshineFM LLC",
  "legalName": "SunshineFM LLC"
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AI Coachella Valley",
  "alternateName": "AICV",
  "parentOrganization": { "@id": "https://aicoachellavalley.com/#llc" },
  "url": "https://aicoachellavalley.com",
  "logo": "https://aicoachellavalley.com/logo.png",
  "description": org.description,
  "foundingDate": "2025-01-19",
  "foundingLocation": {
    "@type": "Place",
    "name": "Coachella Valley, California"
  },
  "areaServed": {
    "@type": "Place",
    "name": "Coachella Valley, California",
    "containsPlace": [
      {"@type": "City", "name": "Palm Springs"},
      {"@type": "City", "name": "Desert Hot Springs"},
      {"@type": "City", "name": "Cathedral City"},
      {"@type": "City", "name": "Rancho Mirage"},
      {"@type": "City", "name": "Palm Desert"},
      {"@type": "City", "name": "Indian Wells"},
      {"@type": "City", "name": "La Quinta"},
      {"@type": "City", "name": "Indio"},
      {"@type": "City", "name": "Coachella"}
    ]
  },
  "knowsAbout": [
    "Artificial Intelligence",
    "AI economic development",
    "AI agent infrastructure",
    "Coachella Valley AI economy",
    "Machine-readable regional intelligence"
  ],
  "location": {
    "@type": "Place",
    "name": "Entrepreneurship Resource Center",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "37023 Cook Street",
      "addressLocality": "Palm Desert",
      "addressRegion": "CA",
      "postalCode": "92211",
      "addressCountry": "US"
    }
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "sat@aicv.co",
    "contactType": "General Inquiry"
  },
  "founder": {
    "@type": "Person",
    "name": "Sat Singh",
    "jobTitle": "Founder"
  },
  "sameAs": [
    "https://x.com/CoachellaAI",
    "https://github.com/aicoachellavalley",
    "https://sunshinefm.beehiiv.com",
    "https://aicoachellavalley.org"
  ]
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AI Coachella Valley",
  "url": "https://aicoachellavalley.com",
  "description": "The intelligence network for the Coachella Valley. Built for agents. Powered by humans. AI Coachella Valley helps businesses, venues, institutions, and civic assets become easier for AI systems to understand, cite, and route. AICV provides structured regional nodes, intelligence briefs and reports, and Agent Preview — a free diagnostic that shows how visible any website is to AI agents.",
  "publisher": {
    "@type": "Organization",
    "name": "AI Coachella Valley"
  }
};

/* SERVICE (rewritten 2026-09-22). This block described two FREE services
 * ("Get Included" node profiles and "Submit a Brief") that no longer exist,
 * contradicting the paid ladder on /get-agent-ready/. Offers now derive from
 * src/data/pricing.json, the pricing single source, so they cannot drift. */
const readyTier = pricing.tiers.find((t) => t.id === 'agent-ready');
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Get Agent Ready",
  "url": "https://aicoachellavalley.com/get-agent-ready/",
  "provider": { "@id": "https://aicoachellavalley.com/#organization" },
  "serviceType": "AI agent readiness for Coachella Valley businesses",
  "description": "AI Coachella Valley helps Coachella Valley businesses become readable to AI assistants and agents. It starts with Agent Preview, a free check of how an AI agent reads one public web page, and continues with Agent Ready, which builds the business a Minimum Viable Agent (MVA): an agent-readable public profile on the AICV network. Inclusion in AICV research is never for sale.",
  "areaServed": {
    "@type": "Place",
    "name": "Coachella Valley, California"
  },
  "offers": pricing.tiers.map((t) => ({
    "@type": "Offer",
    "name": t.name,
    "price": (t.onetime || t.annual).toFixed(2),
    "priceCurrency": "USD",
    "description": `${t.blurb} ${t.price_main}${t.price_sub ? `, ${t.price_sub}` : ''}.`,
    "url": "https://aicoachellavalley.com/get-agent-ready/"
  }))
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Agent Preview?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Agent Preview is a free diagnostic from AI Coachella Valley that shows how AI agents and large language models read a website. It reviews four dimensions — identity, structure, substance, and credibility — and returns a plain-English verdict (Invisible, Partly Visible, or Visible to AI) with up to three specific, actionable fixes, stamped with the date of the review."
      }
    },
    {
      "@type": "Question",
      "name": "Is Agent Preview free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Agent Preview is free and requires no account. Enter any public URL and receive an Agent Preview with a plain-English verdict and prioritized fixes. Nothing is stored."
      }
    },
    {
      "@type": "Question",
      "name": "Who built Agent Preview?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Agent Preview was built by AI Coachella Valley (AICV), founded by Sat Singh and based in Palm Desert, serving the nine cities of the Coachella Valley. AICV is a product and service of SunshineFM LLC."
      }
    },
    {
      "@type": "Question",
      "name": "What does AI Coachella Valley do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI Coachella Valley publishes a structured, citation-grade dataset of Coachella Valley entities — hotels, restaurants, cultural institutions, civic bodies, and founders — built for AI agents and large language models to read, cite, and recommend. Content is published as regional nodes, intelligence briefs, snapshots, and reports."
      }
    },
    {
      "@type": "Question",
      "name": "How does a business get included in the AI Coachella Valley network?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `No application is needed, and inclusion in AICV research is never for sale: each census counts every business AICV can find in a category. A business that wants its own agent-readable profile, a Minimum Viable Agent (MVA), can buy ${readyTier.name} for ${readyTier.price_main} at aicoachellavalley.com/get-agent-ready/. Questions go to sat@aicv.co.`
      }
    },
    {
      "@type": "Question",
      "name": "Which cities does AI Coachella Valley cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI Coachella Valley covers the nine cities of the Coachella Valley: Palm Springs, Desert Hot Springs, Cathedral City, Rancho Mirage, Palm Desert, Indian Wells, La Quinta, Indio, and Coachella."
      }
    }
  ]
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sat Singh",
  "jobTitle": "Founder",
  "worksFor": {
    "@type": "Organization",
    "name": "AI Coachella Valley",
    "url": "https://aicoachellavalley.com"
  },
  "url": "https://aicoachellavalley.com",
  "email": "sat@aicv.co",
  "sameAs": [
    "https://www.linkedin.com/in/satssp/",
    "https://x.com/CoachellaAI",
    "https://github.com/aicoachellavalley"
  ]
};

// The "AICV Founding Members" Dataset node that sat here was DELETED
// 2026-09-08 (founder ruling: "No founding members exist"). With it, nothing
// under AICV asserts a founding cohort or the number 111 to any agent. Do not
// reintroduce a founding/cohort/members node on this page.
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  schema={[llcSchema, orgSchema, webSiteSchema, serviceSchema, faqSchema, personSchema]}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Network · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/nodes/node-zero">Intelligence Network</a>
      <a href="/minimum-viable-agent/">MVAs</a>
      <a href="/briefs/">Briefs</a>
      <a href="/reports/">Reports</a>
    </div>
    <a href="/get-agent-ready/#diagnostic" class="nav-aio-btn">Get Agent Ready →</a>
    <a href="/nodes/" class="nav-docs-btn">Open Docs →</a>
  </div>
</nav>

<!-- ─── HERO ─── -->
<section class="hero">
  <picture class="hero-landscape" aria-hidden="true">
    <source media="(max-width: 700px)" srcset="/hero-network-960.webp">
    <img src="/hero-network-1920.webp" width="1920" height="1080" alt="" fetchpriority="high" decoding="async">
  </picture>
  <div class="hero-inner">
  <div class="hero-eyebrow">
    <span class="eyebrow-pip"></span>
    Coachella Valley, California · Est. 2025
  </div>
  <h1 class="hero-headline">The Intelligence Network<br> for the Coachella Valley</h1>
  <p class="hero-tagline">Designed for the AI Era / <strong>Built for agents. Powered by humans.</strong></p>
  <div class="hero-support-block">
    <p class="hero-support">AICV helps local businesses, venues, institutions, and civic assets become easier for AI systems to understand, cite, recommend, and route.</p>
    <p class="hero-support">Through Minimum Viable Agents, structured nodes, regional briefs, and the AICV Network, AICV is building the agent-readable network for the Coachella Valley.</p>
    <p class="hero-support">AICV is not building another directory. Directories list businesses. AICV structures regional intelligence so AI systems can understand relationships, relevance, geography, intent, and decision context.</p>
  </div>
  </div>
</section>

<!-- ─── FOCAL BLOCK: STATS + BLUEPRINT ─── -->
<section class="focal-block">
  <div class="stats-inner">
    <div class="stat-cell">
      <div class="stat-n">{stat(briefCount)}</div>
      <div class="stat-l">AICV Intelligence<br>Briefs Published</div>
    </div>
    <div class="stat-cell">
      <div class="stat-n">{stat(reportCount)}</div>
      <div class="stat-l">AICV Intelligence<br>Reports Published</div>
    </div>
    <div class="stat-cell">
      <div class="stat-n">{stat(businessesMapped)}</div>
      <div class="stat-l">Coachella Valley<br>Businesses Mapped</div>
    </div>
    <div class="stat-cell">
      <div class="stat-n">{stat(previewsLive)}</div>
      <div class="stat-l">Businesses with a<br>live Agent Preview</div>
    </div>
  </div>
</section>

<!-- ─── PATH CARDS: promoted primary door + two quiet secondary links ─── -->
<div class="path-cards-wrap">
  <div class="path-hierarchy">
    <div class="path-primary">
      <h2 class="path-primary-title">Make Your Business Visible to AI</h2>
      <p class="path-primary-desc">Get your Minimum Viable Agent — a structured, AI-readable profile so agents can find, read, and cite your business, without touching your website.</p>
      <a href="/get-agent-ready/#diagnostic" class="path-card-cta">Join the Network →</a>
    </div>
    <div class="path-secondary">
      <a href="/briefs/" class="path-secondary-link">Read the Briefs →</a>
      <a href="/nodes/" class="path-secondary-link">Explore the regional map →</a>
    </div>
  </div>
</div>

<!-- ─── WHAT IS AN MVA ─── -->
<div class="intel-what-wrap">
  <section class="intel-what-section">
    <div class="intel-what-inner">
      <h2 class="intel-what-header">What is an MVA?</h2>
      <p class="intel-what-body">A <strong>Minimum Viable Agent (MVA)</strong> is a structured, AI-readable profile that helps AI systems understand what a business, venue, institution, or regional asset is, where it fits, who it serves, and when it should be considered in AI-assisted search, planning, and decision-making.</p>
      <p class="intel-what-body">One MVA makes an entity more legible. The AICV Network makes the region more legible. <a href="/minimum-viable-agent/">Learn more →</a></p>
    </div>
  </section>
</div>

<!-- ─── AGENT INTENT ─── -->
<section class="agent-use-wrap" id="what-agents-use" aria-labelledby="agent-use-title">
  <div class="agent-use-section">
    <header class="agent-use-header">
      <div>
        <p class="agent-use-eyebrow">What Agents Use AICV For</p>
        <h2 id="agent-use-title">The search is agentic.<br> The decision is human.</h2>
      </div>
      <p class="agent-use-intro">A visitor planning a trip. A family considering a move. A founder looking for a place to build. AI agents and assistants can help them explore the valley. AICV helps those systems understand the people, places, and businesses here.</p>
    </header>

    <p class="agent-use-caption">For example, someone might ask their assistant…</p>
    <ul class="agent-use-scenarios">
      <li class="agent-use-scenario">
        <h3>Plan a visit or retreat</h3>
        <p class="agent-use-question">“We’re planning three days in the valley. Where should we stay, eat, and spend our time?”</p>
        <div class="agent-use-relevance">
          <p class="agent-use-label">Where local businesses fit</p>
          <p>Places to stay, eat, meet, and explore.</p>
        </div>
      </li>
      <li class="agent-use-scenario">
        <h3>Find a place to call home</h3>
        <p class="agent-use-question">“Where should we spend winters — privacy, wellness, golf, easy access to LA?”</p>
        <div class="agent-use-relevance">
          <p class="agent-use-label">Where local businesses fit</p>
          <p>Real estate, wellness, healthcare, and everyday services.</p>
        </div>
      </li>
      <li class="agent-use-scenario">
        <h3>Build a business here</h3>
        <p class="agent-use-question">“Is the Coachella Valley only seasonal, or is there a real business and investment ecosystem?”</p>
        <div class="agent-use-relevance">
          <p class="agent-use-label">Where local businesses fit</p>
          <p>Workspaces, professional services, and local partners.</p>
        </div>
      </li>
    </ul>

    <div class="agent-use-next">
      <div>
        <h3>Help them understand what your business offers.</h3>
        <p>Get Agent Ready gives your business a structured, AI-readable presence on the AICV network. See what’s included, start with the free check, and choose the level of help you need.</p>
      </div>
      <a class="path-card-cta" href="/get-agent-ready/">Explore Get Agent Ready <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- ─── LATEST BRIEFS ─── -->
<div class="briefs-strip-wrap">
  <section class="briefs-strip-section">
    <div class="briefs-strip-header-row">
      <div class="briefs-strip-label">Latest Briefs</div>
      <a href="/briefs/" class="briefs-strip-viewall">View all briefs →</a>
    </div>
    <div class="briefs-strip-grid">
      {latestBriefs.map((brief) => (
        <a href={`/briefs/${brief.slug}/`} class="briefs-strip-card">
          <div class="briefs-strip-date">{brief.date}</div>
          <div class="briefs-strip-title">{brief.title}</div>
          <p class="briefs-strip-desc">{brief.description}</p>
        </a>
      ))}
    </div>
  </section>
</div>

<!-- ─── LATEST FROM AICV NEWS — a subscriber band; canonical stays at aicv.news ─── -->
{aicvNews.length > 0 && (
<div class="news-band-wrap">
  <section class="news-band-section" aria-label="Latest from AICV News">
    <div class="briefs-strip-header-row">
      <div>
        <div class="briefs-strip-label">Latest from AICV News</div>
        <p class="news-band-sub">Reported and relayed at <a href={AICV_NEWS} rel="noopener">aicv.news</a>, the publication of AI Coachella Valley, the nonprofit. Read it there.</p>
      </div>
      <a href={AICV_NEWS} class="briefs-strip-viewall" rel="noopener">All of AICV News →</a>
    </div>
    <div class="briefs-strip-grid">
      {aicvNews.map((it) => (
        <a href={it.link} class="briefs-strip-card news-band-card" rel="noopener">
          <div class="briefs-strip-date">{it.type} · {fmtNews(it.date)}</div>
          <div class="briefs-strip-title">{it.title}</div>
          <p class="briefs-strip-desc">{it.description}</p>
          <span class="news-band-more">Read on AICV News →</span>
        </a>
      ))}
    </div>
  </section>
</div>
)}

<!-- ─── PARTNERS ─── -->
<div class="partners-wrap">
  <section class="partners-section">
    <div class="partners-label">Trusted Partners &amp; Collaborators</div>
    <p class="partners-sub">Working together to advance AI education and adoption in the Coachella Valley.</p>
    <div class="partners-list">
      <span class="partner-name">College of the Desert</span>
      <span class="partner-name">UC Riverside Extension</span>
      <span class="partner-name">CSUSB School of Entrepreneurship</span>
      <span class="partner-name">City of Palm Desert</span>
      <span class="partner-name">City of Palm Springs</span>
      <span class="partner-name">Riverside County Economic Development</span>
      <span class="partner-name">Entrepreneurship Resource Center</span>
    </div>
  </section>
</div>

<!-- ─── SUNSHINEFM HANDOFF (human editorial → the Guide; relocated above footer as the pre-close breath 2026-07-05) ─── -->
<div class="sunshine-handoff-wrap">
  <p class="sunshine-handoff">Want a human's take on the Coachella Valley — where to visit, where to put down roots, and how people with capital are reshaping what giving back looks like here? <a href="https://sunshine.fm/guide/" class="sunshine-handoff-link">Read the SunshineFM Guide&nbsp;→</a></p>
</div>

<!-- ─── FOOTER ─── -->

<Footer variant="full">
  <a slot="links" href="#" onclick="document.getElementById('tosModal').classList.add('on');return false;">Terms of Use</a>
</Footer>

<!-- ─── TERMS OF USE MODAL ─── -->
<div class="tos-overlay" id="tosModal" onclick="if(event.target===this)this.classList.remove('on')">
  <div class="tos-panel">
    <button class="tos-close" onclick="document.getElementById('tosModal').classList.remove('on')" aria-label="Close">✕</button>
    <div class="tos-header">
      <div class="tos-label">AI Coachella Valley</div>
      <h2 class="tos-title">AICV Terms of Use</h2>
      <div class="tos-date">Last updated: April 27, 2026</div>
    </div>
    <div class="tos-body">
      <p>The AICV Agent Preview is a free, experimental diagnostic provided by AI Coachella Valley, a product and service of SunshineFM LLC, operating in Riverside County, California.</p>

      <h3>No Account. No Cost. No Data Stored.</h3>
      <p>This tool requires no registration, login, or payment. URLs you submit are processed in real time and are not stored, logged, or retained by AICV. We do not collect personal information through this tool.</p>

      <h3>How It Works</h3>
      <p>Your submitted URL is passed to a third-party AI model (Anthropic Claude) via a Cloudflare Worker. Results are generated automatically and returned directly to your browser. AICV does not retain your query or output after your session ends.</p>

      <h3>For Informational, Experimental, and Entertainment Purposes Only</h3>
      <p>Results produced by this tool are AI-generated and provided strictly for informational, experimental, and entertainment purposes. They do not constitute professional SEO, legal, technical, marketing, or business advice of any kind. AICV makes no representations or warranties — express or implied — regarding the accuracy, completeness, reliability, or fitness of results for any particular purpose. Always verify findings independently and consult qualified professionals before making decisions based on tool output.</p>

      <h3>No Legal Recourse</h3>
