---
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import reportPreviewMap from '../../data/report-preview-map.json';
const previewManifests = import.meta.glob('../../data/previews/previews-index-*.json', { eager: true });

export async function getStaticPaths() {
  const entries = await getCollection('reports');
  return entries
    .filter((entry) => entry.data.status === 'published')
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.mdx$/, '') },
      props:  { entry },
    }));
}

const { entry } = Astro.props;

// ── Agent Preview tranche for this census (explicit map, derived counts) ──
// The map is deliberate; the numbers are not hardcoded — they come from the
// committed manifest the mva build emits, so a re-tranched category updates
// itself on the next sync.
const previewSegment = (reportPreviewMap.map as Record<string, string>)[entry.id.replace(/\.mdx$/, '')];
const previewManifest = previewSegment
  ? (Object.values(previewManifests).find((m: any) => m.default.segment === previewSegment) as any)?.default
  : null;
const { Content } = await render(entry);

const { title, description, date, period, report_type, tags, sections, canonical } = entry.data;

const formattedDate = new Date(date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

function periodToTemporalCoverage(p: string): string {
  const match = p.match(/^Q(\d)\s+(\d{4})$/);
  if (!match) return p;
  const q = parseInt(match[1]);
  const year = match[2];
  const startMonth = String((q - 1) * 3 + 1).padStart(2, '0');
  const endMonth   = String(q * 3).padStart(2, '0');
  return `${year}-${startMonth}/${year}-${endMonth}`;
}

function sectionLabel(s: string): string {
  return s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

const reportSchema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'Report'],
  'headline': title,
  'description': description,
  'datePublished': date,
  'dateModified': date,
  'author': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonical,
  },
  'temporalCoverage': periodToTemporalCoverage(period),
  'spatialCoverage': {
    '@type': 'Place',
    'name': 'Coachella Valley, California',
  },
  'keywords': tags.join(', '),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | AI Coachella Valley</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="article" />
  <meta property="article:published_time" content={date} />

  <script type="application/ld+json" set:html={JSON.stringify(reportSchema, null, 2)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <style>
  .report-previews { margin-top:3.5rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.12); }
  .report-previews-h { font-size:1.15rem; margin-bottom:.75rem; }
  .report-previews-p { font-size:.9rem; line-height:1.65; opacity:.85; max-width:60ch; }
  .report-previews-list { margin:1.25rem 0 0; padding:0; list-style:none; columns:2; column-gap:2rem; font-size:.85rem; line-height:1.9; }
  .report-previews-list li { break-inside:avoid; }
  .report-previews-city { opacity:.55; }
  @media (max-width:700px){ .report-previews-list { columns:1; } }

    :root {
      --volt:       #D8FF00;
      --pine:       #1B4332;
      --pine-light: #2D6A4F;
      --pine-dark:  #122B22;
      --gunmetal:   #1E1E1E;
      --snow:       #F5F5F5;
      --sand:       #FAFAF7;
      --sand-light: #FFFFFF;
      --sand-dark:  #E8E5DD;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; }
    body {
      background-color: var(--sand-light);
      color: var(--pine);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3 { font-family: 'Syne', sans-serif; }

    .site-header {
      background-color: var(--pine-dark);
      border-bottom: 2px solid var(--pine-light);
      padding: 40px 24px 32px;
    }
    .site-header .inner { max-width: 760px; margin: 0 auto; }

    .report-eyebrow {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .badge {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 2px;
    }
    .badge-type   { background: rgba(216,255,0,0.12); color: var(--volt); border: 1px solid rgba(216,255,0,0.25); }
    .badge-period { background: rgba(255,255,255,0.08); color: var(--sand-dark); }

    .report-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--sand-light);
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .report-date {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin-bottom: 16px;
    }

    .tag-row { display: flex; flex-wrap: wrap; gap: 6px; }
    .tag-chip {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 2px;
      background: rgba(216,255,0,0.1);
      color: var(--volt);
      border: 1px solid rgba(216,255,0,0.2);
    }

    .anchor-nav {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--sand);
      border-bottom: 1px solid var(--sand-dark);
      padding: 0 24px;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    .anchor-nav-inner {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
    }
    .anchor-nav a {
      display: inline-block;
      padding: 10px 14px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pine-light);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: color 0.15s, border-color 0.15s;
    }
    .anchor-nav a:hover {
      color: var(--pine-dark);
      border-bottom-color: var(--volt);
    }

    .page-wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    .report-body h1 { display: none; }
    .report-body h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--pine-light);
      margin: 40px 0 12px;
      padding-top: 4px;
      border-top: 1px solid var(--sand-dark);
      scroll-margin-top: 48px;
    }
    .report-body h3 {
      font-family: 'Syne', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--pine);
      margin: 24px 0 8px;
    }
    .report-body p {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.75;
      margin-bottom: 16px;
    }
    .report-body strong { font-weight: 600; color: var(--pine-dark); }
    .report-body em { font-style: italic; }
    .report-body ul, .report-body ol { margin: 0 0 16px 20px; }
    .report-body li {
      font-size: 1rem;
      color: var(--pine-dark);
      line-height: 1.7;
      margin-bottom: 6px;
    }
    .report-body a {
      color: var(--pine);
      text-decoration: underline;
      text-decoration-color: var(--pine-light);
    }
    .report-body a:hover { color: var(--pine-dark); }
    .report-body hr {
      border: none;
      border-top: 1px solid var(--sand-dark);
      margin: 32px 0;
    }
    .report-body blockquote {
      border-left: 3px solid var(--volt);
      padding: 8px 0 8px 18px;
      margin: 24px 0;
      background: var(--sand);
      border-radius: 0 4px 4px 0;
    }
    .report-body blockquote p { margin-bottom: 0; }

    @media (max-width: 640px) {
      .report-title { font-size: 1.4rem; }
      .site-header { padding: 28px 20px 24px; }
    }
  </style>
  {/* Favicon — same five tags as Base.astro. Repeated here because this route
      owns its own <head> and does not use the layout. See Base.astro. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>

<nav style="background:var(--color-gunmetal,#1a1a2e);padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;">
  <a href="/" style="color:var(--color-snow,#f5f5f5);font-weight:700;font-size:1rem;text-decoration:none;letter-spacing:0.02em;">AICV</a>
  <div style="display:flex;gap:1.5rem;align-items:center;">
    <a href="/nodes/" style="color:var(--color-snow,#f5f5f5);font-size:0.875rem;text-decoration:none;opacity:0.8;">Nodes</a>
    <a href="/briefs/" style="color:var(--color-snow,#f5f5f5);font-size:0.875rem;text-decoration:none;opacity:0.8;">Briefs</a>
    <a href="/get-agent-ready/#diagnostic" style="color:var(--color-volt,#d4ff00);font-size:0.875rem;text-decoration:none;font-weight:600;">Agent Preview</a>
  </div>
</nav>

<a href="/reports/" style="display:inline-block;margin:1.5rem 2rem 0;color:var(--color-volt,#d4ff00);font-size:0.875rem;text-decoration:none;opacity:0.8;">← All Reports</a>

<header class="site-header">
  <div class="inner">
    <div class="report-eyebrow">
      {report_type && <span class="badge badge-type">{report_type}</span>}
      {period && <span class="badge badge-period">{period}</span>}
    </div>
    <h1 class="report-title">{title}</h1>
    <p class="report-date">{formattedDate}</p>
    {tags && tags.length > 0 && (
      <div class="tag-row">
        {tags.map((tag: string) => (
          <span class="tag-chip">{tag}</span>
        ))}
      </div>
    )}
  </div>
</header>

{sections && sections.length > 0 && (
  <nav class="anchor-nav" aria-label="Report sections">
    <div class="anchor-nav-inner">
      {sections.map((s: string) => (
        <a href={`#${s}`}>{sectionLabel(s)}</a>
      ))}
    </div>
  </nav>
)}

<div class="page-wrap">
  <div class="report-body">
    <Content />
  </div>

  {previewManifest && (
    <section class="report-previews">
      <h2 class="report-previews-h">Agent Preview pages from this census</h2>
      <p class="report-previews-p">
        AICV publishes an Agent Preview page for each business in this category
        whose own website could be measured — <strong>{previewManifest.count} pages</strong> so far.
        That is deliberately fewer than the census counts: a census row exists for
        every entity found, while a preview page requires a reachable site of its
        own to read. Each page records what an AI agent can and cannot read there,
        on the date it was measured.
      </p>
      <ul class="report-previews-list">
        {previewManifest.entries.map((e: any) => (
          <li><a href={e.url}>{e.name}</a>{e.city ? <span class="report-previews-city"> · {e.city}</span> : null}</li>
        ))}
      </ul>
    </section>
  )}


<Footer variant="compact" />
</div>

<script define:vars={{ sections }}>
  // Assign ids to h2 elements by position — sections[i] maps to the i-th h2.
  // Position-based is reliable: MDX body order matches frontmatter sections order.
  //
  // Overrides MDX's auto-generated kebab-case IDs (2026-06-05 fix). Anchor nav
  // hrefs are built from the frontmatter `sections` array, so the rendered H2
  // IDs must match those strings exactly, not the auto-slugified versions.
  const h2s = document.querySelectorAll('.report-body h2');
  h2s.forEach((el, i) => {
    if (sections[i]) el.id = sections[i];
  });
</script>

</body>
</html>
