---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const canonical = 'https://aicoachellavalley.com/reports/';

const allReports = await getCollection('reports');
const reports = allReports
  .filter((r) => r.data.status === 'published')
  .sort((a, b) => (a.data.date > b.data.date ? -1 : 1));

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': 'Reports | AI Coachella Valley',
  'description': 'Research reports and economic intelligence on the AI economy in Coachella Valley.',
  'url': canonical,
  'publisher': {
    '@type': 'Organization',
    'name': 'AI Coachella Valley',
    'url': 'https://aicoachellavalley.com',
  },
};
---

<Base
  title="Reports | AI Coachella Valley"
  description="Research reports and economic intelligence on the AI economy in Coachella Valley."
  canonicalUrl={canonical}
  schema={pageSchema}
>

<!-- ─── NAV ─── -->
<nav>
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">AICV</div>
    <div class="nav-logo-words">
      <span class="nav-logo-aicv">AI Coachella Valley</span>
      <span class="nav-logo-sub">Intelligence Layer · Coachella Valley</span>
    </div>
  </a>
  <div class="nav-right">
    <a href="/briefs/" class="nav-link">Briefs</a>
    <a href="/nodes/node-zero" class="nav-docs-btn">Node Zero →</a>
  </div>
</nav>

<!-- ─── HEADER ─── -->
<header class="page-header">
  <div class="page-header-inner">
    <div class="page-eyebrow">AI Coachella Valley · Research &amp; Intelligence Reports</div>
    <h1 class="page-title">Reports</h1>
    <p class="page-desc">Long-form reports on the AI economy, infrastructure, workforce trends, civic readiness, and business intelligence across the Coachella Valley.</p>
  </div>
</header>

<!-- ─── REPORTS LIST ─── -->
<main class="reports-main">
  {reports.length === 0 ? (
    <p class="empty-state">No reports published yet.</p>
  ) : (
    <ul class="report-list">
      {reports.map((entry) => {
        const slug = entry.id.replace(/\.mdx$/, '');
        const { title, description, date, period, report_type } = entry.data;
        return (
          <li class="report-item">
            <div class="report-meta">
              {report_type && <span class="badge badge-type">{report_type}</span>}
              {period      && <span class="badge badge-period">{period}</span>}
              <span class="report-date">{date}</span>
            </div>
            <a href={`/reports/${slug}/`} class="report-title">{title}</a>
            {description && <p class="report-desc">{description}</p>}
          </li>
        );
      })}
    </ul>
  )}
</main>

<!-- ─── FOOTER ─── -->
<footer>
  <div class="foot-inner">
    <div class="foot-copy">
      © 2026 AI Coachella Valley · <a href="mailto:sat@aicv.co">sat@aicv.co</a>
    </div>
    <div class="foot-links">
      <a href="/">Home</a>
      <a href="/nodes/">Nodes</a>
      <a href="/briefs/">Briefs</a>
      <a href="https://x.com/CoachellaAI">@CoachellaAI</a>
    </div>
  </div>
</footer>

<style is:global>
  /* ─── NAV ─── */
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 3rem;
    background: var(--gunmetal);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
  .nav-logo-mark {
    width: 36px; height: 36px;
    background: var(--volt);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif; font-weight: 800; font-size: 11px;
    color: var(--pine); flex-shrink: 0;
  }
  .nav-logo-words { display: flex; flex-direction: column; line-height: 1; gap: 2px; }
  .nav-logo-aicv { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 0.9rem; color: var(--sand); letter-spacing: 0.04em; }
  .nav-logo-sub  { font-size: 0.6rem; font-weight: 300; color: rgba(232,226,208,0.4); letter-spacing: 0.08em; text-transform: uppercase; }
  .nav-right { display: flex; align-items: center; gap: 1.5rem; }
  .nav-link  { font-size: 0.78rem; color: var(--sand); text-decoration: none; letter-spacing: 0.03em; transition: color 0.2s; }
  .nav-link:hover { color: var(--volt); }
  .nav-docs-btn {
    background: var(--volt); color: var(--pine);
    padding: 0.45rem 1.1rem;
    font-family: 'Syne', sans-serif; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.08em; text-decoration: none; transition: background 0.2s;
  }
  .nav-docs-btn:hover { background: #e8ff33; }

  /* ─── PAGE HEADER ─── */
  .page-header { background: var(--pine-dark); padding: 4rem 3rem 3.5rem; border-bottom: 2px solid var(--pine-light); }
  .page-header-inner { max-width: 1060px; margin: 0 auto; }
  .page-eyebrow { font-size: 0.67rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--pine-light); font-weight: 500; margin-bottom: 1rem; }
  .page-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: clamp(2rem, 4vw, 3.25rem); color: var(--sand-light); letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 1rem; }
  .page-desc { font-size: 0.95rem; color: rgba(232,226,208,0.65); font-weight: 300; max-width: 64ch; line-height: 1.7; }

  /* ─── REPORTS MAIN ─── */
  .reports-main { max-width: 1060px; margin: 0 auto; padding: 3rem 3rem 5rem; }
  .empty-state { font-size: 0.9rem; color: var(--pine-light); }
  .report-list { list-style: none; display: flex; flex-direction: column; }
  .report-item { padding: 1.25rem 0; border-bottom: 1px solid rgba(212,204,186,0.4); }
  .report-item:last-child { border-bottom: none; }

  .report-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  .badge { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 8px; border-radius: 2px; }
  .badge-type   { background: rgba(216,255,0,0.12); color: var(--volt); border: 1px solid rgba(216,255,0,0.25); }
  .badge-period { background: rgba(255,255,255,0.06); color: rgba(232,226,208,0.6); border: 1px solid rgba(255,255,255,0.1); }
  .report-date  { font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(27,67,50,0.4); }

  .report-title {
    font-family: 'Syne', sans-serif; font-size: 1.05rem; font-weight: 600;
    color: var(--pine); text-decoration: none; letter-spacing: -0.01em;
    transition: color 0.15s; line-height: 1.35; display: block; margin-bottom: 0.25rem;
  }
  .report-title:hover { color: var(--pine-light); }
  .report-desc { font-size: 0.83rem; color: var(--pine-light); font-weight: 300; line-height: 1.6; max-width: 80ch; }

  /* ─── FOOTER ─── */
  footer { background: var(--pine-dark); padding: 2rem 3rem; border-top: 1px solid rgba(232,226,208,0.06); }
  .foot-inner { max-width: 1060px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .foot-copy  { font-size: 0.72rem; color: rgba(232,226,208,0.5); font-weight: 300; }
  .foot-copy a { color: rgba(232,226,208,0.5); text-decoration: none; }
  .foot-links { display: flex; gap: 1.5rem; }
  .foot-links a { font-size: 0.72rem; color: rgba(232,226,208,0.5); text-decoration: none; transition: color 0.2s; }
  .foot-links a:hover { color: var(--volt); }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 860px) {
    nav { padding: 1rem 1.5rem; }
    .page-header { padding: 3rem 1.5rem 2.5rem; }
    .reports-main { padding: 2.5rem 1.5rem 4rem; }
    footer { padding: 1.75rem 1.5rem; }
    .foot-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>

</Base>
