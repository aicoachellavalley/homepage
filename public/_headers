# Agent discovery — Link response headers on homepage
# Advertises llms.txt, MCP endpoint, API catalog, sitemap
# per RFC 8288. Registered relations where available; llms-txt and
# llms-full-txt are emerging conventions pending IANA registration.
/
  Link: </llms.txt>; rel="llms-txt", </llms-full.txt>; rel="llms-full-txt"
  Link: </.well-known/mcp/server-card.json>; rel="describedby"; type="application/json"
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"

# Content-Type fix for extension-less API Catalog file
# RFC 9727 specifies application/linkset+json
/.well-known/api-catalog
  Content-Type: application/linkset+json

# Advertise API catalog and MCP server card on all pages (RFC 8288)
/*
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </.well-known/mcp/server-card.json>; rel="mcp-server"; type="application/json"
